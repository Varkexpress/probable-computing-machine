remotes.OpenPanel.OnClientEvent:Connect(function(which, arg)
	if which == "shop" then
		refreshShop()
		shop.Visible = true
	elseif which == "pantry" then
		refreshPantry()
		pantryPanel.Visible = true
	elseif which == "cook" then
		openCook(arg)
	elseif which == "ferry" then
		openFerry()
	elseif which == "note" then
		openNote(arg)
	end
end)

