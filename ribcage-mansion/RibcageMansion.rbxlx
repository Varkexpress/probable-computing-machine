  <Item class="ServerScriptService" referent="RBX00000005">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000006">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source"><![CDATA[-- The Ribcage: entry point. Builds the mansion and starts the game systems.

local Players = game:GetService("Players")

-- Hold characters back until the world exists, so nobody falls into the void.
Players.CharacterAutoLoads = false

local Modules = script.Parent:WaitForChild("Modules")
local Builder = require(Modules:WaitForChild("Builder"))
local Gameplay = require(Modules:WaitForChild("Gameplay"))

local started = os.clock()
local refs = Builder.build()
print(string.format("[Ribcage] Mansion built in %.1fs", os.clock() - started))

Gameplay.start(refs)

Players.CharacterAutoLoads = true
for _, player in Players:GetPlayers() do
	if not player.Character then
		task.spawn(function()
			player:LoadCharacter()
		end)
	end
end
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX00000007">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">Boats</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- A small concrete-grey launch at every dock. Sit in the seat: W/S (or the
-- thumbstick) for throttle, A/D to steer. Physics: the hull floats in the
-- terrain water; a LinearVelocity pushes it across the surface and an
-- AlignOrientation keeps it level and pointing where you steer.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Build = require(script.Parent.Build)
local Registry = require(script.Parent.Registry)

local Boats = {}

local MAX_SPEED = 36
local REVERSE = 0.4
local TURN_RATE = 1.3 -- radians per second at full steer
local RETURN_AFTER = 75 -- seconds unattended before a far-away boat goes home

type Boat = {
	model: Model,
	hull: BasePart,
	seat: VehicleSeat,
	lv: LinearVelocity,
	align: AlignOrientation,
	spawn: CFrame,
	heading: number,
	idleSince: number,
	warned: boolean,
}

local boats: { Boat } = {}
local hooks

local function yawOf(cf: CFrame): number
	local _, y = cf:ToEulerAnglesYXZ()
	return y
end

local function attachPart(model: Model, hull: BasePart, cf: CFrame, props): BasePart
	local p = Build.part(model, props)
	p.Anchored = false
	p.Massless = true
	p.CFrame = cf
	p.CollisionGroup = "Boats"
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hull
	weld.Part1 = p
	weld.Parent = p
	return p
end

local function buildBoat(spawn: CFrame): Boat
	local model = Instance.new("Model")
	model.Name = "Boat"
	local hull = Build.part(model, {
		Name = "Hull",
		Size = Vector3.new(6, 1.6, 14),
		CFrame = spawn,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(64, 68, 72),
	})
	hull.Anchored = false
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.3, 0.5)
	hull.CollisionGroup = "Boats"

	local grey = Color3.fromRGB(150, 150, 146)
	for _, x in { -2.75, 2.75 } do
		attachPart(model, hull, spawn * CFrame.new(x, 1.3, 0), { Name = "Gunwale", Size = Vector3.new(0.5, 1, 14), Material = Enum.Material.Concrete, Color = grey })
	end
	attachPart(model, hull, spawn * CFrame.new(0, 0.2, -7.6), { Name = "Bow", Size = Vector3.new(4, 1.2, 1.4), Material = Enum.Material.Metal, Color = Color3.fromRGB(64, 68, 72) })
	attachPart(model, hull, spawn * CFrame.new(0, 1.3, 6.6), { Name = "Transom", Size = Vector3.new(6, 1, 0.6), Material = Enum.Material.Concrete, Color = grey })
	attachPart(model, hull, spawn * CFrame.new(0, 1.2, -3), { Name = "Bench", Size = Vector3.new(5, 0.6, 1.6), Material = Enum.Material.Wood, Color = Build.Color.Wood })
	local lantern = attachPart(model, hull, spawn * CFrame.new(0, 2.6, -6.4), { Name = "Lantern", Size = Vector3.new(0.6, 0.8, 0.6), Material = Enum.Material.Neon, Color = Build.Color.Warm })
	Build.pointLight(lantern, Build.Color.Warm, 18, 1.2)

	local seat = Instance.new("VehicleSeat")
	seat.Name = "Helm"
	seat.Size = Vector3.new(2, 0.8, 2)
	seat.CFrame = spawn * CFrame.new(0, 1.2, 3.5)
	seat.Material = Enum.Material.Fabric
	seat.Color = Build.Color.Fabric
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Massless = true
	seat.CollisionGroup = "Boats"
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hull
	weld.Part1 = seat
	weld.Parent = seat

	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = hull
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.xAxis
	lv.SecondaryTangentAxis = Vector3.zAxis
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 8000
	lv.PlaneVelocity = Vector2.zero
	lv.Parent = hull
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxTorque = 60000
	align.Responsiveness = 12
	align.CFrame = CFrame.Angles(0, yawOf(spawn), 0)
	align.Parent = hull

	model.PrimaryPart = hull
	model.Parent = Build.folder(Workspace:FindFirstChild("RibcageWorld") or Workspace, "Boats")
	return {
		model = model,
		hull = hull,
		seat = seat,
		lv = lv,
		align = align,
		spawn = spawn,
		heading = yawOf(spawn),
		idleSince = os.clock(),
		warned = false,
	}
end

function Boats.reset(boat: Boat)
	if boat.seat.Occupant then
		return
	end
	boat.hull.AssemblyLinearVelocity = Vector3.zero
	boat.hull.AssemblyAngularVelocity = Vector3.zero
	boat.model:PivotTo(boat.spawn)
	boat.heading = yawOf(boat.spawn)
	boat.align.CFrame = CFrame.Angles(0, boat.heading, 0)
end

local function occupantPlayer(boat: Boat): Player?
	local humanoid = boat.seat.Occupant
	return humanoid and Players:GetPlayerFromCharacter(humanoid.Parent)
end

local function step(dt: number)
	local frozen = Workspace:GetAttribute("Frozen") == true
	local now = os.clock()
	for _, b in boats do
		local player = occupantPlayer(b)
		local throttle, steer = 0, 0
		if player then
			b.idleSince = now
			throttle = b.seat.ThrottleFloat
			steer = b.seat.SteerFloat
			if frozen then
				if (throttle ~= 0 or steer ~= 0) and not b.warned then
					b.warned = true
					hooks.notify(player, "The boat is locked in the ice until dawn. Walk instead.", "warn")
				end
				throttle, steer = 0, 0
			else
				b.warned = false
			end
		elseif now - b.idleSince > RETURN_AFTER and (b.hull.Position - b.spawn.Position).Magnitude > 30 then
			Boats.reset(b)
			b.idleSince = now
		end
		if b.hull.Position.Y < -40 then
			Boats.reset(b)
		end
		local turn = steer * TURN_RATE * dt
		if throttle < -0.05 then
			turn = -turn -- steer like a car in reverse
		end
		b.heading -= turn
		local facing = CFrame.Angles(0, b.heading, 0)
		b.align.CFrame = facing
		local look = facing.LookVector
		local speed = throttle >= 0 and throttle * MAX_SPEED or throttle * MAX_SPEED * REVERSE
		b.lv.PlaneVelocity = Vector2.new(look.X * speed, look.Z * speed)
	end
end

function Boats.start(builtHooks)
	hooks = builtHooks
	for _, dock in Registry.docks do
		local boat = buildBoat(dock.boatSpawn)
		table.insert(boats, boat)
		dock.boat = boat
		boat.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local player = occupantPlayer(boat)
			pcall(function()
				if player then
					boat.hull:SetNetworkOwner(player)
					hooks.notify(player, "W / S: throttle   ·   A / D: steer   ·   Space: hop out", "info")
				else
					boat.hull:SetNetworkOwnershipAuto()
				end
			end)
		end)
		local call = Build.prompt(dock.bell, "Bring the boat back", "Dock", 0.5, 10)
		call.UIOffset = Vector2.new(0, 70)
		call.KeyboardKeyCode = Enum.KeyCode.F
		call.Triggered:Connect(function(player)
			if boat.seat.Occupant then
				hooks.notify(player, "Someone is out in it right now.", "warn")
				return
			end
			Boats.reset(boat)
		end)
	end
	RunService.Heartbeat:Connect(step)
end

return Boats
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">Build</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Small helpers for making anchored parts, lights and prompts in code.

local ServerStorage = game:GetService("ServerStorage")

local Build = {}

Build.Color = {
	ConcreteOut = Color3.fromRGB(168, 168, 164),
	ConcreteDark = Color3.fromRGB(70, 72, 74),
	ConcreteIn = Color3.fromRGB(132, 122, 110),
	Floor = Color3.fromRGB(78, 70, 62),
	Glass = Color3.fromRGB(160, 190, 210),
	Fabric = Color3.fromRGB(46, 42, 40),
	Marble = Color3.fromRGB(28, 26, 26),
	Wood = Color3.fromRGB(70, 48, 34),
	Warm = Color3.fromRGB(255, 196, 130),
	Metal = Color3.fromRGB(24, 24, 26),
	Snow = Color3.fromRGB(236, 241, 246),
	Ice = Color3.fromRGB(214, 228, 240),
}

function Build.folder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = name
	nf.Parent = parent
	return nf
end

-- Build.part(parent, { Size = ..., CFrame = ..., ... }) -> Part
-- Pass ClassName = "WedgePart" etc. for other part types.
function Build.part(parent: Instance, props: { [string]: any }): BasePart
	local p: any = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape and p:IsA("Part") then
		p.Shape = props.Shape
	end
	if props.Size then
		p.Size = props.Size
	end
	for k, v in props do
		if k ~= "ClassName" and k ~= "Shape" and k ~= "Size" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- A block spanning two corner points (axis aligned).
function Build.box(parent: Instance, a: Vector3, b: Vector3, props: { [string]: any }?): BasePart
	local minV = a:Min(b)
	local maxV = a:Max(b)
	local p = table.clone(props or {})
	p.Size = maxV - minV
	p.CFrame = CFrame.new((minV + maxV) / 2)
	return Build.part(parent, p)
end

-- A stretched sphere (uses a SpecialMesh so it can be non-uniform).
function Build.ellipsoid(parent: Instance, cf: CFrame, size: Vector3, props: { [string]: any }?): BasePart
	local p = table.clone(props or {})
	p.Size = size
	p.CFrame = cf
	local part = Build.part(parent, p)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- A cylinder whose axis runs along world Y.
function Build.cylinderY(parent: Instance, center: Vector3, height: number, diameter: number, props: { [string]: any }?): BasePart
	local p = table.clone(props or {})
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2)
	return Build.part(parent, p)
end

-- A part stretched between two points with a given cross-section.
function Build.beam(parent: Instance, p1: Vector3, p2: Vector3, width: number, depth: number, props: { [string]: any }?, up: Vector3?): BasePart
	local p = table.clone(props or {})
	local len = (p2 - p1).Magnitude
	p.Size = Vector3.new(width, depth, len)
	p.CFrame = CFrame.lookAt((p1 + p2) / 2, p2, up or Vector3.yAxis)
	return Build.part(parent, p)
end

function Build.pointLight(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = true
	l.Parent = parent
	return l
end

function Build.surfaceLight(parent: Instance, face: Enum.NormalId, color: Color3, range: number, brightness: number, angle: number?): SurfaceLight
	local l = Instance.new("SurfaceLight")
	l.Face = face
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Angle = angle or 90
	l.Parent = parent
	return l
end

function Build.prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = distance or 10
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

-- Finds an optional Blender-made asset in ServerStorage.BlenderAssets.
function Build.asset(name: string): Instance?
	local folder = ServerStorage:FindFirstChild("BlenderAssets")
	if not folder then
		return nil
	end
	local found = folder:FindFirstChild(name)
	return found
end

-- Places a copy of an imported asset so its bounding box fills `size`
-- centred on `cf`. Works for a MeshPart or a Model of MeshParts.
function Build.placeAsset(template: Instance, parent: Instance, cf: CFrame, size: Vector3, props: { [string]: any }?): Instance
	-- The 3D importer often wraps a single mesh in a Model; use the mesh itself
	-- so it can be stretched non-uniformly.
	if template:IsA("Model") then
		local parts = {}
		for _, d in template:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
		if #parts == 1 then
			template = parts[1]
		end
	end
	local clone = template:Clone()
	local function style(part: BasePart)
		part.Anchored = true
		for k, v in (props or {}) :: { [string]: any } do
			pcall(function()
				(part :: any)[k] = v
			end)
		end
	end
	if clone:IsA("BasePart") then
		clone.Size = size
		clone.CFrame = cf
		style(clone)
	elseif clone:IsA("Model") then
		for _, d in clone:GetDescendants() do
			if d:IsA("BasePart") then
				style(d)
			end
		end
		local _, bbSize = clone:GetBoundingBox()
		local scale = math.max(size.X, size.Y, size.Z) / math.max(bbSize.X, bbSize.Y, bbSize.Z)
		clone:ScaleTo(clone:GetScale() * scale)
		local bbCf = clone:GetBoundingBox()
		local offset = bbCf:ToObjectSpace(clone:GetPivot())
		clone:PivotTo(cf * offset)
	end
	clone.Parent = parent
	return clone
end

return Build
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000A">
        <Properties>
          <string name="Name">Builder</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the whole map. Called by Main when the game starts.
--
-- To look at the homes in Studio without pressing Play, paste this into the
-- Command Bar (View > Command Bar) and press Enter:
--   require(game.ServerScriptService.Modules.Builder).build()

local Workspace = game:GetService("Workspace")

local Registry = require(script.Parent.Registry)
local World = require(script.Parent.World)
local Mansion = require(script.Parent.Mansion)
local Lore = require(script.Parent.Lore)
local Homes = script.Parent:WaitForChild("Homes")
local Monolith = require(Homes:WaitForChild("Monolith"))
local Vertebrae = require(Homes:WaitForChild("Vertebrae"))
local Well = require(Homes:WaitForChild("Well"))

local Builder = {}

function Builder.build()
	Registry.reset()
	local old = Workspace:FindFirstChild("RibcageWorld")
	if old then
		old:Destroy()
	end
	-- Remove Studio's default baseplate and spawn if they are there.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	for _, child in Workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	local root = Instance.new("Folder")
	root.Name = "RibcageWorld"
	root.Parent = Workspace

	local refs = World.build(root)
	local mansionRefs = Mansion.build(root)
	for k, v in mansionRefs do
		refs[k] = v
	end
	Monolith.build(root)
	Vertebrae.build(root)
	Well.build(root)
	Lore.build(root)
	refs.root = root
	return refs
end

return Builder
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000B">
        <Properties>
          <string name="Name">Data</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Saves credits, discoveries and upgrades between visits.
-- DataStores only work in a published place with "Enable Studio Access to API
-- Services" turned on; otherwise the game still runs and simply doesn't save.

local DataStoreService = game:GetService("DataStoreService")

local Data = {}

local store = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore("RibcageMansion_v1")
end)
if not ok then
	store = nil
end

export type Profile = {
	credits: number,
	discoveries: { [string]: boolean },
	upgrades: { [string]: boolean },
	fishCaught: number,
	pets: { [string]: boolean },
	activePet: string,
	treats: number,
	home: string,
	notes: { [string]: boolean },
	flags: { [string]: boolean },
	title: string,
}

function Data.default(): Profile
	return { credits = 50, discoveries = {}, upgrades = {}, fishCaught = 0, pets = {}, activePet = "", treats = 2, home = "", notes = {}, flags = {}, title = "" }
end

function Data.load(userId: number): Profile
	local profile = Data.default()
	if not store then
		return profile
	end
	local success, saved = pcall(function()
		return store:GetAsync("u" .. userId)
	end)
	if success and type(saved) == "table" then
		profile.credits = tonumber(saved.credits) or profile.credits
		profile.fishCaught = tonumber(saved.fishCaught) or 0
		for _, id in saved.discoveries or {} do
			profile.discoveries[id] = true
		end
		for _, id in saved.upgrades or {} do
			profile.upgrades[id] = true
		end
		for _, id in saved.pets or {} do
			profile.pets[id] = true
		end
		profile.activePet = type(saved.activePet) == "string" and saved.activePet or ""
		profile.treats = tonumber(saved.treats) or profile.treats
		profile.home = type(saved.home) == "string" and saved.home or ""
		profile.title = type(saved.title) == "string" and saved.title or ""
		for _, id in saved.notes or {} do
			profile.notes[id] = true
		end
		for _, id in saved.flags or {} do
			profile.flags[id] = true
		end
	end
	return profile
end

function Data.save(userId: number, profile: Profile)
	if not store then
		return
	end
	local discoveries, upgrades, pets, notes, flags = {}, {}, {}, {}, {}
	for id in profile.notes do
		table.insert(notes, id)
	end
	for id in profile.flags do
		table.insert(flags, id)
	end
	for id in profile.pets do
		table.insert(pets, id)
	end
	for id in profile.discoveries do
		table.insert(discoveries, id)
	end
	for id in profile.upgrades do
		table.insert(upgrades, id)
	end
	pcall(function()
		store:SetAsync("u" .. userId, {
			credits = profile.credits,
			fishCaught = profile.fishCaught,
			discoveries = discoveries,
			upgrades = upgrades,
			pets = pets,
			activePet = profile.activePet,
			treats = profile.treats,
			home = profile.home,
			title = profile.title,
			notes = notes,
			flags = flags,
		})
	end)
end

return Data
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000C">
        <Properties>
          <string name="Name">Food</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Food you can hold and eat. Every meal is a Tool whose Handle is the plate,
-- bowl, mug or board, with the food modelled on top in parts. The Handle's
-- local Y axis points up while held, so plates are carried flat.

local Food = {}

local CERAMIC = Color3.fromRGB(226, 222, 214)
local STONEWARE = Color3.fromRGB(58, 54, 50)

-- shape: "sphere" (stretched ellipsoid) or "block". Offsets are from the
-- centre of the handle.
type Bit = { shape: string, at: Vector3, size: Vector3, color: Color3, material: Enum.Material?, rot: Vector3? }
type Design = { handle: string, bites: number, bits: { Bit } }

local function plate(): string
	return "plate"
end

local DESIGNS: { [string]: Design } = {
	coffee = {
		handle = "mug",
		bites = 2,
		bits = {
			{ shape = "block", at = Vector3.new(0, 0.36, 0), size = Vector3.new(0.56, 0.05, 0.56), color = Color3.fromRGB(58, 38, 26) },
			{ shape = "sphere", at = Vector3.new(0, 0.39, 0), size = Vector3.new(0.3, 0.02, 0.3), color = Color3.fromRGB(196, 160, 120) },
		},
	},
	tea = {
		handle = "mug",
		bites = 2,
		bits = {
			{ shape = "block", at = Vector3.new(0, 0.36, 0), size = Vector3.new(0.56, 0.05, 0.56), color = Color3.fromRGB(150, 92, 40) },
		},
	},
	cocoa = {
		handle = "darkmug",
		bites = 2,
		bits = {
			{ shape = "block", at = Vector3.new(0, 0.36, 0), size = Vector3.new(0.56, 0.05, 0.56), color = Color3.fromRGB(92, 58, 38) },
			{ shape = "block", at = Vector3.new(-0.1, 0.43, 0.08), size = Vector3.new(0.16, 0.14, 0.16), color = Color3.fromRGB(246, 242, 236), rot = Vector3.new(0, 0.4, 0.2) },
			{ shape = "block", at = Vector3.new(0.12, 0.42, -0.06), size = Vector3.new(0.16, 0.14, 0.16), color = Color3.fromRGB(246, 242, 236), rot = Vector3.new(0.3, 0.9, 0) },
			{ shape = "block", at = Vector3.new(0.02, 0.44, -0.16), size = Vector3.new(0.15, 0.13, 0.15), color = Color3.fromRGB(240, 226, 230), rot = Vector3.new(0, 0.2, 0.3) },
		},
	},
	pancakes = {
		handle = plate(),
		bites = 3,
		bits = {
			{ shape = "sphere", at = Vector3.new(0, 0.16, 0), size = Vector3.new(1.25, 0.18, 1.25), color = Color3.fromRGB(206, 150, 76) },
			{ shape = "sphere", at = Vector3.new(0.03, 0.32, 0.02), size = Vector3.new(1.2, 0.18, 1.2), color = Color3.fromRGB(214, 160, 84) },
			{ shape = "sphere", at = Vector3.new(-0.02, 0.48, -0.02), size = Vector3.new(1.15, 0.18, 1.15), color = Color3.fromRGB(220, 168, 90) },
			{ shape = "sphere", at = Vector3.new(0.05, 0.57, 0.05), size = Vector3.new(0.9, 0.04, 0.8), color = Color3.fromRGB(150, 72, 20), material = Enum.Material.Glass },
			{ shape = "block", at = Vector3.new(0, 0.66, 0), size = Vector3.new(0.3, 0.16, 0.3), color = Color3.fromRGB(250, 226, 130) },
			{ shape = "sphere", at = Vector3.new(0.6, 0.12, 0.45), size = Vector3.new(0.18, 0.18, 0.18), color = Color3.fromRGB(150, 20, 40) },
			{ shape = "sphere", at = Vector3.new(0.7, 0.12, 0.2), size = Vector3.new(0.17, 0.17, 0.17), color = Color3.fromRGB(50, 60, 140) },
			{ shape = "sphere", at = Vector3.new(0.48, 0.12, 0.62), size = Vector3.new(0.17, 0.17, 0.17), color = Color3.fromRGB(50, 60, 140) },
		},
	},
	miso = {
		handle = "bowl",
		bites = 3,
		bits = {
			{ shape = "sphere", at = Vector3.new(0, 0.26, 0), size = Vector3.new(1.32, 0.06, 1.32), color = Color3.fromRGB(196, 160, 104) },
			{ shape = "block", at = Vector3.new(-0.2, 0.3, 0.15), size = Vector3.new(0.22, 0.18, 0.22), color = Color3.fromRGB(244, 238, 222) },
			{ shape = "block", at = Vector3.new(0.25, 0.3, -0.1), size = Vector3.new(0.22, 0.18, 0.22), color = Color3.fromRGB(244, 238, 222) },
			{ shape = "block", at = Vector3.new(0.05, 0.3, 0.32), size = Vector3.new(0.2, 0.16, 0.2), color = Color3.fromRGB(244, 238, 222) },
			{ shape = "sphere", at = Vector3.new(0.1, 0.31, -0.3), size = Vector3.new(0.5, 0.04, 0.12), color = Color3.fromRGB(70, 120, 50) },
			{ shape = "sphere", at = Vector3.new(-0.32, 0.31, -0.12), size = Vector3.new(0.12, 0.04, 0.4), color = Color3.fromRGB(80, 140, 60) },
		},
	},
	searedfish = {
		handle = plate(),
		bites = 3,
		bits = {
			{ shape = "sphere", at = Vector3.new(-0.2, 0.18, 0.05), size = Vector3.new(1.0, 0.24, 0.48), color = Color3.fromRGB(236, 150, 116) },
			{ shape = "sphere", at = Vector3.new(-0.2, 0.28, 0.05), size = Vector3.new(0.86, 0.06, 0.36), color = Color3.fromRGB(160, 96, 52) },
			{ shape = "sphere", at = Vector3.new(0.45, 0.22, -0.3), size = Vector3.new(0.7, 0.38, 0.7), color = Color3.fromRGB(246, 244, 236) },
			{ shape = "sphere", at = Vector3.new(0.5, 0.14, 0.45), size = Vector3.new(0.3, 0.16, 0.18), color = Color3.fromRGB(246, 220, 80) },
			{ shape = "sphere", at = Vector3.new(-0.55, 0.12, -0.45), size = Vector3.new(0.18, 0.05, 0.4), color = Color3.fromRGB(70, 120, 50) },
		},
	},
	stew = {
		handle = "bowl",
		bites = 3,
		bits = {
			{ shape = "sphere", at = Vector3.new(0, 0.26, 0), size = Vector3.new(1.32, 0.07, 1.32), color = Color3.fromRGB(122, 70, 38) },
			{ shape = "block", at = Vector3.new(-0.25, 0.31, 0.1), size = Vector3.new(0.2, 0.16, 0.2), color = Color3.fromRGB(226, 120, 40), rot = Vector3.new(0.3, 0.5, 0) },
			{ shape = "block", at = Vector3.new(0.2, 0.31, 0.25), size = Vector3.new(0.24, 0.18, 0.22), color = Color3.fromRGB(232, 214, 170), rot = Vector3.new(0, 0.9, 0.2) },
			{ shape = "block", at = Vector3.new(0.1, 0.31, -0.28), size = Vector3.new(0.3, 0.16, 0.22), color = Color3.fromRGB(244, 236, 226), rot = Vector3.new(0.2, 0.2, 0) },
			{ shape = "block", at = Vector3.new(-0.3, 0.31, -0.2), size = Vector3.new(0.18, 0.15, 0.18), color = Color3.fromRGB(226, 120, 40), rot = Vector3.new(0, 1.2, 0.3) },
		},
	},
	bread = {
		handle = "board",
		bites = 3,
		bits = {
			{ shape = "sphere", at = Vector3.new(0, 0.38, 0), size = Vector3.new(1.4, 0.7, 0.85), color = Color3.fromRGB(176, 112, 54) },
			{ shape = "block", at = Vector3.new(-0.3, 0.66, 0), size = Vector3.new(0.06, 0.06, 0.6), color = Color3.fromRGB(226, 186, 120), rot = Vector3.new(0, 0.5, 0) },
			{ shape = "block", at = Vector3.new(0.1, 0.7, 0), size = Vector3.new(0.06, 0.06, 0.6), color = Color3.fromRGB(226, 186, 120), rot = Vector3.new(0, 0.5, 0) },
			{ shape = "block", at = Vector3.new(0.45, 0.62, 0), size = Vector3.new(0.06, 0.06, 0.5), color = Color3.fromRGB(226, 186, 120), rot = Vector3.new(0, 0.5, 0) },
		},
	},
	snack = {
		handle = plate(),
		bites = 2,
		bits = {
			{ shape = "block", at = Vector3.new(-0.3, 0.1, 0.1), size = Vector3.new(0.5, 0.06, 0.5), color = Color3.fromRGB(222, 184, 120), rot = Vector3.new(0, 0.3, 0) },
			{ shape = "block", at = Vector3.new(-0.25, 0.16, -0.25), size = Vector3.new(0.5, 0.06, 0.5), color = Color3.fromRGB(222, 184, 120), rot = Vector3.new(0, 0.8, 0) },
			{ shape = "block", at = Vector3.new(0.35, 0.18, 0), size = Vector3.new(0.5, 0.3, 0.4), color = Color3.fromRGB(248, 210, 100) },
			{ shape = "block", at = Vector3.new(0.3, 0.17, 0.42), size = Vector3.new(0.3, 0.24, 0.3), color = Color3.fromRGB(250, 236, 200) },
		},
	},
}

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material?, sphere: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	if sphere then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	return p
end

local function makeHandle(kind: string): (BasePart, { BasePart })
	local extras = {}
	local handle: BasePart
	if kind == "plate" then
		handle = newPart("Handle", Vector3.new(1.9, 0.12, 1.9), CERAMIC, Enum.Material.SmoothPlastic, true)
	elseif kind == "bowl" then
		handle = newPart("Handle", Vector3.new(1.6, 0.66, 1.6), STONEWARE, Enum.Material.SmoothPlastic, true)
	elseif kind == "board" then
		handle = newPart("Handle", Vector3.new(1.9, 0.14, 1.2), Color3.fromRGB(120, 84, 54), Enum.Material.Wood)
	else -- mug / darkmug: a square brutalist mug
		local color = kind == "darkmug" and STONEWARE or Color3.fromRGB(214, 210, 200)
		handle = newPart("Handle", Vector3.new(0.7, 0.8, 0.7), color, Enum.Material.SmoothPlastic)
		local loop = newPart("MugHandle", Vector3.new(0.12, 0.45, 0.35), color, Enum.Material.SmoothPlastic)
		loop.CFrame = CFrame.new(0.42, 0, 0)
		table.insert(extras, loop)
	end
	return handle, extras
end

-- Builds the Tool for a recipe id. quality is a label like "Perfect".
function Food.make(designId: string, displayName: string, quality: string?): Tool?
	local design = DESIGNS[designId]
	if not design then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = displayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = (quality and (quality .. " · ") or "") .. "Click to eat. Sit down for a bonus."
	tool:SetAttribute("Food", designId)
	tool:SetAttribute("Bites", design.bites)
	tool:SetAttribute("BitesTotal", design.bites)
	tool:SetAttribute("Quality", quality or "Decent")

	local handle, extras = makeHandle(design.handle)
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local foodParts = {}
	for _, e in extras do
		e.Parent = tool
		local w = Instance.new("WeldConstraint")
		w.Part0 = handle
		w.Part1 = e
		w.Parent = e
	end
	for i, b in design.bits do
		local p = newPart("Food" .. i, b.size, b.color, b.material, b.shape == "sphere")
		local rot = b.rot or Vector3.zero
		p.CFrame = CFrame.new(b.at) * CFrame.Angles(rot.X, rot.Y, rot.Z)
		p.Parent = tool
		local w = Instance.new("WeldConstraint")
		w.Part0 = handle
		w.Part1 = p
		w.Parent = p
		table.insert(foodParts, p)
	end
	-- Hold it a little in front of the hand.
	tool.Grip = CFrame.new(0, 0, 0.35)
	return tool
end

-- Shrinks the food after a bite (the plate stays the same).
function Food.shrink(tool: Tool, fraction: number)
	for _, p in tool:GetChildren() do
		if p:IsA("BasePart") and string.sub(p.Name, 1, 4) == "Food" then
			-- Resize in place, keeping the bottom of the food on the plate.
			local old = p.Size
			local new = old * Vector3.new(fraction ^ 0.5, fraction, fraction ^ 0.5)
			local weld = p:FindFirstChildOfClass("WeldConstraint")
			if weld then
				weld.Enabled = false
			end
			p.Size = new
			p.CFrame = p.CFrame * CFrame.new(0, (new.Y - old.Y) / 2, 0)
			if weld then
				weld.Enabled = true
			end
		end
	end
end

function Food.isDrink(designId: string): boolean
	return designId == "coffee" or designId == "tea" or designId == "cocoa"
end

return Food
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000D">
        <Properties>
          <string name="Name">Furnish</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Brutalist furniture kit shared by every home. Each function takes a frame
-- `cf` sitting on the floor: local +X is right, local +Z is "back" (toward
-- the wall), local -Z is the open side of the room. Everything usable is
-- registered in Registry so gameplay finds it automatically.

local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)
local Registry = require(script.Parent.Registry)

local Furnish = {}

local C = Build.Color
Furnish.Color = C

-- Block centred at local (x, y, z) with the given size.
local function blk(folder: Instance, cf: CFrame, x: number, y: number, z: number, size: Vector3, props: { [string]: any }): BasePart
	local p = table.clone(props)
	p.Size = size
	p.CFrame = cf * CFrame.new(x, y, z)
	return Build.part(folder, p)
end
Furnish.blk = blk

-- Block spanning two local corners.
local function span(folder: Instance, cf: CFrame, a: Vector3, b: Vector3, props: { [string]: any }): BasePart
	local minV, maxV = a:Min(b), a:Max(b)
	local c = (minV + maxV) / 2
	return blk(folder, cf, c.X, c.Y, c.Z, maxV - minV, props)
end
Furnish.span = span

local function cylY(folder: Instance, cf: CFrame, x: number, y: number, z: number, height: number, diameter: number, props: { [string]: any }): BasePart
	local p = table.clone(props)
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.pi / 2)
	return Build.part(folder, p)
end
Furnish.cylY = cylY

-- A seat whose occupant faces local direction `look`.
function Furnish.seat(folder: Instance, cf: CFrame, x: number, y: number, z: number, look: Vector3, size: Vector3?, color: Color3?): BasePart
	local pos = (cf * CFrame.new(x, y, z)).Position
	local dir = cf:VectorToWorldSpace(look)
	return Build.part(folder, {
		ClassName = "Seat",
		Name = "Seat",
		Size = size or Vector3.new(3.6, 1, 3.6),
		CFrame = CFrame.lookAt(pos, pos + dir),
		Material = Enum.Material.Fabric,
		Color = color or C.Fabric,
	})
end

local CONCRETE = { Material = Enum.Material.Concrete, Color = C.ConcreteIn }
local MARBLE = { Material = Enum.Material.Marble, Color = C.Marble }
local WOOD = { Material = Enum.Material.Wood, Color = C.Wood }
local METAL = { Material = Enum.Material.Metal, Color = C.Metal }
Furnish.CONCRETE, Furnish.MARBLE, Furnish.WOOD, Furnish.METAL = CONCRETE, MARBLE, WOOD, METAL

local function steamEmitter(parent: Instance): ParticleEmitter
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Enabled = false
	steam.Rate = 14
	steam.Lifetime = NumberRange.new(1.5, 2.5)
	steam.Speed = NumberRange.new(1.5, 3)
	steam.SpreadAngle = Vector2.new(15, 15)
	steam.EmissionDirection = Enum.NormalId.Top
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Color = ColorSequence.new(Color3.fromRGB(235, 235, 240))
	steam.Parent = parent
	return steam
end
Furnish.steamEmitter = steamEmitter

----------------------------------------------------------------------------
-- Lights
----------------------------------------------------------------------------

function Furnish.paperLamp(folder: Instance, pos: Vector3, height: number)
	local shade = Build.cylinderY(folder, pos + Vector3.new(0, height / 2, 0), height, 1.8, {
		Name = "PaperLamp",
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 226, 180),
	})
	local light = Build.pointLight(shade, C.Warm, 22, 1.4)
	table.insert(Registry.lamps, { part = shade, light = light })
	return shade
end

function Furnish.cubeLamp(folder: Instance, pos: Vector3)
	local cube = Build.part(folder, {
		Name = "CubeLamp",
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = CFrame.new(pos),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 220, 170),
	})
	local light = Build.pointLight(cube, C.Warm, 14, 1.2)
	table.insert(Registry.lamps, { part = cube, light = light })
	return cube
end

-- A warm light slot (thin glowing strip) between two world corners.
function Furnish.lightSlot(folder: Instance, a: Vector3, b: Vector3, face: Enum.NormalId?, range: number?)
	local strip = Build.box(folder, a, b, {
		Name = "LightSlot",
		Material = Enum.Material.Neon,
		Color = C.Warm,
		CastShadow = false,
	})
	Build.surfaceLight(strip, face or Enum.NormalId.Bottom, C.Warm, range or 18, 0.9, 70)
	return strip
end

----------------------------------------------------------------------------
-- Plants, books, notes
----------------------------------------------------------------------------

function Furnish.plant(folder: Instance, base: Vector3)
	local pot = Build.cylinderY(folder, base + Vector3.new(0, 1.2, 0), 2.4, 2.2, {
		Name = "PlantPot",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteIn,
	})
	local leaves = Instance.new("Model")
	leaves.Name = "Leaves"
	local rng = Random.new(math.floor(math.abs(base.X * 7 + base.Z * 3)))
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		Build.ellipsoid(leaves, CFrame.new(base + Vector3.new(math.cos(a) * 0.9, 3.2 + rng:NextNumber(0, 1.6), math.sin(a) * 0.9))
			* CFrame.Angles(math.sin(a) * 0.6, a, math.cos(a) * 0.6), Vector3.new(0.9, 0.25, 2.6), {
			Name = "Leaf",
			Color = Color3.fromRGB(58, 92, 60),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	leaves.Parent = folder
	table.insert(Registry.plants, { pot = pot, leaves = leaves })
	return pot
end

-- Bookshelf 10 wide, 9 tall, its back against local +Z.
function Furnish.bookshelf(folder: Instance, cf: CFrame)
	local shelf = span(folder, cf, Vector3.new(-5, 0, 0), Vector3.new(5, 9, 1.6), table.clone(WOOD))
	shelf.Name = "Bookshelf"
	local rng = Random.new(math.floor(math.abs(cf.X + cf.Z)))
	for row = 0, 2 do
		local y = 0.4 + row * 3
		local x = -4.6
		while x < 4.4 do
			local w = rng:NextNumber(0.3, 0.6)
			local h = rng:NextNumber(1.6, 2.4)
			local tone = rng:NextNumber(0.25, 0.75)
			span(folder, cf, Vector3.new(x, y + 0.2, -0.4), Vector3.new(x + w, y + 0.2 + h, 0.4), {
				Name = "Book",
				Color = Color3.new(tone * 0.9, tone * 0.75, tone * 0.6),
				CanCollide = false,
			})
			x += w + 0.05
		end
	end
	table.insert(Registry.bookshelves, shelf)
	return shelf
end

-- One of the architect's notes: a folded sheet with a faint glow.
function Furnish.note(folder: Instance, pos: Vector3, id: string, yaw: number?)
	local paper = Build.part(folder, {
		Name = "Note_" .. id,
		Size = Vector3.new(1, 0.06, 1.3),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, yaw or 0.4, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(236, 228, 210),
		CanCollide = false,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 230, 190)
	glow.Range = 5
	glow.Brightness = 0.6
	glow.Parent = paper
	paper:SetAttribute("NoteId", id)
	CollectionService:AddTag(paper, "ArchitectNote")
	table.insert(Registry.notes, { id = id, part = paper })
	return paper
end

----------------------------------------------------------------------------
-- Kitchen (about 19 x 16 studs): counter on the back wall, island with sink
----------------------------------------------------------------------------

-- opts.pantryA / opts.pantryB: local corners for the pantry if the default
-- spot (front-left) would block a doorway.
function Furnish.kitchen(folder: Instance, cf: CFrame, home: string, opts: { [string]: any }?)
	-- Back counter
	span(folder, cf, Vector3.new(-9.6, 0, 6), Vector3.new(3.6, 3.6, 9.4), table.clone(MARBLE)).Name = "Counter"
	local stove = span(folder, cf, Vector3.new(-8, 3.6, 6.4), Vector3.new(-4, 3.7, 9), {
		Name = "Stove",
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(10, 10, 10),
	})
	for _, dx in { -7, -5 } do
		cylY(folder, cf, dx, 3.72, 7.7, 0.05, 1.4, { Name = "Ring", Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 60, 30), CanCollide = false })
	end
	local oven = span(folder, cf, Vector3.new(-8, 0.6, 5.85), Vector3.new(-4, 3, 6), {
		Name = "Oven",
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(20, 18, 16),
	})
	span(folder, cf, Vector3.new(-7.6, 2.6, 5.7), Vector3.new(-4.4, 2.75, 5.85), {
		Name = "OvenHandle",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(150, 150, 150),
		CanCollide = false,
	})
	local kettle = cylY(folder, cf, -2.5, 4.4, 7.7, 1.6, 1.4, { Name = "Kettle", Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 150, 150) })
	local coffee = span(folder, cf, Vector3.new(0, 3.6, 6.8), Vector3.new(2, 6.4, 9.2), {
		Name = "CoffeeMachine",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(30, 30, 32),
	})
	span(folder, cf, Vector3.new(0.3, 4.8, 6.6), Vector3.new(1.7, 5, 6.8), { Name = "CoffeeLight", Material = Enum.Material.Neon, Color = C.Warm, CanCollide = false })
	-- Fridge and pantry
	local fridge = span(folder, cf, Vector3.new(4, 0, 5), Vector3.new(7.6, 9, 9.4), {
		Name = "Fridge",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(40, 40, 42),
	})
	span(folder, cf, Vector3.new(4.4, 4, 4.8), Vector3.new(4.7, 8, 5), {
		Name = "FridgeHandle",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(160, 160, 160),
	})
	local pa = opts and opts.pantryA or Vector3.new(-9.6, 0, -6)
	local pb = opts and opts.pantryB or Vector3.new(-6.8, 10, -1)
	local pantry = span(folder, cf, pa, pb, table.clone(WOOD))
	pantry.Name = "Pantry"
	-- Island with sink and stools
	span(folder, cf, Vector3.new(-4, 0, -2), Vector3.new(4, 3.6, 1.6), table.clone(MARBLE)).Name = "KitchenIsland"
	local sink = span(folder, cf, Vector3.new(0.5, 3.6, -1.6), Vector3.new(3.5, 3.7, 1.2), {
		Name = "KitchenSink",
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(36, 36, 38),
	})
	cylY(folder, cf, 2, 4.6, 1.4, 2, 0.25, { Name = "Tap", Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 150, 150), CanCollide = false })
	for _, x in { -2.6, 0, 2.6 } do
		cylY(folder, cf, x, 1.2, -4, 2.4, 0.4, { Name = "StoolLeg", Material = Enum.Material.Metal, Color = C.Metal })
		Furnish.seat(folder, cf, x, 2.7, -4, Vector3.zAxis, Vector3.new(1.8, 0.6, 1.8), C.Wood)
	end
	-- Pendant light
	local pendant = Build.ellipsoid(folder, cf * CFrame.new(0, 9, 0), Vector3.new(1.6, 1.2, 1.6), {
		Name = "Pendant",
		Material = Enum.Material.Neon,
		Color = C.Warm,
	})
	table.insert(Registry.lamps, { part = pendant, light = Build.pointLight(pendant, C.Warm, 18, 1.1) })

	local kitchen = {
		home = home,
		stove = stove,
		oven = oven,
		coffee = coffee,
		kettle = kettle,
		fridge = fridge,
		pantry = pantry,
		sink = sink,
		dishSpot = (cf * CFrame.new(-2.4, 3.6, -0.2)).Position,
		steam = steamEmitter(stove),
		dirty = 0,
		dishParts = {},
	}
	table.insert(Registry.kitchens, kitchen)
	return kitchen
end

----------------------------------------------------------------------------
-- Dining table for four (about 9 x 9 studs)
----------------------------------------------------------------------------

function Furnish.dining(folder: Instance, cf: CFrame)
	span(folder, cf, Vector3.new(-3, 2.6, -1.6), Vector3.new(3, 3, 1.6), table.clone(MARBLE)).Name = "DiningTable"
	span(folder, cf, Vector3.new(-2.4, 0, -0.6), Vector3.new(-1.4, 2.6, 0.6), table.clone(CONCRETE)).Name = "TableLeg"
	span(folder, cf, Vector3.new(1.4, 0, -0.6), Vector3.new(2.4, 2.6, 0.6), table.clone(CONCRETE)).Name = "TableLeg"
	for _, x in { -1.5, 1.5 } do
		for _, side in { -1, 1 } do
			local z = side * 3
			span(folder, cf, Vector3.new(x - 0.9, 0, z - 0.9), Vector3.new(x + 0.9, 1.3, z + 0.9), table.clone(WOOD)).Name = "ChairBase"
			Furnish.seat(folder, cf, x, 1.6, z, Vector3.new(0, 0, -side), Vector3.new(1.8, 0.6, 1.8), C.Fabric)
			span(folder, cf, Vector3.new(x - 0.9, 1.9, z + side * 0.75), Vector3.new(x + 0.9, 4.2, z + side * 0.95), table.clone(WOOD)).Name = "ChairBack"
		end
	end
	-- A candle in the middle of the table.
	local candle = cylY(folder, cf, 0, 3.4, 0, 0.8, 0.3, { Name = "Candle", Color = Color3.fromRGB(240, 234, 220), CanCollide = false })
	local flame = Build.ellipsoid(folder, cf * CFrame.new(0, 3.95, 0), Vector3.new(0.16, 0.3, 0.16), {
		Name = "CandleFlame",
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 190, 110),
		CanCollide = false,
	})
	table.insert(Registry.lamps, { part = flame, light = Build.pointLight(flame, Color3.fromRGB(255, 180, 100), 10, 0.8) })
	return candle
end

----------------------------------------------------------------------------
-- Fireplaces: "pit" (sunken square), "slot" (long wall slot), "column"
----------------------------------------------------------------------------

function Furnish.fireplace(folder: Instance, cf: CFrame, style: string, home: string)
	local corePos: CFrame
	if style == "pit" then
		span(folder, cf, Vector3.new(-4.5, 0, -4.5), Vector3.new(4.5, 1, 4.5), table.clone(CONCRETE)).Name = "FirePitRim"
		span(folder, cf, Vector3.new(-3, 0.95, -3), Vector3.new(3, 1.05, 3), { Name = "FirePitBed", Material = Enum.Material.Slate, Color = Color3.fromRGB(20, 18, 18) })
		for i = 1, 4 do
			local a = i * math.pi / 2 + 0.4
			Build.beam(folder, (cf * CFrame.new(math.cos(a) * 1.4, 1.3, math.sin(a) * 1.4)).Position,
				(cf * CFrame.new(-math.cos(a) * 1.4, 1.5, -math.sin(a) * 1.4)).Position, 0.5, 0.5,
				{ Name = "Log", Material = Enum.Material.Wood, Color = Color3.fromRGB(96, 70, 48), CanCollide = false })
		end
		corePos = cf * CFrame.new(0, 1.4, 0)
	elseif style == "slot" then
		-- A deep concrete mass on the back wall with a long glowing slot.
		span(folder, cf, Vector3.new(-7, 0, 5), Vector3.new(7, 6, 8), table.clone(CONCRETE)).Name = "FireMass"
		span(folder, cf, Vector3.new(-5.5, 1.6, 4.9), Vector3.new(5.5, 3.6, 6.5), { Name = "FireSlot", Material = Enum.Material.Slate, Color = Color3.fromRGB(14, 12, 12) })
		span(folder, cf, Vector3.new(-5.2, 1.7, 5.4), Vector3.new(5.2, 1.9, 6.2), { Name = "Embers", Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 110, 40), CanCollide = false })
		corePos = cf * CFrame.new(0, 2.2, 5.6)
	else -- column
		cylY(folder, cf, 0, 2, 0, 4, 4.4, table.clone(CONCRETE)).Name = "FireColumn"
		cylY(folder, cf, 0, 4.2, 0, 0.6, 5, { Name = "FireBowl", Material = Enum.Material.Metal, Color = C.Metal })
		cylY(folder, cf, 0, 4.45, 0, 0.1, 4.2, { Name = "Embers", Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 110, 40), CanCollide = false })
		corePos = cf * CFrame.new(0, 4.8, 0)
	end
	local core = Build.part(folder, {
		Name = "FireCore",
		Size = Vector3.new(2, 1, 2),
		CFrame = corePos,
		Transparency = 1,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = style == "slot" and 3 or 5
	fire.Heat = 5
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 10)
	fire.Parent = core
	local light = Build.pointLight(core, Color3.fromRGB(255, 150, 70), 30, 2.2)
	local embers = Instance.new("ParticleEmitter")
	embers.Rate = 6
	embers.Lifetime = NumberRange.new(1, 2)
	embers.Speed = NumberRange.new(2, 4)
	embers.SpreadAngle = Vector2.new(25, 25)
	embers.Size = NumberSequence.new(0.15, 0)
	embers.LightEmission = 1
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
	embers.Parent = core
	-- Log basket beside it.
	local basket = cylY(folder, cf, 7, 0.9, -2, 1.8, 2.6, { Name = "LogBasket", Material = Enum.Material.Fabric, Color = Color3.fromRGB(70, 60, 50) })
	local entry = { home = home, core = core, fire = fire, light = light, embers = embers, basket = basket, fuel = 80, baseSize = fire.Size }
	table.insert(Registry.fires, entry)
	return entry
end

----------------------------------------------------------------------------
-- Lounge: a long low sofa at local +Z facing -Z, rug in front, lamp
----------------------------------------------------------------------------

function Furnish.lounge(folder: Instance, cf: CFrame, width: number?)
	local w = width or 12
	span(folder, cf, Vector3.new(-w / 2, 0, 5), Vector3.new(w / 2, 1.2, 9), table.clone(WOOD)).Name = "SofaPlinth"
	span(folder, cf, Vector3.new(-w / 2, 1.2, 8), Vector3.new(w / 2, 4.2, 9.4), { Name = "SofaBack", Material = Enum.Material.Fabric, Color = C.Fabric })
	local n = math.floor(w / 4)
	for i = 0, n - 1 do
		local x = -w / 2 + 2 + i * 4
		Furnish.seat(folder, cf, x, 1.7, 6.4, -Vector3.zAxis, Vector3.new(3.8, 1, 3), C.Fabric)
	end
	span(folder, cf, Vector3.new(-w / 2 - 1, 0.01, -1), Vector3.new(w / 2 + 1, 0.1, 4.6), {
		Name = "Rug",
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(58, 52, 48),
		CanCollide = false,
	})
	Furnish.paperLamp(folder, (cf * CFrame.new(w / 2 + 2, 0, 7)).Position, 7)
end

----------------------------------------------------------------------------
-- Bed: headboard at local +Z (about 15 x 14 studs with nightstands)
----------------------------------------------------------------------------

function Furnish.bed(folder: Instance, cf: CFrame, home: string)
	span(folder, cf, Vector3.new(-6, 0, -1), Vector3.new(6, 1.4, 13), table.clone(CONCRETE)).Name = "BedPlinth"
	local mattress = span(folder, cf, Vector3.new(-5.6, 1.4, -0.6), Vector3.new(5.6, 2.8, 12.6), {
		Name = "Mattress",
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(64, 58, 54),
	})
	local duvet = span(folder, cf, Vector3.new(-5.6, 2.8, -0.6), Vector3.new(5.6, 3.1, 8), {
		Name = "Duvet",
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(78, 70, 64),
	})
	for _, x in { -2.8, 2.8 } do
		span(folder, cf, Vector3.new(x - 2.2, 2.8, 9.6), Vector3.new(x + 2.2, 3.9, 12), { Name = "Pillow", Material = Enum.Material.Fabric, Color = Color3.fromRGB(96, 88, 82) })
	end
	span(folder, cf, Vector3.new(-6, 1.4, 12.4), Vector3.new(6, 6, 13), table.clone(WOOD)).Name = "Headboard"
	for _, x in { -7.6, 7.6 } do
		span(folder, cf, Vector3.new(x - 0.8, 0, 10.6), Vector3.new(x + 0.8, 2.2, 12.2), table.clone(CONCRETE)).Name = "Nightstand"
		Furnish.cubeLamp(folder, (cf * CFrame.new(x, 2.9, 11.4)).Position)
	end
	local tidy = duvet.CFrame
	local entry = {
		home = home,
		mattress = mattress,
		duvet = duvet,
		tidy = tidy,
		messy = tidy * CFrame.new(1.2, 0.25, -1.5) * CFrame.Angles(0.06, 0.35, -0.05),
		messyNow = false,
	}
	table.insert(Registry.beds, entry)
	return entry
end

----------------------------------------------------------------------------
-- Bathroom: rain shower in the back-right corner, stone trough sink
----------------------------------------------------------------------------

function Furnish.bath(folder: Instance, cf: CFrame, home: string)
	span(folder, cf, Vector3.new(2, 0, 2), Vector3.new(8, 0.2, 8), { Name = "ShowerTray", Material = Enum.Material.Slate, Color = Color3.fromRGB(40, 40, 42) })
	span(folder, cf, Vector3.new(1.8, 0, 2), Vector3.new(2.2, 11, 5.5), { Name = "ShowerScreen", Material = Enum.Material.Glass, Color = C.Glass, Transparency = 0.7 })
	local head = cylY(folder, cf, 5, 11.5, 5, 0.3, 2.4, { Name = "ShowerHead", Material = Enum.Material.Metal, Color = C.Metal })
	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Enabled = false
	rain.Rate = 160
	rain.Lifetime = NumberRange.new(0.5, 0.6)
	rain.Speed = NumberRange.new(20, 22)
	rain.EmissionDirection = Enum.NormalId.Left -- the cylinder's local -X points down
	rain.SpreadAngle = Vector2.new(6, 6)
	rain.Size = NumberSequence.new(0.06)
	rain.Transparency = NumberSequence.new(0.3)
	rain.Color = ColorSequence.new(Color3.fromRGB(210, 225, 240))
	rain.Parent = head
	local sink = span(folder, cf, Vector3.new(-6, 3, 6), Vector3.new(-1, 4.4, 8), { Name = "Sink", Material = Enum.Material.Slate, Color = Color3.fromRGB(46, 42, 40) })
	span(folder, cf, Vector3.new(-6, 0, 6.6), Vector3.new(-1, 3, 8), table.clone(WOOD)).Name = "Vanity"
	table.insert(Registry.showers, { home = home, head = head, rain = rain })
	table.insert(Registry.sinks, sink)
end

----------------------------------------------------------------------------
-- Deed plinth: "make this your home"
----------------------------------------------------------------------------

function Furnish.deed(folder: Instance, cf: CFrame, homeId: string, title: string)
	local plinth = span(folder, cf, Vector3.new(-1.2, 0, -0.6), Vector3.new(1.2, 3.6, 0.6), table.clone(CONCRETE))
	plinth.Name = "DeedPlinth"
	local plate = span(folder, cf, Vector3.new(-1, 2.2, -0.75), Vector3.new(1, 3.4, -0.6), {
		Name = "DeedPlate",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(176, 140, 82),
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 80
	gui.LightInfluence = 1
	gui.Parent = plate
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = Color3.fromRGB(40, 30, 16)
	label.Text = string.upper(title) .. "\nno residents yet"
	label.Parent = gui
	local home = Registry.homes[homeId]
	if home then
		home.deed = plinth
		home.deedLabel = label
	end
	return plinth
end

----------------------------------------------------------------------------
-- Dock bell (ferry + boat)
----------------------------------------------------------------------------

function Furnish.bell(folder: Instance, pos: Vector3, home: string, boatSpawn: CFrame)
	Build.cylinderY(folder, pos + Vector3.new(0, 2.5, 0), 5, 0.4, { Name = "BellPost", Material = Enum.Material.Metal, Color = C.Metal })
	Build.box(folder, pos + Vector3.new(-1.2, 5, -0.2), pos + Vector3.new(1.2, 5.3, 0.2), { Name = "BellArm", Material = Enum.Material.Metal, Color = C.Metal })
	local bell = Build.ellipsoid(folder, CFrame.new(pos + Vector3.new(1, 4.3, 0)), Vector3.new(1.1, 1.3, 1.1), {
		Name = "FerryBell",
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(176, 140, 82),
	})
	table.insert(Registry.docks, { home = home, bell = bell, boatSpawn = boatSpawn })
	return bell
end

return Furnish
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000E">
        <Properties>
          <string name="Name">Gameplay</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Life on the ice: needs, cooking and eating, chores, fires, beds, plants,
-- reading, pets, four homes with deeds, the ferry and boats, the night when
-- the sea freezes, weather, fishing, upgrades, discoveries and the
-- architect's mystery.

local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Arch = require(Shared:WaitForChild("Arch"))
local Config = require(Shared:WaitForChild("Config"))
local Build = require(script.Parent.Build)
local Data = require(script.Parent.Data)
local Pets = require(script.Parent.Pets)
local Registry = require(script.Parent.Registry)
local Food = require(script.Parent.Food)
local Boats = require(script.Parent.Boats)
local Lore = require(script.Parent.Lore)
local Well = require(script.Parent:WaitForChild("Homes"):WaitForChild("Well"))

local Gameplay = {}

local refs
local remotes: any
local profiles: { [Player]: Data.Profile } = {}
local fishInventory: { [Player]: { { name: string, value: number } } } = {}
local pantry: { [Player]: { [string]: number } } = {}
local chores: { [Player]: { [string]: boolean } } = {}
local fishing: { [Player]: { state: string, token: number, biteAt: number? } } = {}
local cooking: { [Player]: { recipe: any, token: number, started: number, kitchen: any } } = {}
local atKitchen: { [Player]: any } = {}
local cooldowns: { [Player]: { [string]: number } } = {}
local reading: { [Player]: number } = {}

local day = 1
local weather = Config.WEATHER[1]
local frozen = false
local FREEZE_AT, THAW_AT = 22, 4.8

local discoveryById, upgradeById, recipeById, petById, choreById = {}, {}, {}, {}, {}
for _, d in Config.DISCOVERIES do
	discoveryById[d.id] = d
end
for _, u in Config.UPGRADES do
	upgradeById[u.id] = u
end
for _, r in Config.RECIPES do
	recipeById[r.id] = r
end
for _, p in Config.PETS do
	petById[p.id] = p
end
for _, c in Config.CHORES do
	choreById[c.id] = c
end

-- What eating each snack/drink does (cooked meals use their recipe effects).
local EXTRA_FOOD = {
	tea = { name = "Mug of Tea", effects = { Warmth = 18, Fun = 4 } },
	snack = { name = "Cheese & Crackers", effects = { Hunger = 18 } },
}

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

local function notify(player: Player, text: string, kind: string?)
	remotes.Notify:FireClient(player, text, kind or "info")
end

local function notifyAll(text: string, kind: string?)
	remotes.Notify:FireAllClients(text, kind or "info")
end

local function onCooldown(player: Player, key: string, seconds: number): boolean
	local list = cooldowns[player]
	if not list then
		return true
	end
	local now = os.clock()
	if list[key] and now < list[key] then
		notify(player, string.format("Give it %d more seconds.", math.ceil(list[key] - now)))
		return true
	end
	list[key] = now + seconds
	return false
end

local function getNeed(player: Player, need: string): number
	return (player:GetAttribute(need) :: number?) or 100
end

local function setNeed(player: Player, need: string, value: number)
	player:SetAttribute(need, math.clamp(value, 0, 100))
end

local function addNeed(player: Player, need: string, delta: number)
	setNeed(player, need, getNeed(player, need) + delta)
end

local function setCredits(player: Player, value: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.credits = value
	player:SetAttribute("Credits", value)
	local stats = player:FindFirstChild("leaderstats")
	local cv = stats and stats:FindFirstChild("Credits")
	if cv then
		cv.Value = value
	end
end

local function addCredits(player: Player, delta: number)
	local profile = profiles[player]
	if profile then
		setCredits(player, profile.credits + delta)
	end
end

local function idList(set: { [string]: boolean }): string
	local ids = {}
	for id in set do
		table.insert(ids, id)
	end
	return table.concat(ids, ",")
end

local function discover(player: Player, id: string)
	local profile = profiles[player]
	local d = discoveryById[id]
	if not profile or not d or profile.discoveries[id] then
		return
	end
	profile.discoveries[id] = true
	player:SetAttribute("Discoveries", idList(profile.discoveries))
	addCredits(player, d.reward)
	notify(player, string.format("Discovered: %s  (+%d credits)", d.name, d.reward), "discovery")
end

local function completeChore(player: Player, id: string)
	local done = chores[player]
	local chore = choreById[id]
	if not done or not chore or done[id] then
		return
	end
	done[id] = true
	player:SetAttribute("Chores", idList(done))
	addCredits(player, chore.reward)
	notify(player, string.format("Routine: %s  (+%d)", chore.name, chore.reward), "chore")
	for _, c in Config.CHORES do
		if not done[c.id] then
			return
		end
	end
	addCredits(player, 40)
	notify(player, "Every part of today's routine done. A good day on the ice (+40).", "discovery")
end

local function syncFish(player: Player)
	local inv = fishInventory[player] or {}
	local value = 0
	for _, f in inv do
		value += f.value
	end
	player:SetAttribute("FishCount", #inv)
	player:SetAttribute("FishValue", value)
end

local function syncPantry(player: Player)
	player:SetAttribute("Pantry", HttpService:JSONEncode(pantry[player] or {}))
end

local function syncTreats(player: Player)
	local profile = profiles[player]
	player:SetAttribute("Treats", profile and profile.treats or 0)
end

local function syncNotes(player: Player)
	local profile = profiles[player]
	if profile then
		player:SetAttribute("Notes", idList(profile.notes))
		player:SetAttribute("Melody", profile.flags.melody == true)
	end
end

local function restockPantry(player: Player)
	local stock = {}
	for _, item in Config.PANTRY do
		stock[item.id] = item.perDay
	end
	pantry[player] = stock
	syncPantry(player)
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Fades the screen, optionally plays a short camera "ride", then moves the player.
local function teleport(player: Player, cf: CFrame, ride: string?)
	local character = player.Character
	if not character then
		return
	end
	local hold = ride and 2.8 or 0.9
	remotes.Fade:FireClient(player, hold, ride)
	task.delay(ride and 2.6 or 0.35, function()
		if character.Parent then
			character:PivotTo(cf)
		end
	end)
end

local function ownsUpgrade(player: Player, id: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.upgrades[id] == true
end

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t >= 19.5 or t < 5.5
end

local function locationName(pos: Vector3): (string?, any)
	local interior = Registry.locate(pos)
	if not interior then
		return nil, nil
	end
	if interior.home == "ribcage" then
		local room = Arch.roomAt(pos)
		return "The Ribcage · " .. (room and room.name or "Gallery"), interior
	elseif interior.home == "well" then
		return Well.roomName(pos), interior
	end
	return interior.name, interior
end

----------------------------------------------------------------------------
-- Titles and homes
----------------------------------------------------------------------------

local function refreshTitle(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local home = Registry.homes[profile.home]
	local title = profile.title ~= "" and profile.title or (home and ("Lives in " .. home.name) or "Visitor")
	player:SetAttribute("Title", title)
	player:SetAttribute("Home", profile.home)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("TitleTag")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "TitleTag"
		gui.Size = UDim2.new(0, 220, 0, 22)
		gui.StudsOffset = Vector3.new(0, 2.4, 0)
		gui.MaxDistance = 70
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 14
		label.TextColor3 = Color3.fromRGB(255, 214, 160)
		label.TextStrokeTransparency = 0.6
		label.Parent = gui
		gui.Parent = head
	end
	gui.Text.Text = title
end

local function updateDeeds()
	for id, home in Registry.homes do
		if home.deedLabel then
			local names = {}
			for player, profile in profiles do
				if profile.home == id then
					table.insert(names, player.DisplayName)
				end
			end
			home.deedLabel.Text = string.upper(home.name) .. "\n" .. (#names == 0 and "no residents yet" or ("home of " .. table.concat(names, ", ")))
		end
	end
end

local function homeSpawn(player: Player): CFrame?
	local profile = profiles[player]
	local home = profile and Registry.homes[profile.home]
	return home and home.spawn
end

local function setupHomes()
	for id, home in Registry.homes do
		if home.deed then
			local claim = Build.prompt(home.deed, "Make this your home", home.name, 1, 9)
			claim.Triggered:Connect(function(player)
				local profile = profiles[player]
				if not profile then
					return
				end
				if profile.home == id then
					notify(player, "You already live here.")
					return
				end
				profile.home = id
				discover(player, "home")
				refreshTitle(player)
				updateDeeds()
				notify(player, "Welcome home. You'll wake up in " .. home.name .. " from now on.", "discovery")
				task.spawn(Data.save, player.UserId, profile)
			end)
			local concierge = Build.prompt(home.deed, "Open concierge", "Upgrades & pets", 0, 9)
			concierge.UIOffset = Vector2.new(0, 70)
			concierge.KeyboardKeyCode = Enum.KeyCode.F
			concierge.Triggered:Connect(function(player)
				remotes.OpenPanel:FireClient(player, "shop")
			end)
		end
	end
end

----------------------------------------------------------------------------
-- Travel: funicular, lift, hatches, ferry
----------------------------------------------------------------------------

local function nearBell(player: Player): boolean
	local hrp = rootPart(player)
	if not hrp then
		return false
	end
	for _, dock in Registry.docks do
		if (dock.bell.Position - hrp.Position).Magnitude < 22 then
			return true
		end
	end
	return false
end

local function setupTravel()
	local up = Build.prompt(refs.funicularBottom, "Ride up to the gallery", "Funicular", 0, 12)
	up.Triggered:Connect(function(player)
		teleport(player, refs.funicularTopArrive, "funicular_up")
	end)
	local down = Build.prompt(refs.funicularTop, "Ride down to the dock", "Funicular", 0, 12)
	down.Triggered:Connect(function(player)
		teleport(player, refs.funicularBottomArrive, "funicular_down")
	end)

	-- The roof hatch is only in reach from the top of the ladder.
	local hatch = Build.prompt(refs.hatch, "Open the hatch", "Roof hatch", 0.3, 7)
	hatch.Triggered:Connect(function(player)
		teleport(player, refs.roofArrive)
		notify(player, "Wind, fog and a long way down. A parka helps.", "warn")
	end)
	local roofHatch = Build.part(refs.root, {
		Name = "RoofHatchOutside",
		Size = Vector3.new(4, 0.6, 5),
		CFrame = refs.roofArrive * CFrame.new(0, -3.6, 0) * CFrame.Angles(0, 0, math.atan(Arch.slope(refs.roofArrive.X))),
		Material = Enum.Material.Metal,
		Color = Build.Color.Metal,
	})
	local back = Build.prompt(roofHatch, "Climb back inside", "Roof hatch", 0, 10)
	back.Triggered:Connect(function(player)
		teleport(player, CFrame.new(-102, refs.funicularTopArrive.Y, 11) * CFrame.Angles(0, -math.pi / 2, 0))
	end)

	local lift = Registry.misc.vertebraeLift
	if lift then
		local liftUp = Build.prompt(lift.bottom, "Ride the lift up", "Lift", 0, 12)
		liftUp.Triggered:Connect(function(player)
			teleport(player, lift.topArrive, "lift_up")
		end)
		local liftDown = Build.prompt(lift.top, "Ride the lift down", "Lift", 0, 12)
		liftDown.Triggered:Connect(function(player)
			teleport(player, lift.bottomArrive, "lift_down")
		end)
	end

	local parka = Build.prompt(refs.parkaRack, "Put on / take off parka", "Coat rack", 0, 10)
	parka.Triggered:Connect(function(player)
		local on = not player:GetAttribute("Parka")
		Gameplay.setParka(player, on)
		notify(player, on and "Parka on. The cold bites much less outside." or "Parka hung back up.")
	end)

	-- Ferry bells at every dock.
	for _, dock in Registry.docks do
		local bell = Build.prompt(dock.bell, "Ring for the ferry", "Ferry bell", 0, 10)
		bell.Triggered:Connect(function(player)
			remotes.OpenPanel:FireClient(player, "ferry")
		end)
	end
	remotes.Travel.OnServerEvent:Connect(function(player, homeId, inside)
		local home = type(homeId) == "string" and Registry.homes[homeId] or nil
		if not home or not nearBell(player) then
			return
		end
		if frozen then
			notify(player, "The ferry can't get through the ice tonight. Walk across it!", "warn")
			return
		end
		local profile = profiles[player]
		local goInside = inside == true and profile and profile.home == homeId
		teleport(player, goInside and home.spawn or home.dock, "ferry")
		notify(player, "The ferry noses through the floes to " .. home.name .. ".")
	end)
end

function Gameplay.setParka(player: Player, on: boolean)
	player:SetAttribute("Parka", on)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("ParkaShell")
	if old then
		old:Destroy()
	end
	if not on then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local shell = Instance.new("Part")
	shell.Name = "ParkaShell"
	shell.Size = torso.Size * Vector3.new(1.18, 1.25, 1.35)
	shell.CFrame = torso.CFrame * CFrame.new(0, -0.1, 0)
	shell.Color = Color3.fromRGB(58, 54, 50)
	shell.Material = Enum.Material.Fabric
	shell.CanCollide = false
	shell.CanQuery = false
	shell.CanTouch = false
	shell.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = shell
	weld.Part1 = torso
	weld.Parent = shell
	shell.Parent = character
end

----------------------------------------------------------------------------
-- Fires, lamps, doors
----------------------------------------------------------------------------

local function applyFire(f)
	local lit = f.fuel > 0
	f.fire.Enabled = lit
	f.light.Enabled = lit
	f.embers.Enabled = lit
	local k = f.fuel / 100
	f.fire.Size = math.max(2, f.baseSize * (0.4 + 0.8 * k))
	f.light.Brightness = 0.8 + 2 * k
	f.light.Range = 18 + 16 * k
	for _, p in f.prompts do
		p.ActionText = lit and "Add a log" or "Light the fire"
	end
end

local function feedFire(f, player: Player)
	if f.fuel >= 95 then
		notify(player, "The fire is roaring already.")
		return
	end
	local wasOut = f.fuel <= 0
	f.fuel = math.min(100, f.fuel + 45)
	applyFire(f)
	notify(player, wasOut and "The fire catches. Warm light spills across the concrete." or "You lay a log on the embers.")
	if isNight() then
		completeChore(player, "fire")
	end
end

local function setupFiresLampsDoors()
	for _, f in Registry.fires do
		f.prompts = { Build.prompt(f.core, "Add a log", "Fire", 0.4, 14) }
		if f.basket then
			table.insert(f.prompts, Build.prompt(f.basket, "Add a log", "Log basket", 0.4, 10))
		end
		for _, p in f.prompts do
			p.Triggered:Connect(function(player)
				feedFire(f, player)
			end)
		end
		applyFire(f)
	end

	for _, lamp in Registry.lamps do
		local p = Build.prompt(lamp.part, "Toggle light", "Lamp", 0, 9)
		p.Triggered:Connect(function()
			lamp.light.Enabled = not lamp.light.Enabled
			lamp.part.Material = lamp.light.Enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end)
		lamp.part.Material = Enum.Material.Neon
	end

	for _, door in Registry.doors do
		door.isOpen = false
		local p = Build.prompt(door.part, "Open", "Door", 0, 9)
		p.Triggered:Connect(function()
			door.isOpen = not door.isOpen
			p.ActionText = door.isOpen and "Close" or "Open"
			local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad)
			TweenService:Create(door.part, info, { CFrame = door.isOpen and door.open or door.closed }):Play()
			local handle = door.part:FindFirstChild("Handle")
			if handle then
				local target = (door.isOpen and door.open or door.closed) * door.closed:ToObjectSpace(handle.CFrame)
				TweenService:Create(handle, info, { CFrame = target }):Play()
			end
		end)
	end
end

----------------------------------------------------------------------------
-- Dishes, beds, showers, plants, books, kitchens
----------------------------------------------------------------------------

local function applyDishes(kitchen)
	for _, p in kitchen.dishParts do
		p:Destroy()
	end
	table.clear(kitchen.dishParts)
	for i = 1, kitchen.dirty do
		local col = (i - 1) % 2
		local row = math.floor((i - 1) / 2)
		local p = Build.cylinderY(refs.root, kitchen.dishSpot + Vector3.new(col * 1.6, 0.12 + row * 0.22, 0), 0.2, 1.4, {
			Name = "DirtyPlate",
			Color = Color3.fromRGB(196, 190, 182),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		table.insert(kitchen.dishParts, p)
	end
end

local function addDish(kitchen)
	if not kitchen then
		return
	end
	kitchen.dirty = math.min(Config.MAX_DIRTY_DISHES, kitchen.dirty + 1)
	applyDishes(kitchen)
end

local function setBedMessy(bed, messy: boolean)
	bed.messyNow = messy
	TweenService:Create(bed.duvet, TweenInfo.new(0.5), { CFrame = messy and bed.messy or bed.tidy }):Play()
end

local PLANT_FRESH = Color3.fromRGB(58, 92, 60)
local PLANT_DRY = Color3.fromRGB(92, 92, 62)

local function setPlant(plant, watered: boolean)
	plant.watered = watered
	for _, leaf in plant.leaves:GetChildren() do
		if leaf:IsA("BasePart") then
			leaf.Color = watered and PLANT_FRESH or PLANT_DRY
		end
	end
end

-- Gives a Tool of food and wires up eating it.
local function giveFood(player: Player, designId: string, displayName: string, effects, quality: string, mult: number, kitchen, cooked: boolean)
	local tool = Food.make(designId, displayName, quality)
	if not tool then
		return
	end
	tool:SetAttribute("Mult", mult)
	local busy = false
	tool.Activated:Connect(function()
		if busy or not tool.Parent then
			return
		end
		busy = true
		task.delay(0.7, function()
			busy = false
		end)
		local character = tool.Parent
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local total = tool:GetAttribute("BitesTotal") or 3
		local bites = tool:GetAttribute("Bites") or total
		local seated = humanoid.SeatPart ~= nil
		local m = mult * (seated and 1.3 or 1)
		for need, amount in effects do
			addNeed(player, need, amount * m / total)
		end
		if seated then
			addNeed(player, "Fun", 2)
			if cooked and not Food.isDrink(designId) then
				completeChore(player, "cook")
			end
		end
		if bites == total then
			if seated then
				notify(player, Food.isDrink(designId) and "You sit with it in both hands." or "You sit down and eat properly. It tastes better this way.")
			else
				notify(player, "Eating standing up... sit down at a table for a bonus.")
			end
		end
		bites -= 1
		tool:SetAttribute("Bites", bites)
		if bites <= 0 then
			tool:Destroy()
			addDish(kitchen)
			notify(player, "All gone. The dish goes back to the sink.")
		else
			Food.shrink(tool, bites / (bites + 1))
		end
	end)
	local backpack = player:FindFirstChildOfClass("Backpack")
	tool.Parent = backpack or player.Character
end

local function setupHomeLife()
	for _, bed in Registry.beds do
		local sleep = Build.prompt(bed.mattress, "Sleep", "Bed", 1, 10)
		sleep.Triggered:Connect(function(player)
			remotes.Fade:FireClient(player, 3)
			task.delay(1.5, function()
				setNeed(player, "Energy", 100)
				addNeed(player, "Warmth", 20)
				setBedMessy(bed, true)
				notify(player, "You slept to the sound of ice knocking softly against the concrete.")
			end)
		end)
		local make = Build.prompt(bed.duvet, "Make the bed", "Bed", 0.8, 10)
		make.UIOffset = Vector2.new(0, 70)
		make.KeyboardKeyCode = Enum.KeyCode.F
		make.Triggered:Connect(function(player)
			if not bed.messyNow then
				notify(player, "The bed is already made. Crisp.")
				return
			end
			setBedMessy(bed, false)
			completeChore(player, "bed")
		end)
		setBedMessy(bed, true)
	end

	for _, shower in Registry.showers do
		local p = Build.prompt(shower.head, "Take a rain shower", "Shower", 0.5, 13)
		p.Triggered:Connect(function(player)
			shower.rain.Enabled = true
			task.delay(6, function()
				shower.rain.Enabled = false
			end)
			setNeed(player, "Hygiene", 100)
			addNeed(player, "Warmth", 10)
			notify(player, "Hot water falling through a shaft of light. Clean.")
		end)
	end
	for _, sink in Registry.sinks do
		local p = Build.prompt(sink, "Wash up", "Sink", 0, 8)
		p.Triggered:Connect(function(player)
			addNeed(player, "Hygiene", 15)
		end)
	end

	for _, plant in Registry.plants do
		setPlant(plant, false)
		local p = Build.prompt(plant.pot, "Water plant", "Plant", 0.4, 8)
		p.Triggered:Connect(function(player)
			if plant.watered then
				notify(player, "This one is already watered today.")
				return
			end
			setPlant(plant, true)
			addNeed(player, "Fun", 3)
			completeChore(player, "plants")
		end)
	end

	for _, shelf in Registry.bookshelves do
		local p = Build.prompt(shelf, "Take a book", "Bookshelf", 0, 9)
		p.Triggered:Connect(function(player)
			player:SetAttribute("HasBook", true)
			notify(player, "You pick a worn paperback. Find a seat near a fire to read.")
		end)
	end

	for _, kitchen in Registry.kitchens do
		local wash = Build.prompt(kitchen.sink, "Wash the dishes", "Kitchen sink", 1.5, 9)
		wash.Triggered:Connect(function(player)
			if kitchen.dirty == 0 then
				notify(player, "The sink is empty. Nothing to wash.")
				return
			end
			kitchen.dirty = 0
			applyDishes(kitchen)
			addNeed(player, "Hygiene", 4)
			completeChore(player, "dishes")
			notify(player, "Dishes done, steam on the glass.")
		end)

		local pantryPrompt = Build.prompt(kitchen.pantry, "Look in the pantry", "Pantry", 0, 9)
		pantryPrompt.Triggered:Connect(function(player)
			remotes.OpenPanel:FireClient(player, "pantry")
		end)

		local fridge = Build.prompt(kitchen.fridge, "Grab a snack", "Fridge", 0, 8)
		fridge.Triggered:Connect(function(player)
			if onCooldown(player, "snack", 45) then
				return
			end
			giveFood(player, "snack", EXTRA_FOOD.snack.name, EXTRA_FOOD.snack.effects, "Cold", 1, kitchen, false)
			notify(player, "Cheese and crackers. Find a seat.")
		end)

		local tea = Build.prompt(kitchen.kettle, "Make tea", "Kettle", 0.8, 8)
		tea.Triggered:Connect(function(player)
			if onCooldown(player, "tea", 25) then
				return
			end
			kitchen.steam.Enabled = true
			task.delay(4, function()
				if (kitchen.cooking or 0) == 0 then
					kitchen.steam.Enabled = false
				end
			end)
			giveFood(player, "tea", EXTRA_FOOD.tea.name, EXTRA_FOOD.tea.effects, "Hot", 1, kitchen, false)
			notify(player, "Tea. Hold the mug in both hands.")
		end)
	end

	local bowl = Build.prompt(refs.catBowl, "Fill " .. Config.RESIDENT_CAT_NAME .. "'s bowl", "Cat bowl", 0.3, 8)
	bowl.Triggered:Connect(function(player)
		Pets.fillBowl(player)
	end)

	local record = Build.prompt(refs.recordPlayer, "Play a record", "Record player", 0, 9)
	record.Triggered:Connect(function(player)
		if not ownsUpgrade(player, "RecordPlayer") then
			notify(player, "No needle on it. Buy the Record Player at the concierge.", "warn")
			return
		end
		remotes.Music:FireClient(player)
	end)
end

----------------------------------------------------------------------------
-- Cooking
----------------------------------------------------------------------------

local function hasIngredients(player: Player, recipe): (boolean, string?)
	local stock = pantry[player] or {}
	for item, count in recipe.needs do
		if item == "fish" then
			if #(fishInventory[player] or {}) < count then
				return false, string.format("You need %d fish. Try fishing off the Ribcage dock.", count)
			end
		elseif (stock[item] or 0) < count then
			for _, p in Config.PANTRY do
				if p.id == item then
					return false, "Out of " .. string.lower(p.name) .. " until the pantry restocks in the morning."
				end
			end
			return false, "Missing " .. item
		end
	end
	return true
end

local function consume(player: Player, recipe)
	local stock = pantry[player]
	for item, count in recipe.needs do
		if item == "fish" then
			local inv = fishInventory[player]
			table.sort(inv, function(a, b)
				return a.value > b.value
			end)
			for _ = 1, count do
				table.remove(inv)
			end
			syncFish(player)
		else
			stock[item] -= count
		end
	end
	syncPantry(player)
end

local STATION_LABEL = { stove = "Cook on the stove", oven = "Bake in the oven", coffee = "Make coffee" }
local STATION_NAME = { stove = "Stove", oven = "Oven", coffee = "Coffee machine" }

local function setupCooking()
	for _, kitchen in Registry.kitchens do
		for station, label in STATION_LABEL do
			local p = Build.prompt(kitchen[station], label, STATION_NAME[station], 0, 9)
			p.Triggered:Connect(function(player)
				atKitchen[player] = kitchen
				remotes.OpenPanel:FireClient(player, "cook", station)
			end)
		end
	end

	remotes.StartCooking.OnServerInvoke = function(player: Player, recipeId: any)
		local recipe = type(recipeId) == "string" and recipeById[recipeId] or nil
		if not recipe then
			return false, "Unknown recipe."
		end
		local kitchen = atKitchen[player]
		local hrp = rootPart(player)
		local station = kitchen and kitchen[recipe.station]
		if not hrp or not station or (hrp.Position - station.Position).Magnitude > 16 then
			return false, "Stand at the " .. recipe.station .. " to make that."
		end
		if cooking[player] then
			return false, "You're already cooking something."
		end
		local ok, why = hasIngredients(player, recipe)
		if not ok then
			return false, why
		end
		consume(player, recipe)
		local token = math.random(1, 1e9)
		cooking[player] = { recipe = recipe, token = token, started = os.clock(), kitchen = kitchen }
		if recipe.station ~= "coffee" then
			kitchen.cooking = (kitchen.cooking or 0) + 1
			kitchen.steam.Enabled = true
		end
		return true, token
	end

	remotes.FinishCooking.OnServerInvoke = function(player: Player, token: any, scores: any)
		local session = cooking[player]
		if not session or session.token ~= token then
			return nil
		end
		cooking[player] = nil
		local recipe = session.recipe
		local kitchen = session.kitchen
		if recipe.station ~= "coffee" then
			kitchen.cooking = math.max(0, (kitchen.cooking or 1) - 1)
			if kitchen.cooking == 0 then
				kitchen.steam.Enabled = false
			end
		end
		if type(scores) ~= "table" then
			scores = {}
		end
		local total = 0
		for i = 1, #recipe.steps do
			total += math.clamp(tonumber(scores[i]) or 0, 0, 1)
		end
		local quality = total / #recipe.steps
		-- Each step takes real time to play; ignore impossibly fast results.
		if os.clock() - session.started < #recipe.steps * 0.6 then
			quality = math.min(quality, 0.3)
		end
		local label = quality >= 0.9 and "Perfect" or quality >= 0.65 and "Delicious" or quality >= 0.35 and "Decent" or "Slightly burnt"
		local mult = 0.55 + 0.65 * quality
		discover(player, "firstmeal")
		if recipe.makesTreats then
			local profile = profiles[player]
			profile.treats += recipe.makesTreats
			syncTreats(player)
			addDish(kitchen)
			return { name = recipe.name, quality = label, treats = recipe.makesTreats }
		end
		if recipe.station == "coffee" then
			completeChore(player, "coffee")
		end
		giveFood(player, recipe.id, recipe.name, recipe.effects, label, mult, kitchen, true)
		return { name = recipe.name, quality = label, food = true }
	end
end

----------------------------------------------------------------------------
-- Concierge: upgrades and pets
----------------------------------------------------------------------------

local function setupConcierge()
	local shop = Build.prompt(refs.tablet, "Open concierge", "Upgrades & pets", 0, 10)
	shop.Triggered:Connect(function(player)
		remotes.OpenPanel:FireClient(player, "shop")
	end)

	remotes.BuyUpgrade.OnServerInvoke = function(player: Player, id: any)
		local profile = profiles[player]
		local upgrade = type(id) == "string" and upgradeById[id] or nil
		if not profile or not upgrade then
			return false, "Unknown upgrade."
		end
		if profile.upgrades[id] then
			return false, "You already own that."
		end
		if profile.credits < upgrade.price then
			return false, "Not enough credits."
		end
		setCredits(player, profile.credits - upgrade.price)
		profile.upgrades[id] = true
		player:SetAttribute("Up_" .. id, true)
		notify(player, "Installed: " .. upgrade.name, "discovery")
		task.spawn(Data.save, player.UserId, profile)
		return true, "Installed!"
	end

	remotes.AdoptPet.OnServerInvoke = function(player: Player, id: any)
		local profile = profiles[player]
		local pet = type(id) == "string" and petById[id] or nil
		if not profile or not pet then
			return false, "Unknown pet."
		end
		if not profile.pets[id] then
			if profile.credits < pet.price then
				return false, "Not enough credits."
			end
			setCredits(player, profile.credits - pet.price)
			profile.pets[id] = true
			player:SetAttribute("Pet_" .. id, true)
			notify(player, "Welcome home, little " .. string.lower(pet.name) .. ".", "discovery")
		end
		-- Choosing an adopted pet toggles whether it walks with you.
		local newActive = profile.activePet == id and "" or id
		profile.activePet = newActive
		player:SetAttribute("ActivePet", newActive)
		Pets.setActive(player, newActive ~= "" and newActive or nil)
		task.spawn(Data.save, player.UserId, profile)
		return true, newActive ~= "" and "Walking with you." or "Resting at home."
	end

	local scope = Build.prompt(refs.telescope, "Look through telescope", "Telescope", 0, 10)
	scope.Triggered:Connect(function(player)
		if not ownsUpgrade(player, "Telescope") then
			notify(player, "It's capped. Buy the Roof Telescope at the concierge.", "warn")
			return
		end
		remotes.Telescope:FireClient(player, refs.telescope.Position + Vector3.new(0, 4, 0))
	end)
end

----------------------------------------------------------------------------
-- Fishing (ingredients for dinner) and selling the extras
----------------------------------------------------------------------------

local function rollFish(player: Player)
	local golden = ownsUpgrade(player, "GoldenRod")
	local function weight(f): number
		return (golden and f.value >= 30) and f.weight * 3 or f.weight
	end
	local total = 0
	for _, f in Config.FISH do
		total += weight(f)
	end
	local roll = math.random() * total
	for _, f in Config.FISH do
		roll -= weight(f)
		if roll <= 0 then
			return f
		end
	end
	return Config.FISH[1]
end

local function setupFishing()
	local cast = Build.prompt(refs.fishSpot, "Cast line", "Fishing spot", 0, 10)
	cast.Triggered:Connect(function(player)
		if fishing[player] then
			return
		end
		if frozen then
			notify(player, "The sea is frozen solid. Fish again after dawn.", "warn")
			return
		end
		local token = math.random(1, 1e9)
		fishing[player] = { state = "waiting", token = token }
		remotes.Fishing:FireClient(player, "cast")
		local wait = math.random() * (Config.FISH_BITE_MAX - Config.FISH_BITE_MIN) + Config.FISH_BITE_MIN
		if ownsUpgrade(player, "GoldenRod") then
			wait *= 0.5
		end
		task.delay(wait, function()
			local f = fishing[player]
			if not f or f.token ~= token then
				return
			end
			local hrp = rootPart(player)
			if not hrp or (hrp.Position - refs.fishSpot.Position).Magnitude > 25 then
				fishing[player] = nil
				remotes.Fishing:FireClient(player, "left")
				return
			end
			f.state = "bite"
			f.biteAt = os.clock()
			remotes.Fishing:FireClient(player, "bite")
			task.delay(Config.FISH_REEL_WINDOW + 0.3, function()
				local g = fishing[player]
				if g and g.token == token and g.state == "bite" then
					fishing[player] = nil
					remotes.Fishing:FireClient(player, "miss")
				end
			end)
		end)
	end)

	remotes.Fishing.OnServerEvent:Connect(function(player, action)
		if action ~= "reel" then
			return
		end
		local f = fishing[player]
		if not f then
			return
		end
		fishing[player] = nil
		if f.state == "waiting" then
			remotes.Fishing:FireClient(player, "early")
			return
		end
		if f.state == "bite" and f.biteAt and os.clock() - f.biteAt <= Config.FISH_REEL_WINDOW + 0.25 then
			local fish = rollFish(player)
			table.insert(fishInventory[player], { name = fish.name, value = fish.value })
			syncFish(player)
			profiles[player].fishCaught += 1
			remotes.Fishing:FireClient(player, "catch", fish.name, fish.value)
			discover(player, "firstfish")
		else
			remotes.Fishing:FireClient(player, "miss")
		end
	end)

	local sell = Build.prompt(refs.fishCrate, "Sell your fish", "Fish crate", 0, 10)
	sell.Triggered:Connect(function(player)
		local inv = fishInventory[player]
		if not inv or #inv == 0 then
			notify(player, "Your bucket is empty.", "warn")
			return
		end
		local total = 0
		for _, f in inv do
			total += f.value
		end
		local count = #inv
		table.clear(inv)
		syncFish(player)
		addCredits(player, total)
		notify(player, string.format("Sold %d fish for %d credits.", count, total), "discovery")
	end)
end

----------------------------------------------------------------------------
-- Whale breaches (rare, far out in the fog)
----------------------------------------------------------------------------

local function buildWhaleTemplate()
	local model = Instance.new("Model")
	model.Name = "WhaleTemplate"
	local template = Build.asset("Whale")
	local origin = CFrame.new()
	local core = Build.part(model, {
		Name = "Core",
		Size = Vector3.new(12, 10, 46),
		CFrame = origin,
		Transparency = 1,
		CanCollide = false,
	})
	if template then
		Build.placeAsset(template, model, origin, Vector3.new(24, 10, 49), { CanCollide = false })
	else
		local dark = Color3.fromRGB(42, 46, 52)
		Build.ellipsoid(model, origin, Vector3.new(11, 9, 44), { Name = "Body", Color = dark, CanCollide = false })
		Build.ellipsoid(model, origin * CFrame.new(0, -2.4, -4), Vector3.new(8.5, 5, 32), { Name = "Belly", Color = Color3.fromRGB(150, 152, 156), CanCollide = false })
		for _, side in { -1, 1 } do
			Build.ellipsoid(model, origin * CFrame.new(side * 8, -2, -8) * CFrame.Angles(0, side * 0.5, side * 0.4), Vector3.new(12, 1, 3.5), {
				Name = "Flipper",
				Color = dark,
				CanCollide = false,
			})
			Build.ellipsoid(model, origin * CFrame.new(side * 4, 0, 23) * CFrame.Angles(0, side * 0.5, 0), Vector3.new(9, 0.8, 4), {
				Name = "Fluke",
				Color = dark,
				CanCollide = false,
			})
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	model.PrimaryPart = core
	model.Parent = ReplicatedStorage
end

local function compassWord(v: Vector3): string
	local angle = math.deg(math.atan2(v.X, -v.Z)) % 360
	local names = { "north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west" }
	return names[(math.floor((angle + 22.5) / 45) % 8) + 1]
end

local function whaleLoop()
	while true do
		task.wait(math.random(Config.WHALE_MIN_INTERVAL, Config.WHALE_MAX_INTERVAL))
		if weather.id ~= "Blizzard" and not frozen then
			local angle = math.random() * math.pi * 2
			local dist = 220 + math.random() * 320
			local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			remotes.Whale:FireAllClients(pos, math.random() * math.pi * 2)
			notifyAll("Something huge breaks the surface to the " .. compassWord(pos) .. "...", "discovery")
			for _, player in Players:GetPlayers() do
				discover(player, "whale")
			end
		end
	end
end

----------------------------------------------------------------------------
-- The freeze: at night the sea becomes a floor between the homes
----------------------------------------------------------------------------

local function setFrozen(state: boolean)
	if frozen == state then
		return
	end
	frozen = state
	Workspace:SetAttribute("Frozen", state)
	local ice = Registry.misc.seaIce
	Lore.setFrozen(state)
	if state then
		-- Lift anyone swimming in the sea up onto the new ice.
		for _, player in Players:GetPlayers() do
			local hrp = rootPart(player)
			if hrp and hrp.Position.Y < 3 and not Registry.locate(hrp.Position) then
				player.Character:PivotTo(CFrame.new(hrp.Position.X, 4, hrp.Position.Z))
			end
		end
		ice.CanCollide = true
		ice.CanQuery = true
		TweenService:Create(ice, TweenInfo.new(6), { Transparency = 0.12 }):Play()
		notifyAll("The sea has frozen. Tonight you can walk between the homes.", "discovery")
	else
		ice.CanCollide = false
		ice.CanQuery = false
		TweenService:Create(ice, TweenInfo.new(4), { Transparency = 1 }):Play()
		notifyAll("The ice cracks open with a sound like thunder. Boats and the ferry are running again.", "warn")
	end
end

----------------------------------------------------------------------------
-- Weather, days and the per-second tick
----------------------------------------------------------------------------

local function pickWeather()
	local total = 0
	for _, w in Config.WEATHER do
		if w ~= weather then
			total += w.weight
		end
	end
	local roll = math.random() * total
	for _, w in Config.WEATHER do
		if w ~= weather then
			roll -= w.weight
			if roll <= 0 then
				return w
			end
		end
	end
	return Config.WEATHER[1]
end

local function weatherLoop()
	Workspace:SetAttribute("Weather", weather.id)
	while true do
		task.wait(math.random(Config.WEATHER_MIN_SECONDS, Config.WEATHER_MAX_SECONDS))
		weather = pickWeather()
		Workspace:SetAttribute("Weather", weather.id)
		local lines = {
			Mist = "Sea mist rolls in and swallows the ribs.",
			Still = "The fog thins. The sea goes perfectly still.",
			Snow = "It starts to snow over the Southern Ocean.",
			Blizzard = "A blizzard is coming in. Best to be inside, near a fire.",
		}
		notifyAll(lines[weather.id] or weather.name, weather.id == "Blizzard" and "warn" or "info")
	end
end

local function newDay()
	day += 1
	Workspace:SetAttribute("Day", day)
	for _, bed in Registry.beds do
		setBedMessy(bed, true)
	end
	for _, plant in Registry.plants do
		setPlant(plant, false)
	end
	for _, player in Players:GetPlayers() do
		if profiles[player] then
			restockPantry(player)
			chores[player] = {}
			reading[player] = 0
			player:SetAttribute("Chores", "")
		end
	end
	notifyAll(string.format("Morning, day %d. The pantries are restocked and the plants are thirsty.", day), "chore")
end

local function inBox(pos: Vector3, minV: Vector3, maxV: Vector3): boolean
	return pos.X >= minV.X and pos.X <= maxV.X and pos.Y >= minV.Y and pos.Y <= maxV.Y and pos.Z >= minV.Z and pos.Z <= maxV.Z
end

local function rescue(player: Player)
	setNeed(player, "Warmth", 45)
	local ribcageFire = Registry.fires[1]
	teleport(player, homeSpawn(player) or CFrame.new(ribcageFire.core.Position + Vector3.new(-6, 3, 0)))
	notify(player, "You got dangerously cold, and only just made it back inside.", "warn")
end

local function tickPlayer(player: Player)
	local character = player.Character
	local hrp = rootPart(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return
	end
	local pos = hrp.Position
	local place, interior = locationName(pos)
	local inside = interior ~= nil
	local swimming = humanoid:GetState() == Enum.HumanoidStateType.Swimming
	local inPool = inBox(pos, refs.poolMin - Vector3.new(1, 2, 1), refs.poolMax + Vector3.new(1, 4, 1))
	local onRoof = not inside
		and math.abs(pos.Z) < Arch.W / 2 + 2
		and math.abs(pos.X) < Arch.A * 0.95
		and pos.Y > Arch.yAt(pos.X) + Arch.T / 2 - 2
	local inSea = not inside and pos.Y < 3 and swimming
	local fire, fireDist = Registry.nearestFire(pos)
	local nearFire = fire ~= nil and fire.fuel > 0 and fireDist < Config.WARMTH.fireplaceRange
	local parka = player:GetAttribute("Parka") == true
	local W = Config.WARMTH
	local storm = weather.id == "Blizzard" and W.blizzardMultiplier or 1

	local warmth = getNeed(player, "Warmth")
	if nearFire then
		warmth += W.fireplaceGain * (0.4 + 0.6 * fire.fuel / 100)
	elseif inPool and swimming and ownsUpgrade(player, "HeatedPool") then
		warmth += W.heatedPoolGain
	elseif inside then
		if warmth < W.indoorsCap then
			warmth = math.min(W.indoorsCap, warmth + W.indoorsGain)
		end
	elseif inSea then
		warmth -= W.seaLoss
	elseif onRoof then
		warmth -= (parka and W.parkaRoofLoss or W.roofLoss) * storm
	else
		warmth -= (parka and W.parkaOutdoorsLoss or W.outdoorsLoss) * storm
	end
	setNeed(player, "Warmth", warmth)

	local hungerEmpty = getNeed(player, "Hunger") <= 0
	local energyDelta = -Config.NEED_DECAY.Energy * (hungerEmpty and 2 or 1)
	local seat = humanoid.SeatPart
	local seated = seat ~= nil
	if seated then
		energyDelta = Config.SEAT_ENERGY_GAIN
		if seat:IsA("VehicleSeat") then
			discover(player, "boat")
		end
	end
	addNeed(player, "Energy", energyDelta)
	addNeed(player, "Hunger", -Config.NEED_DECAY.Hunger)
	addNeed(player, "Hygiene", -Config.NEED_DECAY.Hygiene)

	local fun = -Config.NEED_DECAY.Fun
	if inPool and swimming then
		fun = Config.POOL_FUN_GAIN
	end
	local isReading = seated and player:GetAttribute("HasBook") == true and fire ~= nil and fireDist < 30
	player:SetAttribute("Reading", isReading)
	if isReading then
		fun = Config.READING_FUN_GAIN
		reading[player] = (reading[player] or 0) + 1
		if reading[player] >= 20 then
			completeChore(player, "read")
		end
	end
	addNeed(player, "Fun", fun)

	humanoid.WalkSpeed = getNeed(player, "Energy") < 10 and 10 or 16
	local outside = frozen and pos.Y < 6 and "On the Frozen Sea" or "Outside"
	player:SetAttribute("Location", place or (onRoof and "Top of the Spine" or (inSea and "In the Southern Ocean" or outside)))

	if (pos - refs.dockCenter).Magnitude < 45 then
		discover(player, "dock")
	end
	if interior then
		if interior.home == "ribcage" then
			local room = Arch.roomAt(pos)
			if room and room.id == "gallery" then
				discover(player, "gallery")
			elseif room and room.id == "lounge" then
				discover(player, "glassfloor")
			end
		elseif interior.home == "monolith" or interior.home == "vertebrae" or interior.home == "well" then
			discover(player, interior.home)
		end
		if weather.id == "Blizzard" then
			discover(player, "blizzard")
		end
	end
	if inPool and swimming then
		discover(player, "pool")
	end
	if fire and fire.home == "ribcage" and fireDist < 14 then
		discover(player, "fireplace")
	end
	if onRoof then
		discover(player, "roof")
	end
	if frozen and humanoid.FloorMaterial == Enum.Material.Glacier then
		discover(player, "freeze")
	end
	local clock = Lighting.ClockTime
	if clock > 5.6 and clock < 7.2 then
		discover(player, "dawn")
	end

	if getNeed(player, "Warmth") <= 0 then
		rescue(player)
	end
end

local function secondLoop()
	while true do
		task.wait(1)
		for _, f in Registry.fires do
			if f.fuel > 0 then
				f.fuel = math.max(0, f.fuel - 0.12)
				applyFire(f)
				if f.fuel == 0 then
					for _, player in Players:GetPlayers() do
						local hrp = rootPart(player)
						if hrp and (hrp.Position - f.core.Position).Magnitude < 80 then
							notify(player, "The fire has burned down to ash. Add a log?", "warn")
						end
					end
				end
			end
		end
		for _, player in Players:GetPlayers() do
			if profiles[player] then
				local ok, err = pcall(tickPlayer, player)
				if not ok then
					warn("[Ribcage] tick failed:", err)
				end
			end
		end
	end
end

local function dayCycle()
	local rate = 24 / (Config.DAY_LENGTH_MINUTES * 60)
	Lighting.ClockTime = Config.START_CLOCK_TIME
	Workspace:SetAttribute("Day", day)
	Workspace:SetAttribute("Frozen", false)
	RunService.Heartbeat:Connect(function(dt)
		local before = Lighting.ClockTime
		local after = (before + dt * rate) % 24
		Lighting.ClockTime = after
		Workspace:SetAttribute("Night", isNight())
		if before < 6 and after >= 6 then
			newDay()
		end
		if before < FREEZE_AT - 0.6 and after >= FREEZE_AT - 0.6 then
			notifyAll("It's getting bitterly cold. The sea is starting to freeze...", "info")
		end
		if before < THAW_AT - 0.6 and after >= THAW_AT - 0.6 and frozen then
			notifyAll("The ice is groaning. Get off the sea before dawn!", "warn")
		end
		setFrozen(after >= FREEZE_AT or after < THAW_AT)
	end)
end

----------------------------------------------------------------------------
-- Players
----------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local profile = Data.load(player.UserId)
	if profile.home ~= "" and not Registry.homes[profile.home] then
		profile.home = ""
	end
	profiles[player] = profile
	fishInventory[player] = {}
	cooldowns[player] = {}
	chores[player] = {}
	restockPantry(player)

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local credits = Instance.new("IntValue")
	credits.Name = "Credits"
	credits.Value = profile.credits
	credits.Parent = stats
	stats.Parent = player

	for _, need in Config.NEEDS do
		player:SetAttribute(need, need == "Warmth" and 80 or 85)
	end
	player:SetAttribute("Credits", profile.credits)
	player:SetAttribute("Parka", false)
	player:SetAttribute("Chores", "")
	for id in profile.upgrades do
		player:SetAttribute("Up_" .. id, true)
	end
	for id in profile.pets do
		player:SetAttribute("Pet_" .. id, true)
	end
	player:SetAttribute("ActivePet", profile.activePet)
	player:SetAttribute("Discoveries", idList(profile.discoveries))
	syncFish(player)
	syncTreats(player)
	syncNotes(player)
	updateDeeds()

	local function onCharacter(character: Model)
		task.wait(0.3)
		if profiles[player] ~= profile then
			return
		end
		local spawnAt = homeSpawn(player)
		if spawnAt then
			character:PivotTo(spawnAt)
		end
		if player:GetAttribute("Parka") then
			Gameplay.setParka(player, true)
		end
		if profile.activePet ~= "" then
			Pets.setActive(player, profile.activePet)
		end
		refreshTitle(player)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		Data.save(player.UserId, profile)
	end
	profiles[player] = nil
	fishInventory[player] = nil
	pantry[player] = nil
	chores[player] = nil
	fishing[player] = nil
	cooldowns[player] = nil
	reading[player] = nil
	atKitchen[player] = nil
	local session = cooking[player]
	cooking[player] = nil
	if session and session.recipe.station ~= "coffee" then
		session.kitchen.cooking = math.max(0, (session.kitchen.cooking or 1) - 1)
		if session.kitchen.cooking == 0 then
			session.kitchen.steam.Enabled = false
		end
	end
	updateDeeds()
end

function Gameplay.start(builtRefs)
	refs = builtRefs
	local ribcageFire = Registry.fires[1]
	refs.fireLit = function()
		return ribcageFire.fuel > 0
	end

	local old = ReplicatedStorage:FindFirstChild("Remotes")
	if old then
		old:Destroy()
	end
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	for _, name in { "Notify", "Fade", "Fishing", "OpenPanel", "Telescope", "Whale", "Music", "Organ", "Travel" } do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotes
	end
	for _, name in { "BuyUpgrade", "AdoptPet", "StartCooking", "FinishCooking" } do
		local r = Instance.new("RemoteFunction")
		r.Name = name
		r.Parent = remotes
	end
	remotes.Parent = ReplicatedStorage

	buildWhaleTemplate()
	setupHomes()
	setupTravel()
	setupFiresLampsDoors()
	setupHomeLife()
	setupCooking()
	setupConcierge()
	setupFishing()
	Pets.start(refs, {
		notify = notify,
		discover = discover,
		addNeed = addNeed,
		onCooldown = onCooldown,
		completeChore = completeChore,
		useTreat = function(player: Player): boolean
			local profile = profiles[player]
			if not profile or profile.treats <= 0 then
				return false
			end
			profile.treats -= 1
			syncTreats(player)
			return true
		end,
	})
	Boats.start({ notify = notify })
	Lore.start({
		profile = function(player: Player)
			return profiles[player]
		end,
		openPanel = function(player: Player, kind: string, arg: any)
			remotes.OpenPanel:FireClient(player, kind, arg)
		end,
		syncNotes = syncNotes,
		addCredits = addCredits,
		refreshTitle = refreshTitle,
		discover = discover,
		notify = notify,
		teleport = teleport,
	}, remotes)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(function()
		for player, profile in profiles do
			Data.save(player.UserId, profile)
		end
	end)

	dayCycle()
	task.spawn(secondLoop)
	task.spawn(weatherLoop)
	task.spawn(whaleLoop)
end

return Gameplay
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX0000000F">
        <Properties>
          <string name="Name">Homes</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000010">
          <Properties>
            <string name="Name">Monolith</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE MONOLITH: a 220-stud slab of board-marked concrete standing alone on a
-- basalt rock to the south. One glass slit runs up its face. Inside, three
-- stacked floors joined by steep concrete ramps.

local Workspace = game:GetService("Workspace")

local Build = require(script.Parent.Parent.Build)
local Furnish = require(script.Parent.Parent.Furnish)
local Registry = require(script.Parent.Parent.Registry)

local Monolith = {}

local C = Build.Color
Monolith.ORIGIN = Vector3.new(40, 0, 700)
local O = Monolith.ORIGIN

-- Interior: x -30..30, z -16..16. Floors (top of slab) at y 10, 30, 50; roof at 70.
local FLOORS = { 10, 30, 50 }
local TOP = 70

local function box(folder, a: Vector3, b: Vector3, props)
	return Build.box(folder, O + a, O + b, props)
end

local function concrete(name: string, color: Color3?)
	return { Name = name, Material = Enum.Material.Concrete, Color = color or C.ConcreteOut }
end

-- A floor slab from y-2 to y with a rectangular stair hole cut out.
local function slabWithHole(folder, y: number, hx0: number, hx1: number, hz0: number, hz1: number)
	local p = concrete("FloorSlab", C.Floor)
	p.Reflectance = 0.05
	box(folder, Vector3.new(-30, y - 2, -16), Vector3.new(hx0, y, 16), p)
	box(folder, Vector3.new(hx1, y - 2, -16), Vector3.new(30, y, 16), p)
	box(folder, Vector3.new(hx0, y - 2, -16), Vector3.new(hx1, y, hz0), p)
	box(folder, Vector3.new(hx0, y - 2, hz1), Vector3.new(hx1, y, 16), p)
	-- Railing along the open side of the hole.
	local rx = hx0 < 0 and hx1 + 0.3 or hx0 - 0.3
	box(folder, Vector3.new(rx - 0.15, y, hz1 - 0.2), Vector3.new(rx + 0.15, y + 3.4, -12), {
		Name = "Rail",
		Material = Enum.Material.Glass,
		Color = C.Glass,
		Transparency = 0.6,
	})
end

-- A straight concrete ramp in the lane x0..x1 from (zStart, yStart) to (zEnd, yEnd).
local function ramp(folder, x0: number, x1: number, zStart: number, yStart: number, zEnd: number, yEnd: number)
	local x = (x0 + x1) / 2
	local p1 = O + Vector3.new(x, yStart - 0.55, zStart)
	local p2 = O + Vector3.new(x, yEnd - 0.55, zEnd)
	local r = Build.beam(folder, p1, p2, x1 - x0, 1, concrete("Ramp", C.Floor))
	r.Size += Vector3.new(0, 0, 1.5)
	-- Painted-on step lines (no collision) so it reads as a stair.
	local n = 18
	for i = 1, n - 1 do
		local t = i / n
		local p = p1:Lerp(p2, t) + Vector3.new(0, 0.56, 0)
		Build.part(folder, {
			Name = "StepLine",
			Size = Vector3.new(x1 - x0, 0.05, 0.2),
			CFrame = CFrame.lookAt(p, p + (p2 - p1)) ,
			Color = Color3.fromRGB(60, 55, 50),
			CanCollide = false,
			CanQuery = false,
		})
	end
end

local function shell(folder)
	-- Foundation and the solid upper mass.
	box(folder, Vector3.new(-32, -24, -18), Vector3.new(32, FLOORS[1], 18), concrete("Foundation", C.ConcreteDark))
	box(folder, Vector3.new(-32, TOP, -18), Vector3.new(32, 220, 18), concrete("Mass"))
	-- Walls between the floors.
	box(folder, Vector3.new(-32, FLOORS[1], 16), Vector3.new(32, TOP, 18), concrete("BackWall", C.ConcreteIn))
	box(folder, Vector3.new(-32, FLOORS[1], -18), Vector3.new(-30, TOP, 16), concrete("SideWall", C.ConcreteIn))
	box(folder, Vector3.new(30, FLOORS[1], -18), Vector3.new(32, TOP, 16), concrete("SideWall", C.ConcreteIn))
	-- Front wall with the glass slit (x -6..6) and the entrance (x -3..3, first 10 studs).
	box(folder, Vector3.new(-30, FLOORS[1], -18), Vector3.new(-6, TOP, -16), concrete("FrontWall", C.ConcreteIn))
	box(folder, Vector3.new(6, FLOORS[1], -18), Vector3.new(30, TOP, -16), concrete("FrontWall", C.ConcreteIn))
	local glass = { Name = "Slit", Material = Enum.Material.Glass, Color = C.Glass, Transparency = 0.78, CastShadow = false }
	box(folder, Vector3.new(-6, FLOORS[1] + 10, -17.3), Vector3.new(6, TOP, -16.7), glass)
	box(folder, Vector3.new(-6, FLOORS[1], -17.3), Vector3.new(-3, FLOORS[1] + 10, -16.7), glass)
	box(folder, Vector3.new(3, FLOORS[1], -17.3), Vector3.new(6, FLOORS[1] + 10, -16.7), glass)
	-- The slit continues up the solid mass as a thin lit groove.
	box(folder, Vector3.new(-1, TOP, -18.3), Vector3.new(1, 210, -17.9), {
		Name = "SlitGlow",
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 200, 140),
		Transparency = 0.25,
		CastShadow = false,
	})
	-- Board-marking: thin darker lines across the front and back faces.
	for y = 14, 214, 12 do
		for _, z in { -18.05, 18.05 } do
			box(folder, Vector3.new(-32, y, z - 0.05), Vector3.new(32, y + 0.25, z + 0.05), {
				Name = "BoardLine",
				Material = Enum.Material.Concrete,
				Color = Color3.fromRGB(120, 120, 118),
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
	-- Floor slabs with holes for the ramps (alternate sides of the building).
	slabWithHole(folder, FLOORS[2], 22, 28, -16, -2)
	slabWithHole(folder, FLOORS[3], -28, -22, -16, -2)
	ramp(folder, 22, 28, 14, FLOORS[1], -14, FLOORS[2])
	ramp(folder, -28, -22, 14, FLOORS[2], -14, FLOORS[3])
	-- Warm light slots along the back wall of each floor.
	for _, y in FLOORS do
		Furnish.lightSlot(folder, O + Vector3.new(-28, y + 15, 15.6), O + Vector3.new(28, y + 15.3, 16))
	end
end

function Monolith.build(root: Instance)
	local folder = Build.folder(root, "TheMonolith")
	Registry.addHome({
		id = "monolith",
		name = "The Monolith",
		center = O + Vector3.new(0, 30, 0),
		spawn = CFrame.new(O + Vector3.new(0, FLOORS[1] + 3, -8)),
		dock = CFrame.new(O + Vector3.new(0, 8, -96)),
	})

	-- Basalt rock it stands on, with snow, and an approach ramp to the door.
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(O + Vector3.new(0, -20, -14)), Vector3.new(112, 48, 104), Enum.Material.Basalt)
	terrain:FillBall(O + Vector3.new(-50, -4, 20), 26, Enum.Material.Basalt)
	terrain:FillBall(O + Vector3.new(48, -6, -40), 22, Enum.Material.Basalt)
	terrain:FillBlock(CFrame.new(O + Vector3.new(0, 4.5, -44)), Vector3.new(104, 1, 36), Enum.Material.Snow)
	Build.beam(folder, O + Vector3.new(0, 4.5, -60), O + Vector3.new(0, FLOORS[1] - 0.5, -17), 8, 1, concrete("ApproachRamp", C.ConcreteOut))
	shell(folder)

	-- Ground floor: kitchen and dining.
	local y1 = FLOORS[1]
	Furnish.kitchen(folder, CFrame.new(O + Vector3.new(-8, y1, 6)), "monolith")
	Furnish.dining(folder, CFrame.new(O + Vector3.new(-12, y1, -9)))
	Furnish.deed(folder, CFrame.new(O + Vector3.new(9, y1, -12)), "monolith", "The Monolith")
	Furnish.plant(folder, O + Vector3.new(-27, y1, -13))
	Furnish.plant(folder, O + Vector3.new(16, y1, 13))
	Furnish.note(folder, O + Vector3.new(-12.5, y1 + 3, -9.6), "n4", 0.2)

	-- Middle floor: the fire room.
	local y2 = FLOORS[2]
	Furnish.fireplace(folder, CFrame.new(O + Vector3.new(-4, y2, -6)), "pit", "monolith")
	Furnish.lounge(folder, CFrame.new(O + Vector3.new(-4, y2, -6)), 16)
	Furnish.bookshelf(folder, CFrame.new(O + Vector3.new(-14, y2, 14.4)))
	Furnish.plant(folder, O + Vector3.new(14, y2, 13))
	Furnish.paperLamp(folder, O + Vector3.new(14, y2, -13), 7)

	-- Top floor: sleeping and bathing.
	local y3 = FLOORS[3]
	Furnish.bed(folder, CFrame.new(O + Vector3.new(8, y3, 2)), "monolith")
	Furnish.bath(folder, CFrame.new(O + Vector3.new(-12, y3, 6)), "monolith")
	Furnish.plant(folder, O + Vector3.new(25, y3, -13))
	Furnish.note(folder, O + Vector3.new(15.6, y3 + 2.2, 13.4), "n5", 1.2)

	-- Dock with the ferry bell and a boat.
	box(folder, Vector3.new(-5, 3, -64), Vector3.new(5, 5, -112), concrete("Pier", C.ConcreteOut))
	for z = -70, -110, -14 do
		Build.cylinderY(folder, O + Vector3.new(-4, -12, z), 32, 2, concrete("Pile", C.ConcreteDark))
		Build.cylinderY(folder, O + Vector3.new(4, -12, z), 32, 2, concrete("Pile", C.ConcreteDark))
	end
	Furnish.bell(folder, O + Vector3.new(-3.5, 5, -108), "monolith", CFrame.new(O + Vector3.new(11, 1.2, -96)))
	Furnish.cubeLamp(folder, O + Vector3.new(3.8, 5.7, -110))

	for i, y in FLOORS do
		local names = { "Kitchen Floor", "Fire Room", "Sleeping Floor" }
		Registry.addInterior("monolith", "The Monolith · " .. names[i], O + Vector3.new(-30, y - 1, -16), O + Vector3.new(30, y + 19, 16))
	end
end

return Monolith
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000011">
          <Properties>
            <string name="Name">Vertebrae</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE VERTEBRAE: five concrete cubes on tall pylons, stepping up out of the
-- sea to the west like bones of a spine, joined by sloped glass bridges.
-- A lift in the first pylon brings you up from the dock.

local Build = require(script.Parent.Parent.Build)
local Furnish = require(script.Parent.Parent.Furnish)
local Registry = require(script.Parent.Parent.Registry)

local Vertebrae = {}

local C = Build.Color
Vertebrae.ORIGIN = Vector3.new(-700, 0, -420)
local V = Vertebrae.ORIGIN

-- x0 = west edge, s = cube size, f = floor height.
local CUBES = {
	{ x0 = 0, s = 24, f = 30, name = "Entrance Hall" },
	{ x0 = 36, s = 24, f = 38, name = "Kitchen" },
	{ x0 = 72, s = 28, f = 46, name = "Fire Room" },
	{ x0 = 112, s = 24, f = 54, name = "Bedroom" },
	{ x0 = 148, s = 22, f = 62, name = "Bath & Lookout" },
}
local H = 16 -- interior height
local DOOR_H = 9

local function box(folder, a: Vector3, b: Vector3, props)
	return Build.box(folder, V + a, V + b, props)
end

local function concrete(name: string, color: Color3?)
	return { Name = name, Material = Enum.Material.Concrete, Color = color or C.ConcreteOut }
end

-- A wall slab across z at x a..b, with a centred doorway if `door`.
local function endWall(folder, a: number, b: number, half: number, f: number, door: boolean)
	local props = concrete("EndWall", C.ConcreteIn)
	if not door then
		box(folder, Vector3.new(a, f, -half), Vector3.new(b, f + H, half), props)
		return
	end
	box(folder, Vector3.new(a, f, -half), Vector3.new(b, f + H, -3), props)
	box(folder, Vector3.new(a, f, 3), Vector3.new(b, f + H, half), props)
	box(folder, Vector3.new(a, f + DOOR_H, -3), Vector3.new(b, f + H, 3), props)
end

local function cube(folder, i: number)
	local c = CUBES[i]
	local x0, x1, half, f = c.x0, c.x0 + c.s, c.s / 2, c.f
	-- Floor and roof slabs.
	box(folder, Vector3.new(x0, f - 2, -half), Vector3.new(x1, f, half), { Name = "Floor", Material = Enum.Material.Concrete, Color = C.Floor, Reflectance = 0.05 })
	box(folder, Vector3.new(x0, f + H, -half), Vector3.new(x1, f + H + 2, half), concrete("Roof"))
	-- Back wall.
	box(folder, Vector3.new(x0, f, half - 2), Vector3.new(x1, f + H, half), concrete("BackWall", C.ConcreteIn))
	-- Front wall with a deep-set picture window.
	local front = concrete("FrontWall", C.ConcreteIn)
	box(folder, Vector3.new(x0, f, -half), Vector3.new(x1, f + 3, -half + 2), front)
	box(folder, Vector3.new(x0, f + 14, -half), Vector3.new(x1, f + H, -half + 2), front)
	box(folder, Vector3.new(x0, f + 3, -half), Vector3.new(x0 + 3, f + 14, -half + 2), front)
	box(folder, Vector3.new(x1 - 3, f + 3, -half), Vector3.new(x1, f + 14, -half + 2), front)
	box(folder, Vector3.new(x0 + 3, f + 3, -half + 0.7), Vector3.new(x1 - 3, f + 14, -half + 1.3), {
		Name = "Window",
		Material = Enum.Material.Glass,
		Color = C.Glass,
		Transparency = 0.8,
		CastShadow = false,
	})
	-- End walls: doorways toward the neighbours; the last cube ends in glass.
	endWall(folder, x0, x0 + 2, half - 2, f, i > 1)
	if i < #CUBES then
		endWall(folder, x1 - 2, x1, half - 2, f, true)
	else
		local frame = concrete("LookoutFrame", C.ConcreteIn)
		box(folder, Vector3.new(x1 - 2, f, -half + 2), Vector3.new(x1, f + 1, half - 2), frame)
		box(folder, Vector3.new(x1 - 2, f + 15, -half + 2), Vector3.new(x1, f + H, half - 2), frame)
		box(folder, Vector3.new(x1 - 1.3, f + 1, -half + 2), Vector3.new(x1 - 0.7, f + 15, half - 2), {
			Name = "LookoutGlass",
			Material = Enum.Material.Glass,
			Color = C.Glass,
			Transparency = 0.8,
			CastShadow = false,
		})
	end
	-- Pylon down into the sea, and a "spinous process" fin on the roof.
	local cx = (x0 + x1) / 2
	box(folder, Vector3.new(cx - 4, -24, -4), Vector3.new(cx + 4, f - 2, 4), concrete("Pylon", C.ConcreteDark))
	Build.part(folder, {
		Name = "SpineFin",
		Size = Vector3.new(2, 16, 9),
		CFrame = CFrame.new(V + Vector3.new(cx, f + H + 8, 3)) * CFrame.Angles(-0.45, 0, 0),
		Material = Enum.Material.Concrete,
		Color = C.ConcreteOut,
	})
	-- Warm light slot along the back wall.
	Furnish.lightSlot(folder, V + Vector3.new(x0 + 3, f + 13, half - 2.4), V + Vector3.new(x1 - 3, f + 13.3, half - 2))
	Registry.addInterior("vertebrae", "The Vertebrae · " .. c.name, V + Vector3.new(x0 + 2, f - 1, -half + 2), V + Vector3.new(x1 - 2, f + H, half - 2))
end

local function bridge(folder, a, b)
	local p1 = V + Vector3.new(a.x0 + a.s, a.f - 0.55, 0)
	local p2 = V + Vector3.new(b.x0, b.f - 0.55, 0)
	local floor = Build.beam(folder, p1, p2, 7, 1, { Name = "BridgeFloor", Material = Enum.Material.Concrete, Color = C.Floor })
	floor.Size += Vector3.new(0, 0, 1)
	for _, z in { -3.6, 3.6 } do
		Build.beam(folder, p1 + Vector3.new(0, 5.4, z), p2 + Vector3.new(0, 5.4, z), 0.4, 10, {
			Name = "BridgeGlass",
			Material = Enum.Material.Glass,
			Color = C.Glass,
			Transparency = 0.75,
			CastShadow = false,
		})
	end
	Build.beam(folder, p1 + Vector3.new(0, 10.9, 0), p2 + Vector3.new(0, 10.9, 0), 8, 1, concrete("BridgeRoof"))
	Registry.addInterior("vertebrae", "The Vertebrae · Glass Bridge",
		V + Vector3.new(a.x0 + a.s, a.f - 1, -3.6), V + Vector3.new(b.x0, b.f + 10, 3.6))
end

function Vertebrae.build(root: Instance)
	local folder = Build.folder(root, "TheVertebrae")
	Registry.addHome({
		id = "vertebrae",
		name = "The Vertebrae",
		center = V + Vector3.new(85, 40, 0),
		spawn = CFrame.new(V + Vector3.new(6, CUBES[1].f + 3, -4)) * CFrame.Angles(0, -math.pi / 2, 0),
		dock = CFrame.new(V + Vector3.new(12, 8, -50)),
	})

	for i = 1, #CUBES do
		cube(folder, i)
		if i < #CUBES then
			bridge(folder, CUBES[i], CUBES[i + 1])
		end
	end

	-- 1 Entrance hall: lift, deed, dining table.
	local f1 = CUBES[1].f
	local liftDoor = box(folder, Vector3.new(2, f1, -3), Vector3.new(2.6, f1 + 9, 3), { Name = "LiftDoor", Material = Enum.Material.Metal, Color = C.Metal })
	for _, z in { -3.4, 3.4 } do
		box(folder, Vector3.new(2, f1, z - 0.2), Vector3.new(2.8, f1 + 9.4, z + 0.2), { Name = "LiftFrame", Material = Enum.Material.Neon, Color = C.Warm })
	end
	Furnish.dining(folder, CFrame.new(V + Vector3.new(13, f1, 2)))
	Furnish.deed(folder, CFrame.new(V + Vector3.new(18, f1, -7)), "vertebrae", "The Vertebrae")
	Furnish.plant(folder, V + Vector3.new(5, f1, 8))
	Furnish.note(folder, V + Vector3.new(13.5, f1 + 3, 2.6), "n6", -0.3)

	-- 2 Kitchen (pantry moved to the front-right so it can't block a doorway).
	local f2 = CUBES[2].f
	Furnish.kitchen(folder, CFrame.new(V + Vector3.new(48, f2, 0)), "vertebrae", {
		pantryA = Vector3.new(6.8, 0, -9.6),
		pantryB = Vector3.new(9.6, 10, -5),
	})

	-- 3 Fire room: a long slot fire in the back wall, sofa facing it.
	local f3 = CUBES[3].f
	Furnish.fireplace(folder, CFrame.new(V + Vector3.new(86, f3, 2)), "slot", "vertebrae")
	Furnish.lounge(folder, CFrame.new(V + Vector3.new(86, f3, -1)) * CFrame.Angles(0, math.pi, 0), 16)
	Furnish.plant(folder, V + Vector3.new(96, f3, -10))

	-- 4 Bedroom.
	local f4 = CUBES[4].f
	Furnish.bed(folder, CFrame.new(V + Vector3.new(124, f4, -3)), "vertebrae")
	Furnish.plant(folder, V + Vector3.new(116, f4, -9))

	-- 5 Bath and the glass lookout at the end of the spine.
	local f5 = CUBES[5].f
	Furnish.bath(folder, CFrame.new(V + Vector3.new(159, f5, 0)), "vertebrae")
	box(folder, Vector3.new(163, f5, -8.4), Vector3.new(167, f5 + 1.6, -4), { Name = "LookoutBench", Material = Enum.Material.Wood, Color = C.Wood })
	Furnish.note(folder, V + Vector3.new(165, f5 + 1.6, -6.2), "n7", 0.9)

	-- Ground level: platform, lift booth, pier, bell and boat.
	box(folder, Vector3.new(4, 3, -28), Vector3.new(20, 5, -12), concrete("Platform", C.ConcreteOut))
	local booth = box(folder, Vector3.new(8, 5, -12.6), Vector3.new(16, 15, -12), { Name = "LiftBooth", Material = Enum.Material.Metal, Color = C.Metal })
	box(folder, Vector3.new(8, 15, -16), Vector3.new(16, 16, -12), concrete("BoothRoof"))
	local lamp = box(folder, Vector3.new(10, 14.6, -15), Vector3.new(14, 14.9, -13), { Name = "BoothLight", Material = Enum.Material.Neon, Color = C.Warm })
	Build.surfaceLight(lamp, Enum.NormalId.Bottom, C.Warm, 14, 1.4)
	box(folder, Vector3.new(9, 3, -28), Vector3.new(15, 5, -80), concrete("Pier", C.ConcreteOut))
	for z = -34, -78, -14 do
		Build.cylinderY(folder, V + Vector3.new(10, -12, z), 32, 1.8, concrete("Pile", C.ConcreteDark))
		Build.cylinderY(folder, V + Vector3.new(14, -12, z), 32, 1.8, concrete("Pile", C.ConcreteDark))
	end
	Furnish.bell(folder, V + Vector3.new(10, 5, -76), "vertebrae", CFrame.new(V + Vector3.new(22, 1.2, -60)))
	Furnish.cubeLamp(folder, V + Vector3.new(14.2, 5.7, -78))

	Registry.misc.vertebraeLift = {
		bottom = booth,
		top = liftDoor,
		bottomArrive = CFrame.new(V + Vector3.new(12, 8, -20)) * CFrame.Angles(0, math.pi, 0),
		topArrive = CFrame.new(V + Vector3.new(6, f1 + 3, 0)) * CFrame.Angles(0, -math.pi / 2, 0),
	}
end

return Vertebrae
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000012">
          <Properties>
            <string name="Name">Well</string>
            <ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WELL: a concrete cylinder 80 studs across, sunk into a rock in the
-- east. Rooms ring the outside; in the middle, an open shaft with a still
-- black pool at the bottom and a single glowing cube hanging over it. A
-- spiral ramp climbs the shaft. The roof is open, so snow falls inside.

local Workspace = game:GetService("Workspace")

local Build = require(script.Parent.Parent.Build)
local Furnish = require(script.Parent.Parent.Furnish)
local Registry = require(script.Parent.Parent.Registry)

local Well = {}

local C = Build.Color
Well.ORIGIN = Vector3.new(650, 0, -480)
local W = Well.ORIGIN

local R_OUT = 40 -- outer face of the wall
local R_WALL = 38 -- inner face of the wall
local R_RING = 24 -- inner edge of the ring floors
local R_RAMP = 18 -- inner edge of the spiral ramp
local LEVELS = { 4, 24, 44 } -- top of each ring floor
local TOP = 66
local SEG = 48
local RAMP_START = math.rad(-75) -- the ramp starts (and arrives) at this angle

-- Position at angle a (radians) and radius r, at height y.
local function at(a: number, r: number, y: number): Vector3
	return W + Vector3.new(r * math.cos(a), y, r * math.sin(a))
end

-- A frame standing at (a, r) on level y, local -Z pointing at the shaft.
local function frameAt(a: number, r: number, y: number): CFrame
	local p = at(a, r, y)
	local centre = Vector3.new(W.X, p.Y, W.Z)
	return CFrame.lookAt(p, centre)
end

-- A ring of tangential slabs between radii r0..r1 and heights y0..y1.
local function ring(folder, r0: number, r1: number, y0: number, y1: number, props, skip: ((number) -> boolean)?)
	local mid = (r0 + r1) / 2
	local len = 2 * math.pi * r1 / SEG + 0.6
	for i = 0, SEG - 1 do
		local a = (i + 0.5) / SEG * 2 * math.pi
		if not (skip and skip(a)) then
			local p = table.clone(props)
			p.Size = Vector3.new(len, y1 - y0, r1 - r0)
			p.CFrame = CFrame.lookAt(at(a, mid, (y0 + y1) / 2), Vector3.new(W.X, W.Y + (y0 + y1) / 2, W.Z))
			Build.part(folder, p)
		end
	end
end

local function angleDiff(a: number, b: number): number
	local d = (a - b) % (2 * math.pi)
	if d > math.pi then
		d -= 2 * math.pi
	end
	return math.abs(d)
end

local function shell(folder)
	local concrete = { Name = "Wall", Material = Enum.Material.Concrete, Color = C.ConcreteOut }
	local door = math.rad(-90)
	for i = 0, SEG - 1 do
		local a = i / SEG * 2 * math.pi
		local window = i % 4 == 2
		local isDoor = angleDiff(a, door) < 0.01
		local len = 2 * math.pi * R_OUT / SEG + 0.6
		local function piece(y0: number, y1: number, props)
			local p = table.clone(props)
			p.Size = Vector3.new(len, y1 - y0, R_OUT - R_WALL)
			p.CFrame = CFrame.lookAt(at(a, (R_OUT + R_WALL) / 2, (y0 + y1) / 2), Vector3.new(W.X, (y0 + y1) / 2, W.Z))
			Build.part(folder, p)
		end
		if isDoor then
			piece(-24, LEVELS[1], concrete)
			piece(LEVELS[1] + 10, TOP, concrete)
		elseif window then
			piece(-24, LEVELS[1] + 4, concrete)
			piece(LEVELS[1] + 4, TOP - 6, {
				Name = "SlitWindow",
				Material = Enum.Material.Glass,
				Color = C.Glass,
				Transparency = 0.78,
				CastShadow = false,
			})
			piece(TOP - 6, TOP, concrete)
		else
			piece(-24, TOP, concrete)
		end
	end
	-- Ring floors and the roof ring (open oculus over the shaft).
	local floorProps = { Name = "RingFloor", Material = Enum.Material.Concrete, Color = C.Floor, Reflectance = 0.05 }
	ring(folder, R_RAMP, R_WALL, LEVELS[1] - 2, LEVELS[1], floorProps)
	ring(folder, R_RING, R_WALL, LEVELS[2] - 2, LEVELS[2], floorProps)
	ring(folder, R_RING, R_WALL, LEVELS[3] - 2, LEVELS[3], floorProps)
	ring(folder, R_RAMP, R_OUT, TOP - 2, TOP, { Name = "RoofRing", Material = Enum.Material.Concrete, Color = C.ConcreteOut })
	-- Glass balustrades along the ring edges, open where the ramp arrives.
	local railProps = { Name = "Balustrade", Material = Enum.Material.Glass, Color = C.Glass, Transparency = 0.65, CastShadow = false }
	for li = 2, 3 do
		local y = LEVELS[li]
		ring(folder, R_RING - 0.3, R_RING + 0.1, y, y + 3.4, railProps, function(a)
			local d = (a - RAMP_START) % (2 * math.pi)
			return d > 2 * math.pi - math.rad(32) -- the last stretch of ramp before it arrives
		end)
	end
	-- Warm light slots under each ring floor's ceiling, on the outer wall.
	for li = 1, 3 do
		local y = LEVELS[li] + 15
		ring(folder, R_WALL - 0.4, R_WALL, y, y + 0.3, { Name = "LightSlot", Material = Enum.Material.Neon, Color = C.Warm, CastShadow = false }, function(a)
			return math.floor(a / (2 * math.pi) * SEG) % 3 ~= 0
		end)
	end
	for li = 1, 3 do
		for k = 0, 5 do
			local a = k / 6 * 2 * math.pi + 0.3
			local holder = Build.part(folder, {
				Name = "RingLight",
				Size = Vector3.new(0.2, 0.2, 0.2),
				CFrame = CFrame.new(at(a, 33, LEVELS[li] + 14)),
				Transparency = 1,
				CanCollide = false,
			})
			Build.pointLight(holder, C.Warm, 24, 0.8)
		end
	end
end

local function spiral(folder)
	local turns = 2
	local steps = 36 * turns
	local rise = LEVELS[3] - LEVELS[1]
	local mid = (R_RAMP + R_RING) / 2
	local function p(k: number): Vector3
		local phi = k / steps * turns * 2 * math.pi
		return at(RAMP_START + phi, mid, LEVELS[1] + rise * k / steps - 0.55)
	end
	for k = 0, steps - 1 do
		local a, b = p(k), p(k + 1)
		local seg = Build.beam(folder, a, b, R_RING - R_RAMP, 1, { Name = "Ramp", Material = Enum.Material.Concrete, Color = C.Floor })
		seg.Size += Vector3.new(0.6, 0, 0.5)
		-- Inner glass balustrade over the shaft.
		local phiA = k / steps * turns * 2 * math.pi
		local phiB = (k + 1) / steps * turns * 2 * math.pi
		local ya = LEVELS[1] + rise * k / steps
		local yb = LEVELS[1] + rise * (k + 1) / steps
		Build.beam(folder, at(RAMP_START + phiA, R_RAMP + 0.2, ya + 1.7), at(RAMP_START + phiB, R_RAMP + 0.2, yb + 1.7), 0.3, 3.4, {
			Name = "RampRail",
			Material = Enum.Material.Glass,
			Color = C.Glass,
			Transparency = 0.65,
			CastShadow = false,
		})
	end
end

function Well.build(root: Instance)
	local folder = Build.folder(root, "TheWell")
	local doorA = math.rad(-90)
	Registry.addHome({
		id = "well",
		name = "The Well",
		center = W + Vector3.new(0, 30, 0),
		spawn = CFrame.lookAt(at(doorA, 32, LEVELS[1] + 3), at(doorA, 0, LEVELS[1] + 3)),
		dock = CFrame.new(W + Vector3.new(0, 8, -92)),
	})

	-- Rock island; a dark pool in the middle of the shaft.
	local terrain = Workspace.Terrain
	terrain:FillCylinder(CFrame.new(W + Vector3.new(0, -18, 0)), 42, 72, Enum.Material.Basalt)
	terrain:FillCylinder(CFrame.new(W + Vector3.new(0, 1, 0)), 4, R_RAMP - 1, Enum.Material.Water)
	for k = 0, 5 do
		local a = k / 6 * 2 * math.pi + 0.5
		terrain:FillBall(at(a, 56, 1), 9, Enum.Material.Snow)
	end
	shell(folder)
	spiral(folder)

	-- The hanging cube of light, held by a beam across the oculus.
	Build.box(folder, W + Vector3.new(-R_OUT, TOP - 1.5, -1), W + Vector3.new(R_OUT, TOP + 0.5, 1), { Name = "Crossbeam", Material = Enum.Material.Concrete, Color = C.ConcreteOut })
	Build.cylinderY(folder, W + Vector3.new(0, (TOP - 1.5 + 36) / 2, 0), TOP - 1.5 - 36, 0.15, { Name = "Cable", Color = C.Metal, CanCollide = false })
	local cubeLight = Build.box(folder, W + Vector3.new(-2.5, 31, -2.5), W + Vector3.new(2.5, 36, 2.5), {
		Name = "LightCube",
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 214, 160),
	})
	Build.pointLight(cubeLight, C.Warm, 48, 1.6)
	Build.box(folder, W + Vector3.new(-R_RAMP, LEVELS[1] - 2.5, -R_RAMP), W + Vector3.new(R_RAMP, -1.5, R_RAMP), {
		Name = "PoolFloor",
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(14, 16, 20),
	})

	-- Ground ring: entrance, deed, kitchen, dining.
	local l1 = LEVELS[1]
	Furnish.deed(folder, frameAt(math.rad(-106), 33, l1), "well", "The Well")
	-- Pantry tucked beside the counter so it stays clear of the spiral ramp.
	Furnish.kitchen(folder, frameAt(math.rad(90), 28, l1), "well", {
		pantryA = Vector3.new(-9.6, 0, 1),
		pantryB = Vector3.new(-6.8, 10, 5.5),
	})
	Furnish.dining(folder, frameAt(math.rad(180), 31, l1))
	Furnish.plant(folder, at(math.rad(-70), 35, l1))
	Furnish.plant(folder, at(math.rad(140), 35, l1))
	Furnish.note(folder, at(math.rad(180), 31, l1 + 3), "n8", 0.5)

	-- Fire ring.
	local l2 = LEVELS[2]
	local fireFrame = frameAt(0, 34, l2)
	Furnish.fireplace(folder, fireFrame, "column", "well")
	-- Sofa on the shaft side of the fire, facing out toward it.
	Furnish.lounge(folder, CFrame.lookAt(fireFrame.Position, fireFrame.Position + (fireFrame.Position - Vector3.new(W.X, fireFrame.Position.Y, W.Z))), 12)
	Furnish.bookshelf(folder, frameAt(math.rad(50), 36.4, l2))
	Furnish.plant(folder, at(math.rad(-40), 35, l2))
	Furnish.plant(folder, at(math.rad(150), 35, l2))

	-- Sleeping ring.
	local l3 = LEVELS[3]
	Furnish.bed(folder, frameAt(math.rad(90), 25, l3), "well")
	Furnish.bath(folder, frameAt(math.rad(-150), 27, l3), "well")
	Furnish.plant(folder, at(math.rad(20), 35, l3))
	Furnish.note(folder, at(math.rad(-30), 34, l3), "n9", 1.4)

	-- Pier, bell and boat outside the door.
	Build.box(folder, W + Vector3.new(-5, 3, -66), W + Vector3.new(5, 5, -112), { Name = "Pier", Material = Enum.Material.Concrete, Color = C.ConcreteOut })
	Build.box(folder, W + Vector3.new(-5, 3, -R_OUT - 1), W + Vector3.new(5, LEVELS[1], -66), { Name = "Path", Material = Enum.Material.Concrete, Color = C.ConcreteOut })
	for z = -74, -110, -12 do
		Build.cylinderY(folder, W + Vector3.new(-4, -12, z), 32, 1.8, { Name = "Pile", Material = Enum.Material.Concrete, Color = C.ConcreteDark })
		Build.cylinderY(folder, W + Vector3.new(4, -12, z), 32, 1.8, { Name = "Pile", Material = Enum.Material.Concrete, Color = C.ConcreteDark })
	end
	Furnish.bell(folder, W + Vector3.new(-3.5, 5, -108), "well", CFrame.new(W + Vector3.new(11, 1.2, -95)))
	Furnish.cubeLamp(folder, W + Vector3.new(3.8, 5.7, -110))

	Registry.addInteriorTest("well", "The Well", function(pos: Vector3): boolean
		local d = Vector3.new(pos.X - W.X, 0, pos.Z - W.Z).Magnitude
		return d < R_WALL and pos.Y > -2 and pos.Y < TOP
	end)
end

-- Room name for the HUD.
function Well.roomName(pos: Vector3): string
	if pos.Y < LEVELS[2] - 1 then
		return "The Well · Ground Ring"
	elseif pos.Y < LEVELS[3] - 1 then
		return "The Well · Fire Ring"
	end
	return "The Well · Sleeping Ring"
end

return Well
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX00000013">
        <Properties>
          <string name="Name">Lore</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- The architect's mystery. Ten notes are hidden across the four homes. One of
-- them gives the tuning of the ribs; playing it on the rib organ unseals a
-- hatch under the arch. The hatch can only be reached when the sea freezes at
-- night. Below it is the Sternum, a vault with the architect's last note.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Build = require(script.Parent.Build)
local Furnish = require(script.Parent.Furnish)
local Registry = require(script.Parent.Registry)

local Lore = {}

local C = Build.Color
local HATCH_POS = Vector3.new(0, 0, -60)
local VAULT = Vector3.new(0, -200, -60) -- floor centre of the Sternum

local hooks
local hatch: BasePart
local hatchPrompt: ProximityPrompt

local noteById = {}
for _, n in Config.NOTES do
	noteById[n.id] = n
end

----------------------------------------------------------------------------
-- Building
----------------------------------------------------------------------------

local function miniModel(folder: Instance, top: Vector3)
	local s = 1 / 160 -- the whole sea, shrunk onto a 10-stud plinth
	local props = { Material = Enum.Material.Concrete, Color = C.ConcreteOut, CanCollide = false }
	-- The Ribcage arch, in miniature.
	local prev
	for i = 0, 16 do
		local t = math.pi * i / 16
		local p = top + Vector3.new(280 * math.cos(t) * s, 220 * math.sin(t) * s, 0)
		if prev then
			Build.beam(folder, prev, p, 0.25, 0.2, props)
		end
		prev = p
	end
	-- The Monolith, the Vertebrae and the Well, at their real bearings.
	Build.box(folder, top + Vector3.new(40, 0, 700) * s + Vector3.new(-0.3, 0, -0.15), top + Vector3.new(40, 0, 700) * s + Vector3.new(0.3, 2, 0.15), props)
	for k = 0, 4 do
		local base = top + Vector3.new(-700 + 36 * k, 0, -420) * s
		Build.box(folder, base + Vector3.new(-0.1, 0.1 + 0.05 * k, -0.1), base + Vector3.new(0.1, 0.3 + 0.05 * k, 0.1), props)
	end
	local well = top + Vector3.new(650, 0, -480) * s
	Build.cylinderY(folder, well + Vector3.new(0, 0.3, 0), 0.6, 0.7, props)
end

local function buildVault(root: Instance)
	local folder = Build.folder(root, "TheSternum")
	local function box(a: Vector3, b: Vector3, props)
		return Build.box(folder, VAULT + a, VAULT + b, props)
	end
	local concrete = { Name = "Vault", Material = Enum.Material.Concrete, Color = C.ConcreteIn }
	box(Vector3.new(-30, -2, -14), Vector3.new(30, 0, 14), { Name = "VaultFloor", Material = Enum.Material.Concrete, Color = C.Floor, Reflectance = 0.08 })
	box(Vector3.new(-30, 20, -14), Vector3.new(30, 22, 14), concrete)
	box(Vector3.new(-32, -2, -14), Vector3.new(-30, 22, 14), concrete)
	box(Vector3.new(30, -2, -14), Vector3.new(32, 22, 14), concrete)
	box(Vector3.new(-32, -2, -16), Vector3.new(32, 22, -14), concrete)
	box(Vector3.new(-32, -2, 14), Vector3.new(32, 22, 16), concrete)
	-- Ribbed ceiling: concrete fins, like the inside of the chest.
	for x = -26, 26, 4 do
		box(Vector3.new(x - 0.4, 15, -14), Vector3.new(x + 0.4, 20, 14), concrete)
	end
	for _, z in { -13.6, 13.6 } do
		Furnish.lightSlot(folder, VAULT + Vector3.new(-28, 0.2, z - 0.2), VAULT + Vector3.new(28, 0.5, z + 0.2), Enum.NormalId.Top, 20)
	end
	-- Plinth with the scale model and the final note.
	box(Vector3.new(-5, 0, -5), Vector3.new(5, 3.4, 5), { Name = "Plinth", Material = Enum.Material.Marble, Color = C.Marble })
	miniModel(folder, VAULT + Vector3.new(0, 3.4, 0))
	local glow = Build.part(folder, {
		Name = "ModelLight",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(VAULT + Vector3.new(0, 10, 0)),
		Transparency = 1,
		CanCollide = false,
	})
	Build.pointLight(glow, C.Warm, 24, 1.2)
	Furnish.note(folder, VAULT + Vector3.new(3.6, 3.4, 3.6), "final", 0.6)
	-- The way back up.
	local exit = box(Vector3.new(-29.6, 0, -3), Vector3.new(-29, 11, 3), { Name = "VaultExit", Material = Enum.Material.Metal, Color = C.Metal })
	for _, z in { -3.4, 3.4 } do
		box(Vector3.new(-29.6, 0, z - 0.2), Vector3.new(-28.8, 11.4, z + 0.2), { Name = "ExitFrame", Material = Enum.Material.Neon, Color = C.Warm })
	end
	Registry.addInterior("sternum", "The Sternum", VAULT + Vector3.new(-30, -1, -14), VAULT + Vector3.new(30, 20, 14))
	return exit
end

local function buildHatch(root: Instance)
	local folder = Build.folder(root, "Hatch")
	-- A dark ring just under the surface: visible as a shadow in daytime.
	Build.part(folder, {
		Name = "SunkenRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 12, 12),
		CFrame = CFrame.new(HATCH_POS + Vector3.new(0, -3, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(30, 32, 34),
	})
	hatch = Build.part(folder, {
		Name = "IceHatch",
		Size = Vector3.new(7, 0.3, 7),
		CFrame = CFrame.new(HATCH_POS + Vector3.new(0, 0.55, 0)),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(48, 50, 52),
		Transparency = 1,
		CanCollide = false,
	})
	local light = Build.pointLight(hatch, C.Warm, 14, 0)
	light.Name = "HatchGlow"
	hatchPrompt = Build.prompt(hatch, "Open the hatch", "Sealed hatch", 1, 10)
	hatchPrompt.Enabled = false
end

function Lore.build(root: Instance)
	buildHatch(root)
	Registry.misc.vaultExit = buildVault(root)
end

----------------------------------------------------------------------------
-- Gameplay
----------------------------------------------------------------------------

-- Called by the day cycle when the sea freezes or thaws.
function Lore.setFrozen(frozen: boolean)
	if not hatch then
		return
	end
	hatch.Transparency = frozen and 0 or 1
	hatch.CanCollide = frozen
	hatchPrompt.Enabled = frozen
	local glow = hatch:FindFirstChild("HatchGlow")
	if glow then
		glow.Brightness = frozen and 1.2 or 0
	end
end

local function noteCount(profile): number
	local n = 0
	for id in profile.notes do
		if id ~= "final" then
			n += 1
		end
	end
	return n
end

local function readNote(player: Player, id: string)
	local profile = hooks.profile(player)
	local note = noteById[id]
	if not profile or not note then
		return
	end
	hooks.openPanel(player, "note", id)
	if profile.notes[id] then
		return
	end
	profile.notes[id] = true
	hooks.syncNotes(player)
	if id == "final" then
		hooks.addCredits(player, 300)
		profile.title = "Keeper of the Ice"
		hooks.refreshTitle(player)
		hooks.discover(player, "sternum")
		hooks.notify(player, "You are the Keeper of the Ice now. (+300 credits)", "discovery")
		return
	end
	hooks.addCredits(player, 15)
	local count = noteCount(profile)
	hooks.notify(player, string.format("Architect's note %d of %d found (+15).", count, #Config.NOTES - 1), "discovery")
	if count == #Config.NOTES - 1 then
		hooks.notify(player, "You've found every note. Read the tuning again, and find the floor of glass.", "discovery")
	end
end

function Lore.start(builtHooks, remotes)
	hooks = builtHooks
	for _, n in Registry.notes do
		local p = Build.prompt(n.part, "Read", "A folded note", 0, 8)
		p.Triggered:Connect(function(player)
			readNote(player, n.id)
		end)
	end

	-- The rib organ: the client plays it; the server checks the melody.
	remotes.Organ.OnServerEvent:Connect(function(player, sequence)
		if type(sequence) ~= "table" or #sequence ~= #Config.MELODY then
			return
		end
		for i, key in Config.MELODY do
			if sequence[i] ~= key then
				return
			end
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local organ = Registry.misc.organPanel
		if not hrp or not organ or (hrp.Position - organ.Position).Magnitude > 24 then
			return
		end
		local profile = hooks.profile(player)
		if not profile or profile.flags.melody then
			return
		end
		profile.flags.melody = true
		hooks.discover(player, "melody")
		hooks.notify(player, "Every rib answers at once. Far below the arch, something heavy unlocks.", "discovery")
		remotes.Organ:FireAllClients("solved")
	end)

	hatchPrompt.Triggered:Connect(function(player)
		local profile = hooks.profile(player)
		if not profile then
			return
		end
		if not profile.flags.melody then
			hooks.notify(player, "Sealed. Cold metal, and seven grooves cut into it like the keys of an instrument.", "warn")
			return
		end
		hooks.teleport(player, CFrame.new(VAULT + Vector3.new(-24, 3, 0)) * CFrame.Angles(0, -math.pi / 2, 0))
		hooks.notify(player, "You climb down a long ladder into the dark under the arch...")
	end)

	local exitPrompt = Build.prompt(Registry.misc.vaultExit, "Climb back up", "Ladder shaft", 0.5, 10)
	exitPrompt.Triggered:Connect(function(player)
		if Workspace:GetAttribute("Frozen") then
			hooks.teleport(player, CFrame.new(HATCH_POS + Vector3.new(6, 4, 0)))
		else
			hooks.teleport(player, Registry.homes.ribcage.dock)
		end
	end)
end

return Lore
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000014">
        <Properties>
          <string name="Name">Mansion</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the Ribcage Mansion itself: the concrete spine arch, the hanging ribs
-- and the furnished glass gallery inside the crown.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)
local Furnish = require(script.Parent.Furnish)
local Registry = require(script.Parent.Registry)
local Arch = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Arch"))

local Mansion = {}

local C = Build.Color
local A, W, T = Arch.A, Arch.W, Arch.T
local GZ, BZ = Arch.GLASS_Z, Arch.BACK_Z
local STEP_RUN = 1.25
local STEP_RISE = 0.8

local function isGlassFloorX(x: number): boolean
	for _, room in Arch.ROOMS do
		if room.glassFloor and x >= room.x0 and x <= room.x1 then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------------
-- The spine
----------------------------------------------------------------------------

local function concreteColor(y: number): Color3
	-- Darker, wet-stained concrete near the waterline, like the video.
	local k = math.clamp((y - 5) / 45, 0, 1)
	return C.ConcreteDark:Lerp(C.ConcreteOut, k)
end

local function buildSpine(folder: Instance)
	local N = Arch.SEGMENTS
	for i = 0, N - 1 do
		local t1 = math.pi * i / N
		local t2 = math.pi * (i + 1) / N
		local p1, p2 = Arch.point(t1), Arch.point(t2)
		local mid = (p1 + p2) / 2
		local tangent = (p2 - p1).Unit
		local len = (p2 - p1).Magnitude + 1.2
		local normal = Vector3.new(tangent.Y, -tangent.X, 0)
		-- Local X = world Z (spine width), local Y = outward normal, local Z = along the curve.
		local cf = CFrame.fromMatrix(mid, Vector3.zAxis, normal)

		if math.abs(mid.X) < Arch.HABITAT_HALF then
			local glassFloor = isGlassFloorX(mid.X)
			Build.part(folder, {
				Name = "FloorSlab",
				Size = Vector3.new(W, Arch.SLAB, len),
				CFrame = cf * CFrame.new(0, -T / 2 + Arch.SLAB / 2, 0),
				Material = glassFloor and Enum.Material.Glass or Enum.Material.Concrete,
				Color = glassFloor and C.Glass or C.ConcreteOut,
				Transparency = glassFloor and 0.55 or 0,
			})
			Build.part(folder, {
				Name = "RoofSlab",
				Size = Vector3.new(W, Arch.SLAB, len),
				CFrame = cf * CFrame.new(0, T / 2 - Arch.SLAB / 2, 0),
				Material = Enum.Material.Concrete,
				Color = C.ConcreteOut,
			})
			Build.part(folder, {
				Name = "BackWall",
				Size = Vector3.new(2, T - 2 * Arch.SLAB, len),
				CFrame = cf * CFrame.new(W / 2 - 1, 0, 0),
				Material = Enum.Material.Concrete,
				Color = C.ConcreteIn,
			})
			Build.part(folder, {
				Name = "Glass",
				Size = Vector3.new(0.6, T - 2 * Arch.SLAB, len),
				CFrame = cf * CFrame.new(-W / 2 + 0.3, 0, 0),
				Material = Enum.Material.Glass,
				Color = C.Glass,
				Transparency = 0.82,
				CastShadow = false,
			})
			if i % 2 == 0 then
				Build.part(folder, {
					Name = "Mullion",
					Size = Vector3.new(0.8, T - 2 * Arch.SLAB, 0.3),
					CFrame = cf * CFrame.new(-W / 2 + 0.4, 0, len / 2 - 0.6),
					Material = Enum.Material.Metal,
					Color = C.Metal,
				})
			end
		else
			Build.part(folder, {
				Name = "Spine",
				Size = Vector3.new(W, T, len),
				CFrame = cf,
				Material = Enum.Material.Concrete,
				Color = concreteColor(mid.Y),
			})
		end
	end

	-- Legs continue down into the sea.
	for _, side in { -1, 1 } do
		Build.part(folder, {
			Name = "Footing",
			Size = Vector3.new(T, 46, W),
			CFrame = CFrame.new(side * A, -22, 0),
			Material = Enum.Material.Concrete,
			Color = C.ConcreteDark,
		})
	end
end

----------------------------------------------------------------------------
-- The ribs
----------------------------------------------------------------------------

local function ribShape(t: number)
	local attach = Arch.point(t) + Arch.normal(t) * (T / 2 - 3) + Vector3.new(0, 0, -W / 2 + 3)
	local s = math.sin(t)
	local down = attach.Y * 0.58
	local out = 18 + 78 * s ^ 1.3
	return attach, down, out
end

local function buildRibs(folder: Instance)
	local template = Build.asset("Rib")
	for i = 0, Arch.RIB_COUNT - 1 do
		local t = Arch.RIB_T_MIN + (Arch.RIB_T_MAX - Arch.RIB_T_MIN) * i / (Arch.RIB_COUNT - 1)
		local attach, down, out = ribShape(t)
		-- Each rib is its own model so the rib organ can light it up.
		local ribModel = Instance.new("Model")
		ribModel.Name = string.format("Rib%02d", i + 1)
		ribModel:SetAttribute("RibIndex", i + 1)
		ribModel.Parent = folder
		if template then
			-- Blender rib: a quarter-curve normalised to a unit box, root at the
			-- top +Z corner and tip at the bottom -Z corner (see blender/README).
			local center = attach + Vector3.new(0, -down / 2, -out / 2)
			Build.placeAsset(template, ribModel, CFrame.new(center), Vector3.new(6, down, out), {
				Material = Enum.Material.Concrete,
				Color = C.ConcreteOut,
			})
		else
			local SEG = 14
			local prev = attach
			for k = 1, SEG do
				local u = k / SEG
				local a = u * math.pi / 2
				local p = attach + Vector3.new(0, -down * (1 - math.cos(a)), -out * math.sin(a))
				local taper = 1 - (k - 1) / SEG
				local w = 1 + 5.5 * taper
				local d = 1.4 + 7.5 * taper
				local seg = Build.beam(ribModel, prev, p, w, d, {
					Name = "Rib",
					Material = Enum.Material.Concrete,
					Color = C.ConcreteOut,
				}, Vector3.xAxis)
				-- Overlap the joints a little so the curve looks continuous.
				seg.Size += Vector3.new(0, 0, 1)
				prev = p
			end
		end
	end
end

----------------------------------------------------------------------------
-- Rooms
----------------------------------------------------------------------------

local function floorPart(folder: Instance, x0: number, x1: number, z0: number, z1: number, top: number, bottom: number, glass: boolean?)
	return Build.box(folder, Vector3.new(x0, bottom, z0), Vector3.new(x1, top, z1), {
		Name = glass and "GlassFloor" or "Floor",
		Material = glass and Enum.Material.Glass or Enum.Material.Concrete,
		Color = glass and C.Glass or C.Floor,
		Transparency = glass and 0.5 or 0,
		Reflectance = glass and 0 or 0.06,
	})
end

local function seat(folder: Instance, pos: Vector3, look: Vector3, size: Vector3?, color: Color3?)
	return Build.part(folder, {
		ClassName = "Seat",
		Name = "Seat",
		Size = size or Vector3.new(3.6, 1, 3.6),
		CFrame = CFrame.lookAt(pos, pos + look),
		Material = Enum.Material.Fabric,
		Color = color or C.Fabric,
	})
end

local function paperLamp(folder: Instance, base: Vector3, height: number, refs)
	local shade = Build.cylinderY(folder, base + Vector3.new(0, height / 2, 0), height, 1.8, {
		Name = "PaperLamp",
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 226, 180),
		Transparency = 0.05,
	})
	local light = Build.pointLight(shade, C.Warm, 22, 1.4)
	table.insert(refs.lamps, { part = shade, light = light })
	return shade
end

local function cubeLamp(folder: Instance, pos: Vector3, refs)
	local cube = Build.part(folder, {
		Name = "CubeLamp",
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = CFrame.new(pos),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 220, 170),
	})
	local light = Build.pointLight(cube, C.Warm, 14, 1.2)
	table.insert(refs.lamps, { part = cube, light = light })
	return cube
end

local function surface(refs, x0: number, x1: number, z0: number, z1: number, top: number)
	table.insert(refs.catSurfaces, { x0 = math.min(x0, x1), x1 = math.max(x0, x1), z0 = math.min(z0, z1), z1 = math.max(z0, z1), top = top })
end

local function plant(folder: Instance, base: Vector3, refs)
	local pot = Build.cylinderY(folder, base + Vector3.new(0, 1.2, 0), 2.4, 2.2, {
		Name = "PlantPot",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteIn,
	})
	local leaves = Instance.new("Model")
	leaves.Name = "Leaves"
	local rng = Random.new(math.floor(base.X * 7 + base.Z))
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		Build.ellipsoid(leaves, CFrame.new(base + Vector3.new(math.cos(a) * 0.9, 3.2 + rng:NextNumber(0, 1.6), math.sin(a) * 0.9))
			* CFrame.Angles(math.sin(a) * 0.6, a, math.cos(a) * 0.6), Vector3.new(0.9, 0.25, 2.6), {
			Name = "Leaf",
			Color = Color3.fromRGB(58, 92, 60),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	leaves.Parent = folder
	table.insert(refs.plants, { pot = pot, leaves = leaves })
end

local function wallStrip(folder: Instance, room, floorY: number)
	local farX = math.abs(room.x0) > math.abs(room.x1) and room.x0 or room.x1
	local y = math.min(floorY + 13, Arch.ceilingAt(farX) - 1.2)
	local strip = Build.box(folder, Vector3.new(room.x0 + 1, y, BZ - 0.4), Vector3.new(room.x1 - 1, y + 0.3, BZ), {
		Name = "LightSlot",
		Material = Enum.Material.Neon,
		Color = C.Warm,
		CastShadow = false,
	})
	Build.surfaceLight(strip, Enum.NormalId.Bottom, C.Warm, 18, 0.9, 70)
end

local function steps(folder: Instance, boundary: number, leftY: number, rightY: number)
	local d = math.abs(leftY - rightY)
	if d < 0.35 then
		return
	end
	local n = math.ceil(d / STEP_RISE)
	local rise = d / n
	local high = math.max(leftY, rightY)
	local low = math.min(leftY, rightY)
	local dir = rightY < leftY and 1 or -1 -- steps go into the lower room
	for k = 1, n - 1 do
		local xa = boundary + dir * (k - 1) * STEP_RUN
		local xb = boundary + dir * k * STEP_RUN
		Build.box(folder, Vector3.new(xa, low - 1, GZ), Vector3.new(xb, high - k * rise, BZ), {
			Name = "Step",
			Material = Enum.Material.Concrete,
			Color = C.Floor,
			Reflectance = 0.05,
		})
	end
end

local DOOR_Z0, DOOR_Z1, DOOR_H = 5, 13, 10

local function partition(folder: Instance, boundary: number, leftY: number, rightY: number, hingeZ: number, refs)
	local low = math.min(leftY, rightY)
	local high = math.max(leftY, rightY)
	local top = Arch.ceilingAt(boundary) + 1
	local props = { Name = "Partition", Material = Enum.Material.Concrete, Color = C.ConcreteIn }
	Build.box(folder, Vector3.new(boundary - 0.5, low - 1, GZ), Vector3.new(boundary + 0.5, top, DOOR_Z0), props)
	Build.box(folder, Vector3.new(boundary - 0.5, low - 1, DOOR_Z1), Vector3.new(boundary + 0.5, top, BZ), props)
	Build.box(folder, Vector3.new(boundary - 0.5, high + DOOR_H, DOOR_Z0), Vector3.new(boundary + 0.5, top, DOOR_Z1), props)

	-- A tall timber door that swings into the higher room.
	local dir = hingeZ == DOOR_Z0 and 1 or -1
	local hinge = CFrame.new(boundary, high + DOOR_H / 2, hingeZ)
	local closed = hinge * CFrame.new(0, 0, dir * 4)
	local swingSign = rightY < leftY and 1 or -1 -- open toward the higher (left) room
	local open = hinge * CFrame.Angles(0, -dir * swingSign * math.pi / 2, 0) * CFrame.new(0, 0, dir * 4)
	local door = Build.part(folder, {
		Name = "Door",
		Size = Vector3.new(0.6, DOOR_H, 8),
		CFrame = closed,
		Material = Enum.Material.Wood,
		Color = C.Wood,
	})
	Build.part(door, {
		Name = "Handle",
		Size = Vector3.new(1.2, 0.3, 0.3),
		CFrame = closed * CFrame.new(0, 0, dir * 3.2),
		Material = Enum.Material.Metal,
		Color = C.Metal,
		CanCollide = false,
	})
	table.insert(refs.doors, { part = door, closed = closed, open = open })
end

local function roomFurniture(folder: Instance, room, L: number, refs)
	local id = room.id
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x, L + y, z)
	end

	if id == "station" then
		-- Funicular doors set into the west end.
		local door = Build.box(folder, v(-111.6, 0, -6), v(-110.8, 11, 6), {
			Name = "FunicularDoor",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		for _, z in { -6.4, 6.4 } do
			Build.box(folder, v(-111.4, 0, z - 0.2), v(-110.6, 11.4, z + 0.2), {
				Name = "DoorFrameLight",
				Material = Enum.Material.Neon,
				Color = C.Warm,
			})
		end
		refs.funicularTop = door
		refs.funicularTopArrive = CFrame.new(v(-105, 3, 0)) * CFrame.Angles(0, -math.pi / 2, 0)

		-- Bench along the glass and a parka rack on the back wall.
		surface(refs, -108, -101, -16.6, -13.6, L + 1.8)
		refs.catSpots.window = v(-104, 1.8, -15)
		Furnish.note(folder, v(-102.4, 1.8, -15.2), "n1", 0.3)
		refs.deedFrame = CFrame.new(v(-99, 0, -6)) * CFrame.Angles(0, math.pi / 2, 0)
		plant(folder, v(-98, 0, 14), refs)
		Build.box(folder, v(-108, 0, -16.6), v(-101, 1.8, -13.6), {
			Name = "Bench",
			Material = Enum.Material.Wood,
			Color = C.Wood,
		})
		local rack = Build.box(folder, v(-108, 7, 15.2), v(-101, 7.4, 15.6), {
			Name = "ParkaRack",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		local parkaColors = { Color3.fromRGB(190, 70, 40), Color3.fromRGB(230, 230, 225), Color3.fromRGB(40, 50, 60) }
		for i, col in parkaColors do
			Build.box(folder, v(-107.5 + i * 1.8, 2.6, 14.4), v(-106.3 + i * 1.8, 7, 15.4), {
				Name = "Parka",
				Material = Enum.Material.Fabric,
				Color = col,
			})
		end
		refs.parkaRack = rack

		-- A climbable steel truss up to the roof hatch.
		local ceil = Arch.ceilingAt(-104)
		local trussHeight = 2 * math.floor((ceil - L) / 2)
		local truss = Instance.new("TrussPart")
		truss.Name = "HatchLadder"
		truss.Size = Vector3.new(2, trussHeight, 2)
		truss.CFrame = CFrame.new(-104, L + trussHeight / 2, 11)
		truss.Anchored = true
		truss.Material = Enum.Material.Metal
		truss.Color = C.Metal
		truss.Parent = folder
		local hatch = Build.box(folder, Vector3.new(-106, ceil - 0.4, 8.5), Vector3.new(-102, ceil, 13.5), {
			Name = "RoofHatch",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		refs.hatch = hatch
		local roofX = -100
		refs.roofArrive = CFrame.new(roofX, Arch.yAt(roofX) + T / 2 * math.sqrt(1 + Arch.slope(roofX) ^ 2) + 4, 4)
	elseif id == "lounge" then
		for _, x in { -80, -73 } do
			Build.box(folder, v(x - 2, 0, -15), v(x + 2, 0.8, -8), {
				Name = "ChaiseBase",
				Material = Enum.Material.Wood,
				Color = C.Wood,
			})
			seat(folder, v(x, 1.3, -11.5), -Vector3.zAxis, Vector3.new(3.8, 1, 6.8))
			Build.box(folder, v(x - 2, 0.8, -9), v(x + 2, 3.6, -8), {
				Name = "ChaiseBack",
				Material = Enum.Material.Fabric,
				Color = C.Fabric,
			})
		end
		Build.box(folder, v(-77.8, 0, -7), v(-75.2, 2.6, -4.4), {
			Name = "SideTable",
			Material = Enum.Material.Marble,
			Color = C.Marble,
		})
		Build.ellipsoid(folder, CFrame.new(v(-76.5, 3.1, -5.7)), Vector3.new(1.6, 1, 1.6), {
			Name = "Bowl",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(60, 50, 44),
		})
		-- Glass of red wine.
		Build.cylinderY(folder, v(-75.9, 3.2, -4.9), 1.2, 0.18, { Name = "WineStem", Material = Enum.Material.Glass, Transparency = 0.5, CanCollide = false })
		Build.cylinderY(folder, v(-75.9, 3.9, -4.9), 0.5, 0.6, { Name = "Wine", Color = Color3.fromRGB(90, 10, 20), CanCollide = false })
		paperLamp(folder, v(-84, 0, 14), 6, refs)
		refs.glassFloorCenter = v(-76, 0, -4)
		refs.catSpots.glassfloor = v(-68, 0, -4)

		-- The rib organ: seven brass keys, one for each group of ribs outside.
		Build.box(folder, v(-80, 0, 13.4), v(-71, 3.4, BZ), { Name = "OrganConsole", Material = Enum.Material.Concrete, Color = C.ConcreteIn })
		local panel = Build.box(folder, v(-79.6, 3.4, 13.6), v(-71.4, 3.5, 15.8), {
			Name = "OrganPanel",
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(30, 26, 22),
		})
		CollectionService:AddTag(panel, "RibOrgan")
		Registry.misc.organPanel = panel
		for k = 0, 6 do
			local h = 6 + k * 1.4
			Build.cylinderY(folder, v(-79 + k * 1.2, 3.4 + h / 2, 15.6), h, 0.7, {
				Name = "OrganPipe",
				Material = Enum.Material.Metal,
				Color = Color3.fromRGB(176, 140, 82),
				CanCollide = false,
			})
		end
		surface(refs, -82, -71, -15, -8, L + 1.8)
		plant(folder, v(-83, 0, 4), refs)
	elseif id == "pool" then
		refs.poolRoom = room
		local wMin, wMax = Arch.poolWater()
		refs.poolMin, refs.poolMax = wMin, wMax
		local rimTop = wMax.Y + 0.3
		local rim = { Name = "PoolRim", Material = Enum.Material.Concrete, Color = C.ConcreteIn }
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, wMax.Z), Vector3.new(wMax.X + 1, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, GZ), Vector3.new(wMax.X + 1, rimTop, wMin.Z), rim)
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, GZ), Vector3.new(wMin.X, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMax.X, wMin.Y, GZ), Vector3.new(wMax.X + 1, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMin.X, wMin.Y - 1, wMin.Z), Vector3.new(wMax.X, wMin.Y, wMax.Z), {
			Name = "PoolBottom",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(26, 30, 34),
		})
		-- Underwater glow.
		local glow = Build.box(folder, Vector3.new(wMin.X + 1, wMin.Y, wMax.Z + 0.6), Vector3.new(wMax.X - 1, wMin.Y + 0.3, wMax.Z + 0.8), {
			Name = "PoolLight",
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(150, 200, 255),
			Transparency = 0.3,
		})
		Build.surfaceLight(glow, Enum.NormalId.Front, Color3.fromRGB(150, 200, 255), 12, 0.8)
		-- Towels on a bench.
		Build.box(folder, v(-40, 0, 13), v(-30, 1.6, 15.6), { Name = "Bench", Material = Enum.Material.Wood, Color = C.Wood })
		Build.box(folder, v(-38, 1.6, 13.4), v(-35, 2.2, 15.2), { Name = "Towels", Material = Enum.Material.Fabric, Color = Color3.fromRGB(80, 74, 70) })
		Furnish.note(folder, v(-32.5, 1.6, 14.3), "n10", -0.2)
	elseif id == "gallery" then
		-- Long low sofa with its back to the glass.
		Build.box(folder, v(-10, 0, -17.2), v(22, 1.2, -10.6), { Name = "SofaPlinth", Material = Enum.Material.Wood, Color = C.Wood })
		Build.box(folder, v(-10, 1.2, -17.2), v(22, 4.4, -15.6), { Name = "SofaBack", Material = Enum.Material.Fabric, Color = C.Fabric })
		for x = -8, 20, 4 do
			seat(folder, v(x, 1.7, -13), Vector3.zAxis, Vector3.new(3.9, 1, 4.6))
		end
		-- Black marble coffee table and a stone bowl.
		Build.box(folder, v(0, 0, -9), v(10, 2.4, -3), { Name = "CoffeeTable", Material = Enum.Material.Marble, Color = C.Marble })
		Build.ellipsoid(folder, CFrame.new(v(3, 2.9, -6)), Vector3.new(2, 1.2, 2), {
			Name = "Bowl",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(70, 58, 50),
		})
		Build.box(folder, v(-6, 0.01, -9.5), v(14, 0.1, 2), { Name = "Rug", Material = Enum.Material.Fabric, Color = Color3.fromRGB(58, 52, 48), CanCollide = false })
		-- Paper floor lamps.
		paperLamp(folder, v(-12, 0, -15), 7, refs)
		paperLamp(folder, v(24, 0, -15), 7, refs)
		paperLamp(folder, v(-12, 0, 13), 7, refs)

		-- The suspended fireplace.
		local fx, fz = 28, -3
		local bowlCenter = v(fx, 5.5, fz)
		local ceil = Arch.ceilingAt(fx)
		Build.cylinderY(folder, Vector3.new(fx, (bowlCenter.Y + 3 + ceil) / 2, fz), ceil - bowlCenter.Y - 3, 1.4, {
			Name = "Flue",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		local template = Build.asset("Fireplace")
		local facing = CFrame.new(bowlCenter) * CFrame.Angles(0, math.pi / 2, 0) -- opening faces -X, toward the sofa
		if template then
			-- Mesh is a bowl with a neck on top; its bounding box centre sits 3 studs above the bowl centre.
			Build.placeAsset(template, folder, facing * CFrame.new(0, 3, 0), Vector3.new(8, 12.4, 7.7))
		else
			Build.ellipsoid(folder, facing, Vector3.new(8, 6.5, 8), { Name = "FireBowl", Material = Enum.Material.Metal, Color = C.Metal })
			Build.ellipsoid(folder, facing * CFrame.new(0, -0.4, -2.6), Vector3.new(5.4, 3, 3.4), {
				Name = "FireMouth",
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 120, 40),
			})
		end
		local core = Build.part(folder, {
			Name = "FireCore",
			Size = Vector3.new(2, 1, 2),
			CFrame = facing * CFrame.new(0, -0.6, -3.2),
			Transparency = 1,
			CanCollide = false,
		})
		local fire = Instance.new("Fire")
		fire.Size = 4
		fire.Heat = 4
		fire.Color = Color3.fromRGB(255, 140, 50)
		fire.SecondaryColor = Color3.fromRGB(255, 60, 10)
		fire.Parent = core
		local fireLight = Build.pointLight(core, Color3.fromRGB(255, 150, 70), 32, 2.4)
		local embers = Instance.new("ParticleEmitter")
		embers.Rate = 6
		embers.Lifetime = NumberRange.new(1, 2)
		embers.Speed = NumberRange.new(2, 4)
		embers.SpreadAngle = Vector2.new(25, 25)
		embers.Size = NumberSequence.new(0.15, 0)
		embers.LightEmission = 1
		embers.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
		embers.Parent = core
		refs.fire = { core = core, fire = fire, light = fireLight, embers = embers }
		refs.fireplacePos = core.Position

		-- Concierge tablet for upgrades.
		local tablet = Build.box(folder, v(10, 4, BZ - 0.3), v(14, 7, BZ), { Name = "ConciergeTablet", Material = Enum.Material.Glass, Color = C.Metal })
		local screen = Build.box(folder, v(10.3, 4.3, BZ - 0.4), v(13.7, 6.7, BZ - 0.3), {
			Name = "Screen",
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(120, 170, 220),
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
