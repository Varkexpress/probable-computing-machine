      <Item class="ModuleScript" referent="RBX00000015">
        <Properties>
          <string name="Name">Pets</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Pets: Mochi the resident house cat, and adoptable pets that follow their
-- owners around (cat, Samoyed puppy, snow rabbit, little penguin).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Arch = require(Shared:WaitForChild("Arch"))
local Config = require(Shared:WaitForChild("Config"))
local Build = require(script.Parent.Build)
local Registry = require(script.Parent.Registry)

local Pets = {}

local petsFolder: Folder
local refs
local hooks

----------------------------------------------------------------------------
-- Models (built from parts; a Blender "Cat" mesh replaces the cat body)
----------------------------------------------------------------------------

local function root(model: Model, size: Vector3): BasePart
	local r = Build.part(model, {
		Name = "Root",
		Size = size,
		CFrame = CFrame.new(0, size.Y / 2, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	model.PrimaryPart = r
	return r
end

local function bit(model: Model, cf: CFrame, size: Vector3, color: Color3, s: number, material: Enum.Material?)
	return Build.ellipsoid(model, CFrame.new(cf.Position * s) * cf.Rotation, size * s, {
		Name = "Bit",
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
end

local function legs(model: Model, color: Color3, s: number, spread: number, front: number, back: number, height: number)
	for _, x in { -spread, spread } do
		for _, z in { front, back } do
			Build.cylinderY(model, Vector3.new(x, height / 2, z) * s, height * s, 0.32 * s, {
				Name = "Leg",
				Color = color,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
		end
	end
end

local builders = {}

function builders.Cat(s: number, color: Color3): Model
	local m = Instance.new("Model")
	root(m, Vector3.new(1.2, 1.9, 2.8) * s)
	local template = Build.asset("Cat")
	if template then
		-- Blender cat mesh proportions (tail up): about 0.9 x 2.1 x 2.8 studs.
		Build.placeAsset(template, m, CFrame.new(0, 1.05 * s, 0), Vector3.new(0.9, 2.1, 2.8) * s, { CanCollide = false, CanQuery = false, Color = color })
		return m
	end
	bit(m, CFrame.new(0, 0.95, 0.15), Vector3.new(1.05, 0.95, 2.3), color, s)
	bit(m, CFrame.new(0, 1.55, -1.15), Vector3.new(0.95, 0.85, 0.85), color, s)
	bit(m, CFrame.new(0, 1.42, -1.55), Vector3.new(0.45, 0.3, 0.3), color:Lerp(Color3.new(1, 1, 1), 0.4), s)
	for _, x in { -0.27, 0.27 } do
		bit(m, CFrame.new(x, 2.0, -1.12) * CFrame.Angles(0, 0, x * -1.2), Vector3.new(0.28, 0.45, 0.16), color, s)
		bit(m, CFrame.new(x * 0.85, 1.65, -1.55), Vector3.new(0.16, 0.18, 0.08), Color3.fromRGB(150, 190, 90), s, Enum.Material.Neon)
	end
	-- Tail curling up.
	bit(m, CFrame.new(0, 1.25, 1.35) * CFrame.Angles(-0.7, 0, 0), Vector3.new(0.22, 0.22, 1.1), color, s)
	bit(m, CFrame.new(0, 1.75, 1.75) * CFrame.Angles(-1.3, 0, 0), Vector3.new(0.22, 0.22, 0.8), color, s)
	legs(m, color, s, 0.3, -0.75, 0.8, 0.6)
	return m
end

function builders.Samoyed(s: number, color: Color3): Model
	local m = Instance.new("Model")
	root(m, Vector3.new(1.6, 2.4, 3.2) * s)
	bit(m, CFrame.new(0, 1.25, 0.1), Vector3.new(1.55, 1.35, 2.7), color, s, Enum.Material.Fabric)
	bit(m, CFrame.new(0, 1.65, -1.05), Vector3.new(1.5, 1.4, 1.1), color, s, Enum.Material.Fabric) -- ruff
	bit(m, CFrame.new(0, 2.1, -1.45), Vector3.new(1.05, 0.95, 1), color, s, Enum.Material.Fabric)
	bit(m, CFrame.new(0, 1.92, -2.0), Vector3.new(0.5, 0.42, 0.6), color, s, Enum.Material.Fabric)
	bit(m, CFrame.new(0, 2.02, -2.3), Vector3.new(0.2, 0.16, 0.12), Color3.fromRGB(20, 20, 20), s)
	for _, x in { -0.3, 0.3 } do
		bit(m, CFrame.new(x, 2.65, -1.35) * CFrame.Angles(0, 0, -x), Vector3.new(0.3, 0.5, 0.2), color, s, Enum.Material.Fabric)
		bit(m, CFrame.new(x * 0.8, 2.25, -1.93), Vector3.new(0.13, 0.13, 0.06), Color3.fromRGB(15, 15, 15), s)
	end
	bit(m, CFrame.new(0, 2.0, 1.25) * CFrame.Angles(0.6, 0, 0), Vector3.new(0.7, 0.7, 1.2), color, s, Enum.Material.Fabric) -- curled tail
	legs(m, color, s, 0.42, -0.85, 0.9, 0.8)
	return m
end

function builders.Rabbit(s: number, color: Color3): Model
	local m = Instance.new("Model")
	root(m, Vector3.new(1, 1.8, 1.6) * s)
	bit(m, CFrame.new(0, 0.6, 0.15), Vector3.new(1, 1, 1.35), color, s, Enum.Material.Fabric)
	bit(m, CFrame.new(0, 1.15, -0.55), Vector3.new(0.8, 0.75, 0.75), color, s, Enum.Material.Fabric)
	for _, x in { -0.25, 0.25 } do
		bit(m, CFrame.new(x * 1.6, 1.15, -0.45) * CFrame.Angles(0.2, 0, x * 3), Vector3.new(0.25, 0.85, 0.12), color, s, Enum.Material.Fabric)
		bit(m, CFrame.new(x * 0.9, 1.22, -0.88), Vector3.new(0.12, 0.13, 0.06), Color3.fromRGB(30, 20, 20), s)
	end
	bit(m, CFrame.new(0, 0.75, 0.9), Vector3.new(0.4, 0.4, 0.4), Color3.new(1, 1, 1), s, Enum.Material.Fabric)
	return m
end

function builders.Penguin(s: number, _color: Color3): Model
	local m = Instance.new("Model")
	root(m, Vector3.new(1.2, 2.6, 1.2) * s)
	local black = Color3.fromRGB(24, 26, 32)
	bit(m, CFrame.new(0, 1.05, 0), Vector3.new(1.15, 1.9, 1.05), black, s)
	bit(m, CFrame.new(0, 1.0, -0.2), Vector3.new(0.9, 1.6, 0.8), Color3.fromRGB(240, 240, 238), s)
	bit(m, CFrame.new(0, 2.15, 0), Vector3.new(0.85, 0.8, 0.8), black, s)
	bit(m, CFrame.new(0, 2.1, -0.5), Vector3.new(0.2, 0.15, 0.4), Color3.fromRGB(230, 130, 40), s)
	for _, x in { -0.2, 0.2 } do
		bit(m, CFrame.new(x, 2.28, -0.36), Vector3.new(0.16, 0.16, 0.06), Color3.new(1, 1, 1), s)
		bit(m, CFrame.new(x * 2.9, 1.2, 0) * CFrame.Angles(0, 0, x * 1.2), Vector3.new(0.15, 1.1, 0.45), black, s)
		bit(m, CFrame.new(x, 0.06, -0.25), Vector3.new(0.35, 0.1, 0.5), Color3.fromRGB(230, 130, 40), s)
	end
	return m
end

local PET_LOOK = {
	Cat = { scale = 0.75, color = Color3.fromRGB(205, 140, 80) },
	Samoyed = { scale = 0.9, color = Color3.fromRGB(246, 244, 238) },
	Rabbit = { scale = 1, color = Color3.fromRGB(240, 238, 234) },
	Penguin = { scale = 0.85, color = Color3.new() },
}

local function nameTag(model: Model, text: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.new(0, 160, 0, 28)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (model.PrimaryPart :: BasePart).Size.Y / 2 + 1.2, 0)
	gui.MaxDistance = 40
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 15
	label.TextColor3 = Color3.fromRGB(240, 236, 228)
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
	gui.Parent = model.PrimaryPart
end

----------------------------------------------------------------------------
-- Mochi, the resident cat
----------------------------------------------------------------------------

local mochi: Model
local mochiPos: Vector3
local mochiFacing = Vector3.new(0, 0, -1)
local path: { Vector3 } = {}
local idleUntil = 0
local spotName = "firebed"
local bowlFull = false

-- Floor height (plus furniture the cat can hop onto) at an x/z position.
local function catGround(x: number, z: number): number
	local y = Arch.slabTop(x)
	for _, room in Arch.ROOMS do
		if x >= room.x0 and x < room.x1 then
			y = Arch.roomFloor(room)
			break
		end
	end
	for _, s in refs.catSurfaces do
		if x >= s.x0 and x <= s.x1 and z >= s.z0 and z <= s.z1 then
			y = math.max(y, s.top)
		end
	end
	return y
end

local function roomIndex(x: number): number
	for i, room in Arch.ROOMS do
		if x >= room.x0 and x < room.x1 then
			return i
		end
	end
	return x < 0 and 1 or #Arch.ROOMS
end

local function planPath(from: Vector3, to: Vector3): { Vector3 }
	local pts = {}
	local a, b = roomIndex(from.X), roomIndex(to.X)
	-- Walk through the middle of each doorway (z = 9) between rooms.
	if a < b then
		for i = a, b - 1 do
			local bx = Arch.ROOMS[i].x1
			table.insert(pts, Vector3.new(bx - 1.5, 0, 9))
			table.insert(pts, Vector3.new(bx + 1.5, 0, 9))
		end
	elseif a > b then
		for i = a, b + 1, -1 do
			local bx = Arch.ROOMS[i].x0
			table.insert(pts, Vector3.new(bx + 1.5, 0, 9))
			table.insert(pts, Vector3.new(bx - 1.5, 0, 9))
		end
	end
	table.insert(pts, Vector3.new(to.X, 0, to.Z))
	return pts
end

-- True if a closed door stands between two x positions (doors cross the gallery).
local function doorBetween(x1: number, x2: number): boolean
	for _, d in Registry.doors do
		local bx = d.closed.Position.X
		if not d.isOpen and math.min(x1, x2) < bx and math.max(x1, x2) > bx then
			return true
		end
	end
	return false
end

local function chooseSpot()
	local night = workspace:GetAttribute("Night") == true
	local weights = {
		firebed = (refs.fireLit() and 5 or 1) + (night and 3 or 0),
		sofa = 3,
		rug = 2,
		glassfloor = 2,
		bed = night and 4 or 2,
		bowl = bowlFull and 6 or 1,
		counter = 1,
		window = 2,
	}
	weights[spotName] = 0
	for name in weights do
		local spot = refs.catSpots[name]
		if not spot or doorBetween(mochiPos.X, spot.X) then
			weights[name] = 0
		end
	end
	local total = 0
	for _, w in weights do
		total += w
	end
	if total <= 0 then
		return nil
	end
	local roll = math.random() * total
	for name, w in weights do
		if w > 0 then
			roll -= w
			if roll <= 0 then
				return name
			end
		end
	end
	return nil
end

local function placeMochi(pos: Vector3, facing: Vector3, bob: number)
	local flat = Vector3.new(facing.X, 0, facing.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local rootSize = (mochi.PrimaryPart :: BasePart).Size
	local p = pos + Vector3.new(0, rootSize.Y / 2 + bob, 0)
	mochi:PivotTo(CFrame.lookAt(p, p + flat.Unit))
end

local zzz: BillboardGui

local function mochiStep(dt: number)
	local now = os.clock()
	if #path == 0 then
		if now < idleUntil then
			return
		end
		local nextSpot = chooseSpot()
		if not nextSpot then
			-- Shut in: wait by the door and try again later.
			idleUntil = now + 10
			return
		end
		spotName = nextSpot
		local spot = refs.catSpots[spotName]
		path = planPath(mochiPos, spot)
		zzz.Enabled = false
		return
	end
	local target = path[1]
	local flatPos = Vector3.new(mochiPos.X, 0, mochiPos.Z)
	local delta = target - flatPos
	local dist = delta.Magnitude
	local speed = 6
	if dist <= speed * dt then
		flatPos = target
		table.remove(path, 1)
		if #path == 0 then
			-- Arrived: settle in for a while.
			local sleepy = spotName == "firebed" or spotName == "bed" or spotName == "sofa"
			idleUntil = now + (sleepy and math.random(40, 80) or math.random(15, 30))
			zzz.Enabled = sleepy
			if spotName == "bowl" and bowlFull then
				task.delay(4, function()
					bowlFull = false
					refs.kibble.Transparency = 1
				end)
			end
		end
	else
		flatPos += delta.Unit * speed * dt
		mochiFacing = delta.Unit
	end
	local ground = catGround(flatPos.X, flatPos.Z)
	-- Ease the height so hops onto furniture look like jumps, not teleports.
	local y = mochiPos.Y + (ground - mochiPos.Y) * math.min(1, dt * 10)
	mochiPos = Vector3.new(flatPos.X, y, flatPos.Z)
	local bob = #path > 0 and math.abs(math.sin(now * 12)) * 0.12 or 0
	placeMochi(mochiPos, mochiFacing, bob)
end

local function buildMochi()
	mochi = builders.Cat(1, Color3.fromRGB(128, 124, 120))
	mochi.Name = Config.RESIDENT_CAT_NAME
	mochi.Parent = petsFolder
	nameTag(mochi, Config.RESIDENT_CAT_NAME)
	zzz = Instance.new("BillboardGui")
	zzz.Size = UDim2.new(0, 60, 0, 30)
	zzz.StudsOffsetWorldSpace = Vector3.new(0.6, 2.6, 0)
	zzz.MaxDistance = 30
	zzz.Enabled = false
	local z = Instance.new("TextLabel")
	z.Size = UDim2.fromScale(1, 1)
	z.BackgroundTransparency = 1
	z.Text = "z z z"
	z.Font = Enum.Font.GothamMedium
	z.TextSize = 14
	z.TextColor3 = Color3.fromRGB(220, 226, 240)
	z.Parent = zzz
	zzz.Parent = mochi.PrimaryPart

	local spot = refs.catSpots.firebed
	mochiPos = spot
	placeMochi(spot, Vector3.new(-1, 0, 0), 0)
	idleUntil = os.clock() + 20
	zzz.Enabled = true

	local body = mochi.PrimaryPart
	local pet = Build.prompt(body, "Pet " .. Config.RESIDENT_CAT_NAME, "House cat", 0, 9)
	pet.Triggered:Connect(function(player)
		hooks.discover(player, "mochi")
		if hooks.onCooldown(player, "petmochi", 10) then
			return
		end
		hooks.addNeed(player, "Fun", 12)
		local lines = {
			"Mochi purrs like a tiny engine.",
			"Mochi headbutts your hand and demands more.",
			"Mochi stretches, yawns, and goes straight back to sleep.",
			"Mochi slow-blinks at you. That means love.",
			"Mochi flops over. Do NOT touch the belly.",
		}
		hooks.notify(player, lines[math.random(#lines)])
	end)
	local treat = Build.prompt(body, "Give a treat", "House cat", 0.3, 9)
	treat.UIOffset = Vector2.new(0, 70)
	treat.KeyboardKeyCode = Enum.KeyCode.F
	treat.Triggered:Connect(function(player)
		if not hooks.useTreat(player) then
			hooks.notify(player, "No treats. Bake some Pet Treats in the galley oven.", "warn")
			return
		end
		hooks.discover(player, "mochi")
		hooks.addNeed(player, "Fun", 18)
		hooks.completeChore(player, "feedcat")
		hooks.notify(player, "Mochi inhales the treat and follows you hopefully.")
		-- Mochi trots over to the player.
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp and Arch.roomAt(hrp.Position) and not doorBetween(mochiPos.X, hrp.Position.X) then
			path = planPath(mochiPos, hrp.Position + hrp.CFrame.LookVector * 2.5)
			spotName = "player"
			idleUntil = os.clock() + 20
		end
	end)
end

function Pets.fillBowl(player: Player): boolean
	if bowlFull then
		hooks.notify(player, "Mochi's bowl is already full.")
		return false
	end
	bowlFull = true
	refs.kibble.Transparency = 0
	hooks.completeChore(player, "feedcat")
	hooks.notify(player, "You fill Mochi's bowl. Somewhere in the house, a cat hears it.")
	-- The sound of kibble summons the cat.
	if not doorBetween(mochiPos.X, refs.catSpots.bowl.X) then
		path = planPath(mochiPos, refs.catSpots.bowl)
		spotName = "bowl"
	end
	return true
end

----------------------------------------------------------------------------
-- Follower pets
----------------------------------------------------------------------------

local followers: { [Player]: { model: Model, kind: string, pos: Vector3 } } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

local function refreshRayFilter()
	local list = { petsFolder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

function Pets.setActive(player: Player, kind: string?)
	local old = followers[player]
	if old then
		old.model:Destroy()
		followers[player] = nil
	end
	if not kind or not builders[kind] then
		return
	end
	local look = PET_LOOK[kind]
	local model = builders[kind](look.scale, look.color)
	model.Name = player.Name .. "_" .. kind
	model.Parent = petsFolder
	local displayName = kind == "Samoyed" and "Puppy" or kind
	nameTag(model, player.DisplayName .. "'s " .. displayName)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local start = hrp and (hrp.Position - Vector3.new(0, 3, 0)) or Vector3.zero
	followers[player] = { model = model, kind = kind, pos = start }

	local pet = Build.prompt(model.PrimaryPart, "Pet", displayName, 0, 8)
	pet.Triggered:Connect(function(who)
		if hooks.onCooldown(who, "petfollower", 6) then
			return
		end
		hooks.addNeed(who, "Fun", 8)
		local lines = {
			Cat = "The kitten pounces on your shoelace.",
			Samoyed = "The puppy does the Samoyed smile and wags its whole body.",
			Rabbit = "The rabbit does a happy little binky.",
			Penguin = "The penguin flaps its flippers and squawks.",
		}
		hooks.notify(who, lines[kind] or "Happy noises.")
	end)
	local treat = Build.prompt(model.PrimaryPart, "Give a treat", displayName, 0.3, 8)
	treat.UIOffset = Vector2.new(0, 70)
	treat.KeyboardKeyCode = Enum.KeyCode.F
	treat.Triggered:Connect(function(who)
		if not hooks.useTreat(who) then
			hooks.notify(who, "No treats. Bake some Pet Treats in the galley oven.", "warn")
			return
		end
		hooks.addNeed(who, "Fun", 15)
		hooks.notify(who, "Crunch crunch. Best friends forever.")
	end)
end

local function followerStep(dt: number)
	for player, f in followers do
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or not f.model.Parent then
			continue
		end
		local goal = (hrp.CFrame * CFrame.new(2.4, 0, 2.6)).Position
		local flat = Vector3.new(f.pos.X, 0, f.pos.Z)
		local goalFlat = Vector3.new(goal.X, 0, goal.Z)
		local dist = (goalFlat - flat).Magnitude
		local moving = dist > 1.2
		if dist > 45 then
			flat = goalFlat
		elseif moving then
			flat = flat:Lerp(goalFlat, math.min(1, dt * 3.5))
		end
		local hit = Workspace:Raycast(flat + Vector3.new(0, hrp.Position.Y + 2, 0), Vector3.new(0, -14, 0), rayParams)
		local groundY = hit and hit.Position.Y or (hrp.Position.Y - 3)
		local y = f.pos.Y + (groundY - f.pos.Y) * math.min(1, dt * 12)
		if math.abs(groundY - f.pos.Y) > 8 then
			y = groundY
		end
		local newPos = Vector3.new(flat.X, y, flat.Z)
		local dir = moving and (goalFlat - Vector3.new(f.pos.X, 0, f.pos.Z)) or hrp.CFrame.LookVector
		f.pos = newPos
		local size = f.model.PrimaryPart.Size
		local hop = moving and math.abs(math.sin(os.clock() * (f.kind == "Rabbit" and 9 or 13))) * (f.kind == "Rabbit" and 0.5 or 0.12) or 0
		local center = newPos + Vector3.new(0, size.Y / 2 + hop, 0)
		local flatDir = Vector3.new(dir.X, 0, dir.Z)
		if flatDir.Magnitude < 0.01 then
			flatDir = Vector3.new(0, 0, -1)
		end
		local cf = CFrame.lookAt(center, center + flatDir.Unit)
		if f.kind == "Penguin" and moving then
			cf *= CFrame.Angles(0, 0, math.sin(os.clock() * 10) * 0.18) -- waddle
		end
		f.model:PivotTo(cf)
	end
end

----------------------------------------------------------------------------

function Pets.start(builtRefs, builtHooks)
	refs = builtRefs
	hooks = builtHooks
	petsFolder = Build.folder(refs.root, "Pets")
	buildMochi()
	local filterTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		mochiStep(dt)
		filterTimer -= dt
		if filterTimer <= 0 then
			filterTimer = 2
			refreshRayFilter()
		end
		followerStep(dt)
	end)
	Players.PlayerRemoving:Connect(function(player)
		Pets.setActive(player, nil)
	end)
end

return Pets
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000016">
        <Properties>
          <string name="Name">Registry</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- One place where every home registers the things players can use, so the
-- gameplay code works the same in all four homes.

local Registry = {}

export type Kitchen = {
	home: string,
	stove: BasePart,
	oven: BasePart,
	coffee: BasePart,
	kettle: BasePart,
	fridge: BasePart,
	pantry: BasePart,
	sink: BasePart, -- where dishes are washed
	dishSpot: Vector3, -- where dirty plates pile up
	steam: ParticleEmitter,
	dirty: number,
	dishParts: { BasePart },
}

export type FireSpot = {
	home: string,
	core: BasePart,
	fire: any,
	light: PointLight,
	embers: ParticleEmitter,
	basket: BasePart?,
	fuel: number,
	baseSize: number,
}

export type Interior = {
	home: string,
	name: string,
	-- Either an axis-aligned box or a custom test.
	min: Vector3?,
	max: Vector3?,
	test: ((Vector3) -> boolean)?,
}

export type Home = {
	id: string,
	name: string,
	center: Vector3,
	spawn: CFrame, -- where residents wake up
	dock: CFrame, -- where the ferry and boat arrive
	deed: BasePart?,
	deedLabel: TextLabel?,
}

Registry.homes = {} :: { [string]: Home }
Registry.homeOrder = {} :: { string }
Registry.kitchens = {} :: { Kitchen }
Registry.fires = {} :: { FireSpot }
Registry.beds = {} :: { { home: string, mattress: BasePart, duvet: BasePart, tidy: CFrame, messy: CFrame, messyNow: boolean } }
Registry.showers = {} :: { { home: string, head: BasePart, rain: ParticleEmitter } }
Registry.sinks = {} :: { BasePart }
Registry.plants = {} :: { { pot: BasePart, leaves: Instance, watered: boolean? } }
Registry.bookshelves = {} :: { BasePart }
Registry.lamps = {} :: { { part: BasePart, light: Light } }
Registry.doors = {} :: { { part: BasePart, closed: CFrame, open: CFrame, isOpen: boolean? } }
Registry.interiors = {} :: { Interior }
Registry.docks = {} :: { { home: string, bell: BasePart, boatSpawn: CFrame } }
Registry.notes = {} :: { { id: string, part: BasePart } }
Registry.misc = {} :: { [string]: any }

function Registry.addHome(home: Home)
	Registry.homes[home.id] = home
	table.insert(Registry.homeOrder, home.id)
end

function Registry.addInterior(home: string, name: string, minV: Vector3, maxV: Vector3)
	table.insert(Registry.interiors, { home = home, name = name, min = minV:Min(maxV), max = minV:Max(maxV) })
end

function Registry.addInteriorTest(home: string, name: string, test: (Vector3) -> boolean)
	table.insert(Registry.interiors, { home = home, name = name, test = test })
end

-- Which home and room a position is inside, if any.
function Registry.locate(pos: Vector3): Interior?
	for _, i in Registry.interiors do
		if i.test then
			if i.test(pos) then
				return i
			end
		elseif pos.X >= i.min.X and pos.X <= i.max.X and pos.Y >= i.min.Y and pos.Y <= i.max.Y and pos.Z >= i.min.Z and pos.Z <= i.max.Z then
			return i
		end
	end
	return nil
end

function Registry.nearestFire(pos: Vector3): (FireSpot?, number)
	local best, bestDist = nil, math.huge
	for _, f in Registry.fires do
		local d = (f.core.Position - pos).Magnitude
		if d < bestDist then
			best, bestDist = f, d
		end
	end
	return best, bestDist
end

function Registry.nearestKitchen(pos: Vector3): Kitchen?
	local best, bestDist = nil, math.huge
	for _, k in Registry.kitchens do
		local d = (k.stove.Position - pos).Magnitude
		if d < bestDist then
			best, bestDist = k, d
		end
	end
	return best
end

function Registry.reset()
	table.clear(Registry.homes)
	table.clear(Registry.homeOrder)
	table.clear(Registry.kitchens)
	table.clear(Registry.fires)
	table.clear(Registry.beds)
	table.clear(Registry.showers)
	table.clear(Registry.sinks)
	table.clear(Registry.plants)
	table.clear(Registry.bookshelves)
	table.clear(Registry.lamps)
	table.clear(Registry.doors)
	table.clear(Registry.interiors)
	table.clear(Registry.docks)
	table.clear(Registry.notes)
	table.clear(Registry.misc)
end

return Registry
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000017">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- The world around the mansion: the Southern Ocean, the rock the west leg
-- stands on, the dock, ice floes, the night sea ice, lighting and fog.

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Workspace = game:GetService("Workspace")

local Build = require(script.Parent.Build)
local Furnish = require(script.Parent.Furnish)
local Registry = require(script.Parent.Registry)

local World = {}

local C = Build.Color

local function setupLighting()
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future
	end)
	Lighting.Ambient = Color3.fromRGB(40, 46, 58)
	Lighting.OutdoorAmbient = Color3.fromRGB(96, 108, 130)
	Lighting.Brightness = 1.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4
	Lighting.GeographicLatitude = -70

	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.42
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(170, 186, 208)
	atmosphere.Decay = Color3.fromRGB(80, 98, 128)
	atmosphere.Glare = 0
	atmosphere.Haze = 2.2
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.StarCount = 2500
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "Grade"
	cc.Contrast = 0.08
	cc.Saturation = -0.12
	cc.TintColor = Color3.fromRGB(226, 234, 255)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local sun = Instance.new("SunRaysEffect")
	sun.Intensity = 0.04
	sun.Spread = 0.6
	sun.Parent = Lighting
end

local function setupOcean()
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(16, 26, 38)
	terrain.WaterTransparency = 0.25
	terrain.WaterReflectance = 1
	terrain.WaterWaveSize = 0.04
	terrain.WaterWaveSpeed = 4
	terrain:Clear()

	-- 4 x 4 tiles of 512 studs = a 2048-stud square of sea; the fog hides the edge.
	local tile = 512
	for ix = -2, 1 do
		for iz = -2, 1 do
			local cx = ix * tile + tile / 2
			local cz = iz * tile + tile / 2
			terrain:FillBlock(CFrame.new(cx, -20, cz), Vector3.new(tile, 40, tile), Enum.Material.Water)
			terrain:FillBlock(CFrame.new(cx, -44, cz), Vector3.new(tile, 8, tile), Enum.Material.Basalt)
		end
	end
end

-- Rock island under the west leg, with snow on top.
local function setupIsland(root: Instance)
	local terrain = Workspace.Terrain
	local cx = -275
	terrain:FillBlock(CFrame.new(cx, -18, 0), Vector3.new(112, 48, 124), Enum.Material.Rock)
	terrain:FillBall(Vector3.new(cx - 40, -6, 40), 34, Enum.Material.Rock)
	terrain:FillBall(Vector3.new(cx - 46, -8, -38), 30, Enum.Material.Rock)
	terrain:FillBall(Vector3.new(cx + 44, -10, 52), 22, Enum.Material.Rock)
	terrain:FillBlock(CFrame.new(cx, 7, 0), Vector3.new(108, 2, 120), Enum.Material.Snow)
	terrain:FillBall(Vector3.new(cx - 40, 6, 40), 18, Enum.Material.Snow)

	local folder = Build.folder(root, "Island")
	-- Snowy rocks for some shape.
	local rng = Random.new(7)
	for _ = 1, 26 do
		local x = cx + rng:NextNumber(-56, 56)
		local z = rng:NextNumber(-62, 62)
		if math.abs(x - (-280)) > 22 or math.abs(z) > 24 then
			local s = rng:NextNumber(3, 9)
			Build.part(folder, {
				Name = "Boulder",
				Size = Vector3.new(s * 1.3, s, s),
				CFrame = CFrame.new(x, 7 + s * 0.2, z) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4)),
				Material = Enum.Material.Rock,
				Color = Color3.fromRGB(58, 60, 64),
			})
		end
	end
end

local function setupDock(root: Instance)
	local folder = Build.folder(root, "Dock")
	local refs = {}

	-- Concrete pier running from the island out to sea (toward -Z).
	local pierX = -248
	Build.box(folder, Vector3.new(pierX - 6, 6, -58), Vector3.new(pierX + 6, 8, -126), {
		Name = "Pier",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteOut,
	})
	for z = -66, -122, -14 do
		for _, side in { -5, 5 } do
			Build.cylinderY(folder, Vector3.new(pierX + side, -10, z), 34, 2.2, {
				Name = "Pile",
				Material = Enum.Material.Concrete,
				Color = C.ConcreteDark,
			})
		end
	end
	-- Low lamp posts along the pier.
	for _, z in { -70, -98, -122 } do
		for _, side in { -5.4, 5.4 } do
			local post = Build.part(folder, {
				Name = "PierLamp",
				Size = Vector3.new(0.8, 3, 0.8),
				CFrame = CFrame.new(pierX + side, 9.5, z),
				Material = Enum.Material.Neon,
				Color = C.Warm,
			})
			Build.pointLight(post, C.Warm, 14, 1.2)
		end
	end

	-- Fishing spot at the end of the pier.
	local spot = Build.part(folder, {
		Name = "FishingSpot",
		Size = Vector3.new(4, 0.4, 4),
		CFrame = CFrame.new(pierX, 8.2, -122),
		Material = Enum.Material.WoodPlanks,
		Color = C.Wood,
	})
	-- A rod leaning on a holder.
	Build.beam(folder, Vector3.new(pierX + 1.5, 8.4, -122), Vector3.new(pierX + 4, 16, -130), 0.25, 0.25, {
		Name = "Rod",
		Color = C.Metal,
		CanCollide = false,
	})
	refs.fishSpot = spot

	local crate = Build.part(folder, {
		Name = "FishCrate",
		Size = Vector3.new(4, 3, 3),
		CFrame = CFrame.new(pierX + 3, 9.5, -74),
		Material = Enum.Material.WoodPlanks,
		Color = C.Wood,
	})
	refs.fishCrate = crate

	-- Funicular booth at the foot of the west leg.
	local boothCenter = Vector3.new(-256, 8, 0)
	Build.box(folder, boothCenter + Vector3.new(-5, 0, -6), boothCenter + Vector3.new(5, 0.6, 6), {
		Name = "BoothFloor",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteIn,
	})
	Build.box(folder, boothCenter + Vector3.new(-5, 12, -6), boothCenter + Vector3.new(5, 13, 6), {
		Name = "BoothRoof",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteIn,
	})
	for _, z in { -6, 6 } do
		Build.box(folder, boothCenter + Vector3.new(-5, 0.6, z - 0.2), boothCenter + Vector3.new(5, 12, z + 0.2), {
			Name = "BoothGlass",
			Material = Enum.Material.Glass,
			Color = C.Glass,
			Transparency = 0.6,
		})
	end
	local car = Build.box(folder, boothCenter + Vector3.new(-5, 0.6, -4), boothCenter + Vector3.new(-4.4, 11, 4), {
		Name = "FunicularDoor",
		Material = Enum.Material.Metal,
		Color = C.Metal,
	})
	local light = Build.box(folder, boothCenter + Vector3.new(-4, 11.6, -4), boothCenter + Vector3.new(4, 11.9, 4), {
		Name = "BoothLight",
		Material = Enum.Material.Neon,
		Color = C.Warm,
	})
	Build.surfaceLight(light, Enum.NormalId.Bottom, C.Warm, 14, 1.5)
	refs.funicularBottom = car
	refs.funicularBottomArrive = CFrame.new(boothCenter + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, -math.pi / 2, 0)

	refs.dockCenter = Vector3.new(pierX, 8, -90)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "DockSpawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(-238, 8, -30)
	spawn.Anchored = true
	spawn.Material = Enum.Material.Concrete
	spawn.Color = C.ConcreteIn
	spawn.Transparency = 0
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = folder
	-- Remove the default decal so it looks like a paving slab.
	for _, d in spawn:GetChildren() do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end

	return refs
end

-- Areas kept clear of ice floes: the Ribcage legs, island and pier, the
-- sealed hatch under the arch, and the three other homes with their piers.
local CLEAR_ZONES = {
	{ -350, -190, -150, 80 }, -- west leg, island, pier
	{ 210, 350, -60, 60 }, -- east leg
	{ -45, 45, -105, -15 }, -- the hatch under the arch
	{ -45, 125, 570, 775 }, -- the Monolith
	{ -725, -505, -515, -385 }, -- the Vertebrae
	{ 555, 745, -615, -385 }, -- the Well
}

local function floeOverlapsArch(x: number, z: number): boolean
	for _, r in CLEAR_ZONES do
		if x >= r[1] and x <= r[2] and z >= r[3] and z <= r[4] then
			return true
		end
	end
	return false
end

-- The night ice: an invisible sheet over the whole sea that becomes solid
-- (and visible) when the sea freezes. Boats never collide with it.
local function setupSeaIce(root: Instance)
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Boats")
		PhysicsService:RegisterCollisionGroup("SeaIce")
	end)
	PhysicsService:CollisionGroupSetCollidable("Boats", "SeaIce", false)
	local ice = Build.part(root, {
		Name = "SeaIce",
		Size = Vector3.new(2048, 0.8, 2048),
		CFrame = CFrame.new(0, 0, 0),
		Material = Enum.Material.Glacier,
		Color = Color3.fromRGB(206, 222, 236),
		Reflectance = 0.08,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	ice.CollisionGroup = "SeaIce"
	Registry.misc.seaIce = ice
	return ice
end

local function setupFloes(root: Instance)
	local folder = Build.folder(root, "IceFloes")
	local rng = Random.new(2024)
	local made = 0
	while made < 170 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(90, 980)
		local x = math.cos(angle) * dist
		local z = math.sin(angle) * dist
		if not floeOverlapsArch(x, z) then
			made += 1
			local big = rng:NextNumber() < 0.15
			local size = big and rng:NextNumber(26, 46) or rng:NextNumber(5, 18)
			local model = Instance.new("Model")
			model.Name = "Floe"
			local pieces = rng:NextInteger(2, 4)
			for i = 1, pieces do
				local s = size * rng:NextNumber(0.5, 1)
				local offset = Vector3.new(rng:NextNumber(-0.35, 0.35) * size, 0, rng:NextNumber(-0.35, 0.35) * size)
				local height = rng:NextNumber(0.8, 1.8)
				local p = Build.part(model, {
					Name = "Ice" .. i,
					Size = Vector3.new(s, height, s * rng:NextNumber(0.6, 1)),
					CFrame = CFrame.new(x, height / 2 - 0.3, z) * CFrame.new(offset) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
					Material = Enum.Material.Snow,
					Color = C.Snow,
				})
				if i == 1 then
					model.PrimaryPart = p
				end
			end
			model:SetAttribute("Phase", rng:NextNumber(0, math.pi * 2))
			model.Parent = folder
		end
	end
	return folder
end

function World.build(root: Instance)
	setupLighting()
	setupOcean()
	setupIsland(root)
	local refs = setupDock(root)
	refs.floes = setupFloes(root)
	refs.seaIce = setupSeaIce(root)
	-- Ferry bell and boat at the Ribcage pier.
	Furnish.bell(Build.folder(root, "Dock"), Vector3.new(-252, 8, -110), "ribcage", CFrame.new(-236, 1.2, -100))
	return refs
end

return World
]]></ProtectedString>
        </Properties>
