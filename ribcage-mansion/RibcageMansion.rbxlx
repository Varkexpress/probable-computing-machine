  <Item class="ServerScriptService" referent="RBX00000005">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000006">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source"><![CDATA[-- The Ribcage: entry point. Builds the mansion and starts the game systems.

local Players = game:GetService("Players")

-- Hold characters back until the world exists, so nobody falls into the void.
Players.CharacterAutoLoads = false

local Modules = script.Parent:WaitForChild("Modules")
local Builder = require(Modules:WaitForChild("Builder"))
local Gameplay = require(Modules:WaitForChild("Gameplay"))

local started = os.clock()
local refs = Builder.build()
print(string.format("[Ribcage] Mansion built in %.1fs", os.clock() - started))

Gameplay.start(refs)

Players.CharacterAutoLoads = true
for _, player in Players:GetPlayers() do
	if not player.Character then
		task.spawn(function()
			player:LoadCharacter()
		end)
	end
end
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX00000007">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">Build</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Small helpers for making anchored parts, lights and prompts in code.

local ServerStorage = game:GetService("ServerStorage")

local Build = {}

Build.Color = {
	ConcreteOut = Color3.fromRGB(168, 168, 164),
	ConcreteDark = Color3.fromRGB(70, 72, 74),
	ConcreteIn = Color3.fromRGB(132, 122, 110),
	Floor = Color3.fromRGB(78, 70, 62),
	Glass = Color3.fromRGB(160, 190, 210),
	Fabric = Color3.fromRGB(46, 42, 40),
	Marble = Color3.fromRGB(28, 26, 26),
	Wood = Color3.fromRGB(70, 48, 34),
	Warm = Color3.fromRGB(255, 196, 130),
	Metal = Color3.fromRGB(24, 24, 26),
	Snow = Color3.fromRGB(236, 241, 246),
	Ice = Color3.fromRGB(214, 228, 240),
}

function Build.folder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = name
	nf.Parent = parent
	return nf
end

-- Build.part(parent, { Size = ..., CFrame = ..., ... }) -> Part
-- Pass ClassName = "WedgePart" etc. for other part types.
function Build.part(parent: Instance, props: { [string]: any }): BasePart
	local p: any = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props.Shape and p:IsA("Part") then
		p.Shape = props.Shape
	end
	if props.Size then
		p.Size = props.Size
	end
	for k, v in props do
		if k ~= "ClassName" and k ~= "Shape" and k ~= "Size" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- A block spanning two corner points (axis aligned).
function Build.box(parent: Instance, a: Vector3, b: Vector3, props: { [string]: any }?): BasePart
	local minV = a:Min(b)
	local maxV = a:Max(b)
	local p = table.clone(props or {})
	p.Size = maxV - minV
	p.CFrame = CFrame.new((minV + maxV) / 2)
	return Build.part(parent, p)
end

-- A stretched sphere (uses a SpecialMesh so it can be non-uniform).
function Build.ellipsoid(parent: Instance, cf: CFrame, size: Vector3, props: { [string]: any }?): BasePart
	local p = table.clone(props or {})
	p.Size = size
	p.CFrame = cf
	local part = Build.part(parent, p)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- A cylinder whose axis runs along world Y.
function Build.cylinderY(parent: Instance, center: Vector3, height: number, diameter: number, props: { [string]: any }?): BasePart
	local p = table.clone(props or {})
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2)
	return Build.part(parent, p)
end

-- A part stretched between two points with a given cross-section.
function Build.beam(parent: Instance, p1: Vector3, p2: Vector3, width: number, depth: number, props: { [string]: any }?, up: Vector3?): BasePart
	local p = table.clone(props or {})
	local len = (p2 - p1).Magnitude
	p.Size = Vector3.new(width, depth, len)
	p.CFrame = CFrame.lookAt((p1 + p2) / 2, p2, up or Vector3.yAxis)
	return Build.part(parent, p)
end

function Build.pointLight(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = true
	l.Parent = parent
	return l
end

function Build.surfaceLight(parent: Instance, face: Enum.NormalId, color: Color3, range: number, brightness: number, angle: number?): SurfaceLight
	local l = Instance.new("SurfaceLight")
	l.Face = face
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Angle = angle or 90
	l.Parent = parent
	return l
end

function Build.prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = distance or 10
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

-- Finds an optional Blender-made asset in ServerStorage.BlenderAssets.
function Build.asset(name: string): Instance?
	local folder = ServerStorage:FindFirstChild("BlenderAssets")
	if not folder then
		return nil
	end
	local found = folder:FindFirstChild(name)
	return found
end

-- Places a copy of an imported asset so its bounding box fills `size`
-- centred on `cf`. Works for a MeshPart or a Model of MeshParts.
function Build.placeAsset(template: Instance, parent: Instance, cf: CFrame, size: Vector3, props: { [string]: any }?): Instance
	-- The 3D importer often wraps a single mesh in a Model; use the mesh itself
	-- so it can be stretched non-uniformly.
	if template:IsA("Model") then
		local parts = {}
		for _, d in template:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
		if #parts == 1 then
			template = parts[1]
		end
	end
	local clone = template:Clone()
	local function style(part: BasePart)
		part.Anchored = true
		for k, v in (props or {}) :: { [string]: any } do
			pcall(function()
				(part :: any)[k] = v
			end)
		end
	end
	if clone:IsA("BasePart") then
		clone.Size = size
		clone.CFrame = cf
		style(clone)
	elseif clone:IsA("Model") then
		for _, d in clone:GetDescendants() do
			if d:IsA("BasePart") then
				style(d)
			end
		end
		local _, bbSize = clone:GetBoundingBox()
		local scale = math.max(size.X, size.Y, size.Z) / math.max(bbSize.X, bbSize.Y, bbSize.Z)
		clone:ScaleTo(clone:GetScale() * scale)
		local bbCf = clone:GetBoundingBox()
		local offset = bbCf:ToObjectSpace(clone:GetPivot())
		clone:PivotTo(cf * offset)
	end
	clone.Parent = parent
	return clone
end

return Build
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">Builder</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the whole map. Called by Main when the game starts.
--
-- To look at the mansion in Studio without pressing Play, paste this into the
-- Command Bar (View > Command Bar) and press Enter:
--   require(game.ServerScriptService.Modules.Builder).build()

local Workspace = game:GetService("Workspace")

local World = require(script.Parent.World)
local Mansion = require(script.Parent.Mansion)

local Builder = {}

function Builder.build()
	local old = Workspace:FindFirstChild("RibcageWorld")
	if old then
		old:Destroy()
	end
	-- Remove Studio's default baseplate if it is there.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	for _, child in Workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	local root = Instance.new("Folder")
	root.Name = "RibcageWorld"
	root.Parent = Workspace

	local refs = World.build(root)
	local mansionRefs = Mansion.build(root)
	for k, v in mansionRefs do
		refs[k] = v
	end
	refs.root = root
	return refs
end

return Builder
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000A">
        <Properties>
          <string name="Name">Data</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Saves credits, discoveries and upgrades between visits.
-- DataStores only work in a published place with "Enable Studio Access to API
-- Services" turned on; otherwise the game still runs and simply doesn't save.

local DataStoreService = game:GetService("DataStoreService")

local Data = {}

local store = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore("RibcageMansion_v1")
end)
if not ok then
	store = nil
end

export type Profile = {
	credits: number,
	discoveries: { [string]: boolean },
	upgrades: { [string]: boolean },
	fishCaught: number,
	pets: { [string]: boolean },
	activePet: string,
	treats: number,
}

function Data.default(): Profile
	return { credits = 50, discoveries = {}, upgrades = {}, fishCaught = 0, pets = {}, activePet = "", treats = 2 }
end

function Data.load(userId: number): Profile
	local profile = Data.default()
	if not store then
		return profile
	end
	local success, saved = pcall(function()
		return store:GetAsync("u" .. userId)
	end)
	if success and type(saved) == "table" then
		profile.credits = tonumber(saved.credits) or profile.credits
		profile.fishCaught = tonumber(saved.fishCaught) or 0
		for _, id in saved.discoveries or {} do
			profile.discoveries[id] = true
		end
		for _, id in saved.upgrades or {} do
			profile.upgrades[id] = true
		end
		for _, id in saved.pets or {} do
			profile.pets[id] = true
		end
		profile.activePet = type(saved.activePet) == "string" and saved.activePet or ""
		profile.treats = tonumber(saved.treats) or profile.treats
	end
	return profile
end

function Data.save(userId: number, profile: Profile)
	if not store then
		return
	end
	local discoveries, upgrades, pets = {}, {}, {}
	for id in profile.pets do
		table.insert(pets, id)
	end
	for id in profile.discoveries do
		table.insert(discoveries, id)
	end
	for id in profile.upgrades do
		table.insert(upgrades, id)
	end
	pcall(function()
		store:SetAsync("u" .. userId, {
			credits = profile.credits,
			fishCaught = profile.fishCaught,
			discoveries = discoveries,
			upgrades = upgrades,
			pets = pets,
			activePet = profile.activePet,
			treats = profile.treats,
		})
	end)
end

return Data
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000B">
        <Properties>
          <string name="Name">Gameplay</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily life in the mansion: needs, cooking, the pantry, dishes, the bed,
-- plants, reading, the fire, pets, chores, weather, the day/night cycle,
-- fishing for dinner, upgrades and discoveries.

local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Arch = require(Shared:WaitForChild("Arch"))
local Config = require(Shared:WaitForChild("Config"))
local Build = require(script.Parent.Build)
local Data = require(script.Parent.Data)
local Pets = require(script.Parent.Pets)

local Gameplay = {}

local refs
local remotes: any
local profiles: { [Player]: Data.Profile } = {}
local fishInventory: { [Player]: { { name: string, value: number } } } = {}
local pantry: { [Player]: { [string]: number } } = {}
local chores: { [Player]: { [string]: boolean } } = {}
local fishing: { [Player]: { state: string, token: number, biteAt: number? } } = {}
local cooking: { [Player]: { recipe: any, token: number, started: number } } = {}
local cooldowns: { [Player]: { [string]: number } } = {}
local reading: { [Player]: number } = {}

local fireFuel = 80
local dirtyDishes = 0
local bedMessy = true
local day = 1
local weather = Config.WEATHER[1]

local discoveryById, upgradeById, recipeById, petById, choreById = {}, {}, {}, {}, {}
for _, d in Config.DISCOVERIES do
	discoveryById[d.id] = d
end
for _, u in Config.UPGRADES do
	upgradeById[u.id] = u
end
for _, r in Config.RECIPES do
	recipeById[r.id] = r
end
for _, p in Config.PETS do
	petById[p.id] = p
end
for _, c in Config.CHORES do
	choreById[c.id] = c
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

local function remote(name: string, class: string?): Instance
	local r = Instance.new(class or "RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end

local function notify(player: Player, text: string, kind: string?)
	remotes.Notify:FireClient(player, text, kind or "info")
end

local function notifyAll(text: string, kind: string?)
	remotes.Notify:FireAllClients(text, kind or "info")
end

local function onCooldown(player: Player, key: string, seconds: number): boolean
	local list = cooldowns[player]
	if not list then
		return true
	end
	local now = os.clock()
	if list[key] and now < list[key] then
		notify(player, string.format("Give it %d more seconds.", math.ceil(list[key] - now)))
		return true
	end
	list[key] = now + seconds
	return false
end

local function getNeed(player: Player, need: string): number
	return (player:GetAttribute(need) :: number?) or 100
end

local function setNeed(player: Player, need: string, value: number)
	player:SetAttribute(need, math.clamp(value, 0, 100))
end

local function addNeed(player: Player, need: string, delta: number)
	setNeed(player, need, getNeed(player, need) + delta)
end

local function setCredits(player: Player, value: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.credits = value
	player:SetAttribute("Credits", value)
	local stats = player:FindFirstChild("leaderstats")
	local cv = stats and stats:FindFirstChild("Credits")
	if cv then
		cv.Value = value
	end
end

local function addCredits(player: Player, delta: number)
	local profile = profiles[player]
	if profile then
		setCredits(player, profile.credits + delta)
	end
end

local function idList(set: { [string]: boolean }): string
	local ids = {}
	for id in set do
		table.insert(ids, id)
	end
	return table.concat(ids, ",")
end

local function discover(player: Player, id: string)
	local profile = profiles[player]
	local d = discoveryById[id]
	if not profile or not d or profile.discoveries[id] then
		return
	end
	profile.discoveries[id] = true
	player:SetAttribute("Discoveries", idList(profile.discoveries))
	addCredits(player, d.reward)
	notify(player, string.format("Discovered: %s  (+%d credits)", d.name, d.reward), "discovery")
end

local function completeChore(player: Player, id: string)
	local done = chores[player]
	local chore = choreById[id]
	if not done or not chore or done[id] then
		return
	end
	done[id] = true
	player:SetAttribute("Chores", idList(done))
	addCredits(player, chore.reward)
	notify(player, string.format("Routine: %s  (+%d)", chore.name, chore.reward), "chore")
	for _, c in Config.CHORES do
		if not done[c.id] then
			return
		end
	end
	addCredits(player, 40)
	notify(player, "Every part of today's routine done. A good day in the spine (+40).", "discovery")
end

local function syncFish(player: Player)
	local inv = fishInventory[player] or {}
	local value = 0
	for _, f in inv do
		value += f.value
	end
	player:SetAttribute("FishCount", #inv)
	player:SetAttribute("FishValue", value)
end

local function syncPantry(player: Player)
	player:SetAttribute("Pantry", HttpService:JSONEncode(pantry[player] or {}))
end

local function syncTreats(player: Player)
	local profile = profiles[player]
	player:SetAttribute("Treats", profile and profile.treats or 0)
end

local function restockPantry(player: Player)
	local stock = {}
	for _, item in Config.PANTRY do
		stock[item.id] = item.perDay
	end
	pantry[player] = stock
	syncPantry(player)
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function teleport(player: Player, cf: CFrame)
	local character = player.Character
	if not character then
		return
	end
	remotes.Fade:FireClient(player, 0.9)
	task.delay(0.35, function()
		if character.Parent then
			character:PivotTo(cf)
		end
	end)
end

local function ownsUpgrade(player: Player, id: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.upgrades[id] == true
end

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t >= 19.5 or t < 5.5
end

----------------------------------------------------------------------------
-- Travel and the station
----------------------------------------------------------------------------

local function setParka(player: Player, on: boolean)
	player:SetAttribute("Parka", on)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("ParkaShell")
	if old then
		old:Destroy()
	end
	if not on then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local shell = Instance.new("Part")
	shell.Name = "ParkaShell"
	shell.Size = torso.Size * Vector3.new(1.18, 1.25, 1.35)
	shell.CFrame = torso.CFrame * CFrame.new(0, -0.1, 0)
	shell.Color = Color3.fromRGB(58, 54, 50)
	shell.Material = Enum.Material.Fabric
	shell.CanCollide = false
	shell.CanQuery = false
	shell.CanTouch = false
	shell.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = shell
	weld.Part1 = torso
	weld.Parent = shell
	shell.Parent = character
end

local function setupTravel()
	local up = Build.prompt(refs.funicularBottom, "Ride up to the mansion", "Funicular", 0, 12)
	up.Triggered:Connect(function(player)
		teleport(player, refs.funicularTopArrive)
		notify(player, "The funicular hums up the inside of the spine...")
	end)
	local down = Build.prompt(refs.funicularTop, "Ride down to the dock", "Funicular", 0, 12)
	down.Triggered:Connect(function(player)
		teleport(player, refs.funicularBottomArrive)
	end)

	local hatch = Build.prompt(refs.hatch, "Climb onto the spine", "Roof hatch", 0.5, 14)
	hatch.Triggered:Connect(function(player)
		teleport(player, refs.roofArrive)
		notify(player, "Wind, fog and a long way down. A parka helps.", "warn")
	end)
	local roofHatch = Build.part(refs.root, {
		Name = "RoofHatchOutside",
		Size = Vector3.new(4, 0.6, 5),
		CFrame = refs.roofArrive * CFrame.new(0, -3.6, 0) * CFrame.Angles(0, 0, math.atan(Arch.slope(refs.roofArrive.X))),
		Material = Enum.Material.Metal,
		Color = Build.Color.Metal,
	})
	local back = Build.prompt(roofHatch, "Climb back inside", "Roof hatch", 0, 10)
	back.Triggered:Connect(function(player)
		teleport(player, refs.funicularTopArrive)
	end)

	local parka = Build.prompt(refs.parkaRack, "Put on / take off parka", "Coat rack", 0, 10)
	parka.Triggered:Connect(function(player)
		local on = not player:GetAttribute("Parka")
		setParka(player, on)
		notify(player, on and "Parka on. The cold bites much less outside." or "Parka hung back up.")
	end)
end

----------------------------------------------------------------------------
-- Fire, lamps, doors
----------------------------------------------------------------------------

local firePrompts = {}

local function applyFire()
	local fire = refs.fire
	local lit = fireFuel > 0
	fire.fire.Enabled = lit
	fire.light.Enabled = lit
	fire.embers.Enabled = lit
	local k = fireFuel / 100
	fire.fire.Size = 2 + 4 * k
	fire.light.Brightness = 0.8 + 2 * k
	fire.light.Range = 18 + 16 * k
	for _, p in firePrompts do
		p.ActionText = lit and "Add a log" or "Light the fire"
	end
	Workspace:SetAttribute("FireFuel", fireFuel)
end

local function feedFire(player: Player)
	if fireFuel >= 95 then
		notify(player, "The fire is roaring already.")
		return
	end
	local wasOut = fireFuel <= 0
	fireFuel = math.min(100, fireFuel + 45)
	applyFire()
	notify(player, wasOut and "The bowl catches. Warm light spills across the concrete." or "You lay a log on the embers.")
	if isNight() then
		completeChore(player, "fire")
	end
end

local function setupFireAndLights()
	table.insert(firePrompts, Build.prompt(refs.fire.core, "Add a log", "Hanging fireplace", 0.4, 14))
	table.insert(firePrompts, Build.prompt(refs.logBasket, "Add a log", "Log basket", 0.4, 10))
	for _, p in firePrompts do
		p.Triggered:Connect(feedFire)
	end
	applyFire()

	for _, lamp in refs.lamps do
		local p = Build.prompt(lamp.part, "Toggle lamp", "Lamp", 0, 9)
		p.Triggered:Connect(function()
			lamp.light.Enabled = not lamp.light.Enabled
			lamp.part.Material = lamp.light.Enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
		end)
		lamp.part.Material = Enum.Material.Neon
	end

	for _, door in refs.doors do
		local isOpen = false
		local p = Build.prompt(door.part, "Open", "Door", 0, 9)
		p.Triggered:Connect(function()
			isOpen = not isOpen
			p.ActionText = isOpen and "Close" or "Open"
			local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad)
			TweenService:Create(door.part, info, { CFrame = isOpen and door.open or door.closed }):Play()
			local handle = door.part:FindFirstChild("Handle")
			if handle then
				local target = (isOpen and door.open or door.closed) * door.closed:ToObjectSpace(handle.CFrame)
				TweenService:Create(handle, info, { CFrame = target }):Play()
			end
		end)
	end
end

----------------------------------------------------------------------------
-- Home life: bed, shower, plants, books, dishes, pantry, record player
----------------------------------------------------------------------------

local dishParts = {}

local function applyDishes()
	for _, p in dishParts do
		p:Destroy()
	end
	table.clear(dishParts)
	for i = 1, dirtyDishes do
		local p = Build.cylinderY(refs.root, refs.dishSpot + Vector3.new((i % 2) * 1.6, 0.12 + math.floor((i - 1) / 2) * 0.22, 0), 0.2, 1.4, {
			Name = "DirtyPlate",
			Color = Color3.fromRGB(196, 190, 182),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		table.insert(dishParts, p)
	end
end

local function setBedMessy(messy: boolean)
	bedMessy = messy
	TweenService:Create(refs.duvet, TweenInfo.new(0.5), { CFrame = messy and refs.duvetMessy or refs.duvetTidy }):Play()
end

local PLANT_FRESH = Color3.fromRGB(58, 92, 60)
local PLANT_DRY = Color3.fromRGB(92, 92, 62)

local function setPlant(plant, watered: boolean)
	plant.watered = watered
	for _, leaf in plant.leaves:GetChildren() do
		if leaf:IsA("BasePart") then
			leaf.Color = watered and PLANT_FRESH or PLANT_DRY
		end
	end
end

local function setupHome()
	local sleep = Build.prompt(refs.bed, "Sleep", "Bed", 1, 10)
	sleep.Triggered:Connect(function(player)
		remotes.Fade:FireClient(player, 3)
		task.delay(1.5, function()
			setNeed(player, "Energy", 100)
			addNeed(player, "Warmth", 20)
			setBedMessy(true)
			notify(player, "You slept to the sound of ice knocking softly against the ribs.")
		end)
	end)
	local make = Build.prompt(refs.duvet, "Make the bed", "Bed", 0.8, 10)
	make.UIOffset = Vector2.new(0, 70)
	make.KeyboardKeyCode = Enum.KeyCode.F
	make.Triggered:Connect(function(player)
		if not bedMessy then
			notify(player, "The bed is already made. Crisp.")
			return
		end
		setBedMessy(false)
		completeChore(player, "bed")
	end)

	local shower = Build.prompt(refs.showerHead, "Take a rain shower", "Shower", 0.5, 12)
	shower.Triggered:Connect(function(player)
		refs.shower.Enabled = true
		task.delay(6, function()
			refs.shower.Enabled = false
		end)
		setNeed(player, "Hygiene", 100)
		addNeed(player, "Warmth", 10)
		notify(player, "Hot water falling through a shaft of light. Clean.")
	end)
	local sink = Build.prompt(refs.sink, "Wash up", "Stone sink", 0, 8)
	sink.Triggered:Connect(function(player)
		addNeed(player, "Hygiene", 15)
	end)

	for _, plant in refs.plants do
		setPlant(plant, false)
		local p = Build.prompt(plant.pot, "Water plant", "Plant", 0.4, 8)
		p.Triggered:Connect(function(player)
			if plant.watered then
				notify(player, "This one is already watered today.")
				return
			end
			setPlant(plant, true)
			addNeed(player, "Fun", 3)
			completeChore(player, "plants")
		end)
	end

	local book = Build.prompt(refs.bookshelf, "Take a book", "Bookshelf", 0, 9)
	book.Triggered:Connect(function(player)
		player:SetAttribute("HasBook", true)
		notify(player, "You pick a worn paperback. Find a seat near the fire to read.")
	end)

	local wash = Build.prompt(refs.galleySink, "Wash the dishes", "Galley sink", 1.5, 9)
	wash.Triggered:Connect(function(player)
		if dirtyDishes == 0 then
			notify(player, "The sink is empty. Nothing to wash.")
			return
		end
		dirtyDishes = 0
		applyDishes()
		addNeed(player, "Hygiene", 4)
		completeChore(player, "dishes")
		notify(player, "Dishes done, steam on the glass.")
	end)

	local pantryPrompt = Build.prompt(refs.pantry, "Look in the pantry", "Pantry", 0, 9)
	pantryPrompt.Triggered:Connect(function(player)
		remotes.OpenPanel:FireClient(player, "pantry")
	end)

	local fridge = Build.prompt(refs.fridge, "Grab a snack", "Fridge", 0, 8)
	fridge.Triggered:Connect(function(player)
		if onCooldown(player, "snack", 45) then
			return
		end
		addNeed(player, "Hunger", 15)
		notify(player, "Cold cheese and crackers, eaten standing up.")
	end)

	local tea = Build.prompt(refs.kettle, "Make tea", "Kettle", 0.8, 8)
	tea.Triggered:Connect(function(player)
		if onCooldown(player, "tea", 25) then
			return
		end
		refs.steam.Enabled = true
		task.delay(4, function()
			refs.steam.Enabled = false
		end)
		addNeed(player, "Warmth", 15)
		addNeed(player, "Fun", 3)
		notify(player, "Tea. Hold the cup in both hands.")
	end)

	local bowl = Build.prompt(refs.catBowl, "Fill " .. Config.RESIDENT_CAT_NAME .. "'s bowl", "Cat bowl", 0.3, 8)
	bowl.Triggered:Connect(function(player)
		Pets.fillBowl(player)
	end)

	local record = Build.prompt(refs.recordPlayer, "Play a record", "Record player", 0, 9)
	record.Triggered:Connect(function(player)
		if not ownsUpgrade(player, "RecordPlayer") then
			notify(player, "No needle on it. Buy the Record Player at the concierge tablet.", "warn")
			return
		end
		remotes.Music:FireClient(player)
	end)
end

----------------------------------------------------------------------------
-- Cooking
----------------------------------------------------------------------------

local stationParts = {}

local function hasIngredients(player: Player, recipe): (boolean, string?)
	local stock = pantry[player] or {}
	for item, count in recipe.needs do
		if item == "fish" then
			if #(fishInventory[player] or {}) < count then
				return false, string.format("You need %d fish. Try fishing off the dock.", count)
			end
		elseif (stock[item] or 0) < count then
			for _, p in Config.PANTRY do
				if p.id == item then
					return false, "Out of " .. string.lower(p.name) .. " until the pantry restocks in the morning."
				end
			end
			return false, "Missing " .. item
		end
	end
	return true
end

local function consume(player: Player, recipe)
	local stock = pantry[player]
	for item, count in recipe.needs do
		if item == "fish" then
			local inv = fishInventory[player]
			table.sort(inv, function(a, b)
				return a.value > b.value
			end)
			for _ = 1, count do
				table.remove(inv)
			end
			syncFish(player)
		else
			stock[item] -= count
		end
	end
	syncPantry(player)
end

local function anyoneCooking(): boolean
	for _ in cooking do
		return true
	end
	return false
end

local function setupCooking()
	stationParts.stove = refs.stove
	stationParts.oven = refs.oven
	stationParts.coffee = refs.coffee
	local labels = { stove = "Cook on the stove", oven = "Bake in the oven", coffee = "Make coffee" }
	local names = { stove = "Stove", oven = "Oven", coffee = "Coffee machine" }
	for station, part in stationParts do
		local p = Build.prompt(part, labels[station], names[station], 0, 9)
		p.Triggered:Connect(function(player)
			remotes.OpenPanel:FireClient(player, "cook", station)
		end)
	end

	remotes.StartCooking.OnServerInvoke = function(player: Player, recipeId: any)
		local recipe = type(recipeId) == "string" and recipeById[recipeId] or nil
		if not recipe then
			return false, "Unknown recipe."
		end
		local hrp = rootPart(player)
		local station = stationParts[recipe.station]
		if not hrp or (hrp.Position - station.Position).Magnitude > 16 then
			return false, "Stand at the " .. recipe.station .. " to make that."
		end
		if cooking[player] then
			return false, "You're already cooking something."
		end
		local ok, why = hasIngredients(player, recipe)
		if not ok then
			return false, why
		end
		consume(player, recipe)
		local token = math.random(1, 1e9)
		cooking[player] = { recipe = recipe, token = token, started = os.clock() }
		if recipe.station ~= "coffee" then
			refs.steam.Enabled = true
		end
		return true, token
	end

	remotes.FinishCooking.OnServerInvoke = function(player: Player, token: any, scores: any)
		local session = cooking[player]
		cooking[player] = nil
		if not anyoneCooking() then
			refs.steam.Enabled = false
		end
		if not session or session.token ~= token or type(scores) ~= "table" then
			return nil
		end
		local recipe = session.recipe
		local total = 0
		for i = 1, #recipe.steps do
			total += math.clamp(tonumber(scores[i]) or 0, 0, 1)
		end
		local quality = total / #recipe.steps
		-- Each step takes real time to play; ignore impossibly fast results.
		if os.clock() - session.started < #recipe.steps * 0.6 then
			quality = math.min(quality, 0.3)
		end
		local label = quality >= 0.9 and "Perfect" or quality >= 0.65 and "Delicious" or quality >= 0.35 and "Decent" or "Slightly burnt"
		local mult = 0.55 + 0.65 * quality
		for need, amount in recipe.effects do
			addNeed(player, need, amount * mult)
		end
		if recipe.makesTreats then
			local profile = profiles[player]
			profile.treats += recipe.makesTreats
			syncTreats(player)
		end
		if recipe.station == "coffee" then
			completeChore(player, "coffee")
		elseif not recipe.makesTreats then
			completeChore(player, "cook")
		end
		if recipe.station ~= "coffee" then
			dirtyDishes = math.min(Config.MAX_DIRTY_DISHES, dirtyDishes + (#recipe.steps >= 4 and 2 or 1))
			applyDishes()
		end
		discover(player, "firstmeal")
		return { name = recipe.name, quality = label }
	end
end

----------------------------------------------------------------------------
-- Upgrades and pets (concierge tablet)
----------------------------------------------------------------------------

local function setupConcierge()
	local shop = Build.prompt(refs.tablet, "Open concierge", "Upgrades & pets", 0, 10)
	shop.Triggered:Connect(function(player)
		remotes.OpenPanel:FireClient(player, "shop")
	end)

	remotes.BuyUpgrade.OnServerInvoke = function(player: Player, id: any)
		local profile = profiles[player]
		local upgrade = type(id) == "string" and upgradeById[id] or nil
		if not profile or not upgrade then
			return false, "Unknown upgrade."
		end
		if profile.upgrades[id] then
			return false, "You already own that."
		end
		if profile.credits < upgrade.price then
			return false, "Not enough credits."
		end
		setCredits(player, profile.credits - upgrade.price)
		profile.upgrades[id] = true
		player:SetAttribute("Up_" .. id, true)
		notify(player, "Installed: " .. upgrade.name, "discovery")
		task.spawn(Data.save, player.UserId, profile)
		return true, "Installed!"
	end

	remotes.AdoptPet.OnServerInvoke = function(player: Player, id: any)
		local profile = profiles[player]
		local pet = type(id) == "string" and petById[id] or nil
		if not profile or not pet then
			return false, "Unknown pet."
		end
		if not profile.pets[id] then
			if profile.credits < pet.price then
				return false, "Not enough credits."
			end
			setCredits(player, profile.credits - pet.price)
			profile.pets[id] = true
			player:SetAttribute("Pet_" .. id, true)
			notify(player, "Welcome home, little " .. string.lower(pet.name) .. ".", "discovery")
		end
		-- Choosing an adopted pet toggles whether it walks with you.
		local newActive = profile.activePet == id and "" or id
		profile.activePet = newActive
		player:SetAttribute("ActivePet", newActive)
		Pets.setActive(player, newActive ~= "" and newActive or nil)
		task.spawn(Data.save, player.UserId, profile)
		return true, newActive ~= "" and "Walking with you." or "Resting at home."
	end

	local scope = Build.prompt(refs.telescope, "Look through telescope", "Telescope", 0, 10)
	scope.Triggered:Connect(function(player)
		if not ownsUpgrade(player, "Telescope") then
			notify(player, "It's capped. Buy the Roof Telescope at the concierge tablet.", "warn")
			return
		end
		remotes.Telescope:FireClient(player, refs.telescope.Position + Vector3.new(0, 4, 0))
	end)
end

----------------------------------------------------------------------------
-- Fishing (ingredients for dinner) and selling the extras
----------------------------------------------------------------------------

local function rollFish(player: Player)
	local golden = ownsUpgrade(player, "GoldenRod")
	local function weight(f): number
		return (golden and f.value >= 30) and f.weight * 3 or f.weight
	end
	local total = 0
	for _, f in Config.FISH do
		total += weight(f)
	end
	local roll = math.random() * total
	for _, f in Config.FISH do
		roll -= weight(f)
		if roll <= 0 then
			return f
		end
	end
	return Config.FISH[1]
end

local function setupFishing()
	local cast = Build.prompt(refs.fishSpot, "Cast line", "Fishing spot", 0, 10)
	cast.Triggered:Connect(function(player)
		if fishing[player] then
			return
		end
		local token = math.random(1, 1e9)
		fishing[player] = { state = "waiting", token = token }
		remotes.Fishing:FireClient(player, "cast")
		local wait = math.random() * (Config.FISH_BITE_MAX - Config.FISH_BITE_MIN) + Config.FISH_BITE_MIN
		if ownsUpgrade(player, "GoldenRod") then
			wait *= 0.5
		end
		task.delay(wait, function()
			local f = fishing[player]
			if not f or f.token ~= token then
				return
			end
			local hrp = rootPart(player)
			if not hrp or (hrp.Position - refs.fishSpot.Position).Magnitude > 25 then
				fishing[player] = nil
				remotes.Fishing:FireClient(player, "left")
				return
			end
			f.state = "bite"
			f.biteAt = os.clock()
			remotes.Fishing:FireClient(player, "bite")
			task.delay(Config.FISH_REEL_WINDOW + 0.3, function()
				local g = fishing[player]
				if g and g.token == token and g.state == "bite" then
					fishing[player] = nil
					remotes.Fishing:FireClient(player, "miss")
				end
			end)
		end)
	end)

	remotes.Fishing.OnServerEvent:Connect(function(player, action)
		if action ~= "reel" then
			return
		end
		local f = fishing[player]
		if not f then
			return
		end
		fishing[player] = nil
		if f.state == "waiting" then
			remotes.Fishing:FireClient(player, "early")
			return
		end
		if f.state == "bite" and f.biteAt and os.clock() - f.biteAt <= Config.FISH_REEL_WINDOW + 0.25 then
			local fish = rollFish(player)
			table.insert(fishInventory[player], { name = fish.name, value = fish.value })
			syncFish(player)
			profiles[player].fishCaught += 1
			remotes.Fishing:FireClient(player, "catch", fish.name, fish.value)
			discover(player, "firstfish")
		else
			remotes.Fishing:FireClient(player, "miss")
		end
	end)

	local sell = Build.prompt(refs.fishCrate, "Sell your fish", "Fish crate", 0, 10)
	sell.Triggered:Connect(function(player)
		local inv = fishInventory[player]
		if not inv or #inv == 0 then
			notify(player, "Your bucket is empty.", "warn")
			return
		end
		local total = 0
		for _, f in inv do
			total += f.value
		end
		local count = #inv
		table.clear(inv)
		syncFish(player)
		addCredits(player, total)
		notify(player, string.format("Sold %d fish for %d credits.", count, total), "discovery")
	end)
end

----------------------------------------------------------------------------
-- Whale breaches (rare, far out in the fog)
----------------------------------------------------------------------------

local function buildWhaleTemplate()
	local model = Instance.new("Model")
	model.Name = "WhaleTemplate"
	local template = Build.asset("Whale")
	local origin = CFrame.new()
	local core = Build.part(model, {
		Name = "Core",
		Size = Vector3.new(12, 10, 46),
		CFrame = origin,
		Transparency = 1,
		CanCollide = false,
	})
	if template then
		Build.placeAsset(template, model, origin, Vector3.new(24, 10, 49), { CanCollide = false })
	else
		local dark = Color3.fromRGB(42, 46, 52)
		Build.ellipsoid(model, origin, Vector3.new(11, 9, 44), { Name = "Body", Color = dark, CanCollide = false })
		Build.ellipsoid(model, origin * CFrame.new(0, -2.4, -4), Vector3.new(8.5, 5, 32), { Name = "Belly", Color = Color3.fromRGB(150, 152, 156), CanCollide = false })
		for _, side in { -1, 1 } do
			Build.ellipsoid(model, origin * CFrame.new(side * 8, -2, -8) * CFrame.Angles(0, side * 0.5, side * 0.4), Vector3.new(12, 1, 3.5), {
				Name = "Flipper",
				Color = dark,
				CanCollide = false,
			})
			Build.ellipsoid(model, origin * CFrame.new(side * 4, 0, 23) * CFrame.Angles(0, side * 0.5, 0), Vector3.new(9, 0.8, 4), {
				Name = "Fluke",
				Color = dark,
				CanCollide = false,
			})
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	model.PrimaryPart = core
	model.Parent = ReplicatedStorage
end

local function compassWord(v: Vector3): string
	local angle = math.deg(math.atan2(v.X, -v.Z)) % 360
	local names = { "north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west" }
	return names[(math.floor((angle + 22.5) / 45) % 8) + 1]
end

local function whaleLoop()
	while true do
		task.wait(math.random(Config.WHALE_MIN_INTERVAL, Config.WHALE_MAX_INTERVAL))
		if weather.id ~= "Blizzard" then
			local angle = math.random() * math.pi * 2
			local dist = 220 + math.random() * 320
			local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			remotes.Whale:FireAllClients(pos, math.random() * math.pi * 2)
			notifyAll("Something huge breaks the surface to the " .. compassWord(pos) .. "...", "discovery")
			for _, player in Players:GetPlayers() do
				discover(player, "whale")
			end
		end
	end
end

----------------------------------------------------------------------------
-- Weather, days and the per-second tick
----------------------------------------------------------------------------

local function pickWeather()
	local total = 0
	for _, w in Config.WEATHER do
		if w ~= weather then
			total += w.weight
		end
	end
	local roll = math.random() * total
	for _, w in Config.WEATHER do
		if w ~= weather then
			roll -= w.weight
			if roll <= 0 then
				return w
			end
		end
	end
	return Config.WEATHER[1]
end

local function weatherLoop()
	Workspace:SetAttribute("Weather", weather.id)
	while true do
		task.wait(math.random(Config.WEATHER_MIN_SECONDS, Config.WEATHER_MAX_SECONDS))
		weather = pickWeather()
		Workspace:SetAttribute("Weather", weather.id)
		local lines = {
			Mist = "Sea mist rolls in and swallows the ribs.",
			Still = "The fog thins. The sea goes perfectly still.",
			Snow = "It starts to snow over the Southern Ocean.",
			Blizzard = "A blizzard is coming in. Best to be inside, near the fire.",
		}
		notifyAll(lines[weather.id] or weather.name, weather.id == "Blizzard" and "warn" or "info")
	end
end

local function newDay()
	day += 1
	Workspace:SetAttribute("Day", day)
	setBedMessy(true)
	for _, plant in refs.plants do
		setPlant(plant, false)
	end
	for _, player in Players:GetPlayers() do
		if profiles[player] then
			restockPantry(player)
			chores[player] = {}
			reading[player] = 0
			player:SetAttribute("Chores", "")
		end
	end
	notifyAll(string.format("Morning, day %d. The pantry has been restocked and the plants are thirsty.", day), "chore")
end

local function inBox(pos: Vector3, minV: Vector3, maxV: Vector3): boolean
	return pos.X >= minV.X and pos.X <= maxV.X and pos.Y >= minV.Y and pos.Y <= maxV.Y and pos.Z >= minV.Z and pos.Z <= maxV.Z
end

local function rescue(player: Player)
	setNeed(player, "Warmth", 45)
	teleport(player, CFrame.new(refs.galleryCenter + Vector3.new(6, 4, -2)))
	notify(player, "You got dangerously cold, and found your way back to the fire.", "warn")
end

local function tickPlayer(player: Player)
	local character = player.Character
	local hrp = rootPart(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return
	end
	local pos = hrp.Position
	local room = Arch.roomAt(pos)
	local swimming = humanoid:GetState() == Enum.HumanoidStateType.Swimming
	local inPool = inBox(pos, refs.poolMin - Vector3.new(1, 2, 1), refs.poolMax + Vector3.new(1, 4, 1))
	local onRoof = room == nil
		and math.abs(pos.Z) < Arch.W / 2 + 2
		and math.abs(pos.X) < Arch.A * 0.95
		and pos.Y > Arch.yAt(pos.X) + Arch.T / 2 - 2
	local inSea = room == nil and pos.Y < 3 and swimming
	local fireDist = (pos - refs.fireplacePos).Magnitude
	local nearFire = fireFuel > 0 and fireDist < Config.WARMTH.fireplaceRange
	local parka = player:GetAttribute("Parka") == true
	local W = Config.WARMTH
	local storm = weather.id == "Blizzard" and W.blizzardMultiplier or 1

	local warmth = getNeed(player, "Warmth")
	if nearFire then
		warmth += W.fireplaceGain * (0.4 + 0.6 * fireFuel / 100)
	elseif inPool and swimming and ownsUpgrade(player, "HeatedPool") then
		warmth += W.heatedPoolGain
	elseif room then
		if warmth < W.indoorsCap then
			warmth = math.min(W.indoorsCap, warmth + W.indoorsGain)
		end
	elseif inSea then
		warmth -= W.seaLoss
	elseif onRoof then
		warmth -= (parka and W.parkaRoofLoss or W.roofLoss) * storm
	else
		warmth -= (parka and W.parkaOutdoorsLoss or W.outdoorsLoss) * storm
	end
	setNeed(player, "Warmth", warmth)

	local hungerEmpty = getNeed(player, "Hunger") <= 0
	local energyDelta = -Config.NEED_DECAY.Energy * (hungerEmpty and 2 or 1)
	local seated = humanoid.SeatPart ~= nil
	if seated then
		energyDelta = Config.SEAT_ENERGY_GAIN
	end
	addNeed(player, "Energy", energyDelta)
	addNeed(player, "Hunger", -Config.NEED_DECAY.Hunger)
	addNeed(player, "Hygiene", -Config.NEED_DECAY.Hygiene)

	local fun = -Config.NEED_DECAY.Fun
	if inPool and swimming then
		fun = Config.POOL_FUN_GAIN
	end
	-- Reading in a seat near the fire.
	local isReading = seated and player:GetAttribute("HasBook") == true and fireDist < 30
	player:SetAttribute("Reading", isReading)
	if isReading then
		fun = Config.READING_FUN_GAIN
		reading[player] = (reading[player] or 0) + 1
		if reading[player] >= 20 then
			completeChore(player, "read")
		end
	end
	addNeed(player, "Fun", fun)

	humanoid.WalkSpeed = getNeed(player, "Energy") < 10 and 10 or 16
	player:SetAttribute("Location", room and room.name or (onRoof and "Top of the Spine" or (inSea and "In the Southern Ocean" or "Outside")))

	if (pos - refs.dockCenter).Magnitude < 45 then
		discover(player, "dock")
	end
	if room then
		if room.id == "gallery" then
			discover(player, "gallery")
		elseif room.id == "lounge" then
			discover(player, "glassfloor")
		end
		if weather.id == "Blizzard" and pos.Z < -8 then
			discover(player, "blizzard")
		end
	end
	if inPool and swimming then
		discover(player, "pool")
	end
	if fireDist < 14 then
		discover(player, "fireplace")
	end
	if onRoof then
		discover(player, "roof")
	end
	local clock = Lighting.ClockTime
	if clock > 5.6 and clock < 7.2 then
		discover(player, "dawn")
	end

	if getNeed(player, "Warmth") <= 0 then
		rescue(player)
	end
end

local function secondLoop()
	while true do
		task.wait(1)
		-- The fire slowly burns down.
		if fireFuel > 0 then
			fireFuel = math.max(0, fireFuel - 0.12)
			if fireFuel == 0 then
				notifyAll("The fireplace has burned down to ash. Someone add a log?", "warn")
			end
			applyFire()
		end
		for _, player in Players:GetPlayers() do
			if profiles[player] then
				local ok, err = pcall(tickPlayer, player)
				if not ok then
					warn("[Ribcage] tick failed:", err)
				end
			end
		end
	end
end

local function dayCycle()
	local rate = 24 / (Config.DAY_LENGTH_MINUTES * 60)
	Lighting.ClockTime = Config.START_CLOCK_TIME
	Workspace:SetAttribute("Day", day)
	RunService.Heartbeat:Connect(function(dt)
		local before = Lighting.ClockTime
		local after = (before + dt * rate) % 24
		Lighting.ClockTime = after
		Workspace:SetAttribute("Night", isNight())
		if before < 6 and after >= 6 then
			newDay()
		end
	end)
end

----------------------------------------------------------------------------
-- Players
----------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local profile = Data.load(player.UserId)
	profiles[player] = profile
	fishInventory[player] = {}
	cooldowns[player] = {}
	chores[player] = {}
	restockPantry(player)

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local credits = Instance.new("IntValue")
	credits.Name = "Credits"
	credits.Value = profile.credits
	credits.Parent = stats
	stats.Parent = player

	for _, need in Config.NEEDS do
		player:SetAttribute(need, need == "Warmth" and 80 or 85)
	end
	player:SetAttribute("Credits", profile.credits)
	player:SetAttribute("Parka", false)
	player:SetAttribute("Chores", "")
	for id in profile.upgrades do
		player:SetAttribute("Up_" .. id, true)
	end
	for id in profile.pets do
		player:SetAttribute("Pet_" .. id, true)
	end
	player:SetAttribute("ActivePet", profile.activePet)
	player:SetAttribute("Discoveries", idList(profile.discoveries))
	syncFish(player)
	syncTreats(player)

	player.CharacterAdded:Connect(function()
		task.wait(0.3)
		if player:GetAttribute("Parka") then
			setParka(player, true)
		end
		if profile.activePet ~= "" then
			Pets.setActive(player, profile.activePet)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		Data.save(player.UserId, profile)
	end
	profiles[player] = nil
	fishInventory[player] = nil
	pantry[player] = nil
	chores[player] = nil
	fishing[player] = nil
	cooking[player] = nil
	cooldowns[player] = nil
	reading[player] = nil
end

function Gameplay.start(builtRefs)
	refs = builtRefs
	refs.fireLit = function()
		return fireFuel > 0
	end

	local old = ReplicatedStorage:FindFirstChild("Remotes")
	if old then
		old:Destroy()
	end
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	for _, name in { "Notify", "Fade", "Fishing", "OpenPanel", "Telescope", "Whale", "Music" } do
		remote(name)
	end
	for _, name in { "BuyUpgrade", "AdoptPet", "StartCooking", "FinishCooking" } do
		remote(name, "RemoteFunction")
	end
	remotes.Parent = ReplicatedStorage

	buildWhaleTemplate()
	setupTravel()
	setupFireAndLights()
	setupHome()
	setupCooking()
	setupConcierge()
	setupFishing()
	Pets.start(refs, {
		notify = notify,
		discover = discover,
		addNeed = addNeed,
		onCooldown = onCooldown,
		completeChore = completeChore,
		useTreat = function(player: Player): boolean
			local profile = profiles[player]
			if not profile or profile.treats <= 0 then
				return false
			end
			profile.treats -= 1
			syncTreats(player)
			return true
		end,
	})

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(function()
		for player, profile in profiles do
			Data.save(player.UserId, profile)
		end
	end)

	dayCycle()
	task.spawn(secondLoop)
	task.spawn(weatherLoop)
	task.spawn(whaleLoop)
end

return Gameplay
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000C">
        <Properties>
          <string name="Name">Mansion</string>
          <ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the Ribcage Mansion itself: the concrete spine arch, the hanging ribs
-- and the furnished glass gallery inside the crown.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = require(script.Parent.Build)
local Arch = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Arch"))

local Mansion = {}

local C = Build.Color
local A, W, T = Arch.A, Arch.W, Arch.T
local GZ, BZ = Arch.GLASS_Z, Arch.BACK_Z
local STEP_RUN = 1.25
local STEP_RISE = 0.8

local function isGlassFloorX(x: number): boolean
	for _, room in Arch.ROOMS do
		if room.glassFloor and x >= room.x0 and x <= room.x1 then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------------
-- The spine
----------------------------------------------------------------------------

local function concreteColor(y: number): Color3
	-- Darker, wet-stained concrete near the waterline, like the video.
	local k = math.clamp((y - 5) / 45, 0, 1)
	return C.ConcreteDark:Lerp(C.ConcreteOut, k)
end

local function buildSpine(folder: Instance)
	local N = Arch.SEGMENTS
	for i = 0, N - 1 do
		local t1 = math.pi * i / N
		local t2 = math.pi * (i + 1) / N
		local p1, p2 = Arch.point(t1), Arch.point(t2)
		local mid = (p1 + p2) / 2
		local tangent = (p2 - p1).Unit
		local len = (p2 - p1).Magnitude + 1.2
		local normal = Vector3.new(tangent.Y, -tangent.X, 0)
		-- Local X = world Z (spine width), local Y = outward normal, local Z = along the curve.
		local cf = CFrame.fromMatrix(mid, Vector3.zAxis, normal)

		if math.abs(mid.X) < Arch.HABITAT_HALF then
			local glassFloor = isGlassFloorX(mid.X)
			Build.part(folder, {
				Name = "FloorSlab",
				Size = Vector3.new(W, Arch.SLAB, len),
				CFrame = cf * CFrame.new(0, -T / 2 + Arch.SLAB / 2, 0),
				Material = glassFloor and Enum.Material.Glass or Enum.Material.Concrete,
				Color = glassFloor and C.Glass or C.ConcreteOut,
				Transparency = glassFloor and 0.55 or 0,
			})
			Build.part(folder, {
				Name = "RoofSlab",
				Size = Vector3.new(W, Arch.SLAB, len),
				CFrame = cf * CFrame.new(0, T / 2 - Arch.SLAB / 2, 0),
				Material = Enum.Material.Concrete,
				Color = C.ConcreteOut,
			})
			Build.part(folder, {
				Name = "BackWall",
				Size = Vector3.new(2, T - 2 * Arch.SLAB, len),
				CFrame = cf * CFrame.new(W / 2 - 1, 0, 0),
				Material = Enum.Material.Concrete,
				Color = C.ConcreteIn,
			})
			Build.part(folder, {
				Name = "Glass",
				Size = Vector3.new(0.6, T - 2 * Arch.SLAB, len),
				CFrame = cf * CFrame.new(-W / 2 + 0.3, 0, 0),
				Material = Enum.Material.Glass,
				Color = C.Glass,
				Transparency = 0.82,
				CastShadow = false,
			})
			if i % 2 == 0 then
				Build.part(folder, {
					Name = "Mullion",
					Size = Vector3.new(0.8, T - 2 * Arch.SLAB, 0.3),
					CFrame = cf * CFrame.new(-W / 2 + 0.4, 0, len / 2 - 0.6),
					Material = Enum.Material.Metal,
					Color = C.Metal,
				})
			end
		else
			Build.part(folder, {
				Name = "Spine",
				Size = Vector3.new(W, T, len),
				CFrame = cf,
				Material = Enum.Material.Concrete,
				Color = concreteColor(mid.Y),
			})
		end
	end

	-- Legs continue down into the sea.
	for _, side in { -1, 1 } do
		Build.part(folder, {
			Name = "Footing",
			Size = Vector3.new(T, 46, W),
			CFrame = CFrame.new(side * A, -22, 0),
			Material = Enum.Material.Concrete,
			Color = C.ConcreteDark,
		})
	end
end

----------------------------------------------------------------------------
-- The ribs
----------------------------------------------------------------------------

local function ribShape(t: number)
	local attach = Arch.point(t) + Arch.normal(t) * (T / 2 - 3) + Vector3.new(0, 0, -W / 2 + 3)
	local s = math.sin(t)
	local down = attach.Y * 0.58
	local out = 18 + 78 * s ^ 1.3
	return attach, down, out
end

local function buildRibs(folder: Instance)
	local template = Build.asset("Rib")
	for i = 0, Arch.RIB_COUNT - 1 do
		local t = Arch.RIB_T_MIN + (Arch.RIB_T_MAX - Arch.RIB_T_MIN) * i / (Arch.RIB_COUNT - 1)
		local attach, down, out = ribShape(t)
		if template then
			-- Blender rib: a quarter-curve normalised to a unit box, root at the
			-- top +Z corner and tip at the bottom -Z corner (see blender/README).
			local center = attach + Vector3.new(0, -down / 2, -out / 2)
			Build.placeAsset(template, folder, CFrame.new(center), Vector3.new(6, down, out), {
				Material = Enum.Material.Concrete,
				Color = C.ConcreteOut,
			})
		else
			local SEG = 14
			local prev = attach
			for k = 1, SEG do
				local u = k / SEG
				local a = u * math.pi / 2
				local p = attach + Vector3.new(0, -down * (1 - math.cos(a)), -out * math.sin(a))
				local taper = 1 - (k - 1) / SEG
				local w = 1 + 5.5 * taper
				local d = 1.4 + 7.5 * taper
				local seg = Build.beam(folder, prev, p, w, d, {
					Name = "Rib",
					Material = Enum.Material.Concrete,
					Color = C.ConcreteOut,
				}, Vector3.xAxis)
				-- Overlap the joints a little so the curve looks continuous.
				seg.Size += Vector3.new(0, 0, 1)
				prev = p
			end
		end
	end
end

----------------------------------------------------------------------------
-- Rooms
----------------------------------------------------------------------------

local function floorPart(folder: Instance, x0: number, x1: number, z0: number, z1: number, top: number, bottom: number, glass: boolean?)
	return Build.box(folder, Vector3.new(x0, bottom, z0), Vector3.new(x1, top, z1), {
		Name = glass and "GlassFloor" or "Floor",
		Material = glass and Enum.Material.Glass or Enum.Material.Concrete,
		Color = glass and C.Glass or C.Floor,
		Transparency = glass and 0.5 or 0,
		Reflectance = glass and 0 or 0.06,
	})
end

local function seat(folder: Instance, pos: Vector3, look: Vector3, size: Vector3?, color: Color3?)
	return Build.part(folder, {
		ClassName = "Seat",
		Name = "Seat",
		Size = size or Vector3.new(3.6, 1, 3.6),
		CFrame = CFrame.lookAt(pos, pos + look),
		Material = Enum.Material.Fabric,
		Color = color or C.Fabric,
	})
end

local function paperLamp(folder: Instance, base: Vector3, height: number, refs)
	local shade = Build.cylinderY(folder, base + Vector3.new(0, height / 2, 0), height, 1.8, {
		Name = "PaperLamp",
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 226, 180),
		Transparency = 0.05,
	})
	local light = Build.pointLight(shade, C.Warm, 22, 1.4)
	table.insert(refs.lamps, { part = shade, light = light })
	return shade
end

local function cubeLamp(folder: Instance, pos: Vector3, refs)
	local cube = Build.part(folder, {
		Name = "CubeLamp",
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = CFrame.new(pos),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 220, 170),
	})
	local light = Build.pointLight(cube, C.Warm, 14, 1.2)
	table.insert(refs.lamps, { part = cube, light = light })
	return cube
end

local function surface(refs, x0: number, x1: number, z0: number, z1: number, top: number)
	table.insert(refs.catSurfaces, { x0 = math.min(x0, x1), x1 = math.max(x0, x1), z0 = math.min(z0, z1), z1 = math.max(z0, z1), top = top })
end

local function plant(folder: Instance, base: Vector3, refs)
	local pot = Build.cylinderY(folder, base + Vector3.new(0, 1.2, 0), 2.4, 2.2, {
		Name = "PlantPot",
		Material = Enum.Material.Concrete,
		Color = C.ConcreteIn,
	})
	local leaves = Instance.new("Model")
	leaves.Name = "Leaves"
	local rng = Random.new(math.floor(base.X * 7 + base.Z))
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		Build.ellipsoid(leaves, CFrame.new(base + Vector3.new(math.cos(a) * 0.9, 3.2 + rng:NextNumber(0, 1.6), math.sin(a) * 0.9))
			* CFrame.Angles(math.sin(a) * 0.6, a, math.cos(a) * 0.6), Vector3.new(0.9, 0.25, 2.6), {
			Name = "Leaf",
			Color = Color3.fromRGB(58, 92, 60),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	leaves.Parent = folder
	table.insert(refs.plants, { pot = pot, leaves = leaves })
end

local function wallStrip(folder: Instance, room, floorY: number)
	local farX = math.abs(room.x0) > math.abs(room.x1) and room.x0 or room.x1
	local y = math.min(floorY + 13, Arch.ceilingAt(farX) - 1.2)
	local strip = Build.box(folder, Vector3.new(room.x0 + 1, y, BZ - 0.4), Vector3.new(room.x1 - 1, y + 0.3, BZ), {
		Name = "LightSlot",
		Material = Enum.Material.Neon,
		Color = C.Warm,
		CastShadow = false,
	})
	Build.surfaceLight(strip, Enum.NormalId.Bottom, C.Warm, 18, 0.9, 70)
end

local function steps(folder: Instance, boundary: number, leftY: number, rightY: number)
	local d = math.abs(leftY - rightY)
	if d < 0.35 then
		return
	end
	local n = math.ceil(d / STEP_RISE)
	local rise = d / n
	local high = math.max(leftY, rightY)
	local low = math.min(leftY, rightY)
	local dir = rightY < leftY and 1 or -1 -- steps go into the lower room
	for k = 1, n - 1 do
		local xa = boundary + dir * (k - 1) * STEP_RUN
		local xb = boundary + dir * k * STEP_RUN
		Build.box(folder, Vector3.new(xa, low - 1, GZ), Vector3.new(xb, high - k * rise, BZ), {
			Name = "Step",
			Material = Enum.Material.Concrete,
			Color = C.Floor,
			Reflectance = 0.05,
		})
	end
end

local DOOR_Z0, DOOR_Z1, DOOR_H = 5, 13, 10

local function partition(folder: Instance, boundary: number, leftY: number, rightY: number, hingeZ: number, refs)
	local low = math.min(leftY, rightY)
	local high = math.max(leftY, rightY)
	local top = Arch.ceilingAt(boundary) + 1
	local props = { Name = "Partition", Material = Enum.Material.Concrete, Color = C.ConcreteIn }
	Build.box(folder, Vector3.new(boundary - 0.5, low - 1, GZ), Vector3.new(boundary + 0.5, top, DOOR_Z0), props)
	Build.box(folder, Vector3.new(boundary - 0.5, low - 1, DOOR_Z1), Vector3.new(boundary + 0.5, top, BZ), props)
	Build.box(folder, Vector3.new(boundary - 0.5, high + DOOR_H, DOOR_Z0), Vector3.new(boundary + 0.5, top, DOOR_Z1), props)

	-- A tall timber door that swings into the higher room.
	local dir = hingeZ == DOOR_Z0 and 1 or -1
	local hinge = CFrame.new(boundary, high + DOOR_H / 2, hingeZ)
	local closed = hinge * CFrame.new(0, 0, dir * 4)
	local swingSign = rightY < leftY and 1 or -1 -- open toward the higher (left) room
	local open = hinge * CFrame.Angles(0, -dir * swingSign * math.pi / 2, 0) * CFrame.new(0, 0, dir * 4)
	local door = Build.part(folder, {
		Name = "Door",
		Size = Vector3.new(0.6, DOOR_H, 8),
		CFrame = closed,
		Material = Enum.Material.Wood,
		Color = C.Wood,
	})
	Build.part(door, {
		Name = "Handle",
		Size = Vector3.new(1.2, 0.3, 0.3),
		CFrame = closed * CFrame.new(0, 0, dir * 3.2),
		Material = Enum.Material.Metal,
		Color = C.Metal,
		CanCollide = false,
	})
	table.insert(refs.doors, { part = door, closed = closed, open = open })
end

local function roomFurniture(folder: Instance, room, L: number, refs)
	local id = room.id
	local function v(x: number, y: number, z: number): Vector3
		return Vector3.new(x, L + y, z)
	end

	if id == "station" then
		-- Funicular doors set into the west end.
		local door = Build.box(folder, v(-111.6, 0, -6), v(-110.8, 11, 6), {
			Name = "FunicularDoor",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		for _, z in { -6.4, 6.4 } do
			Build.box(folder, v(-111.4, 0, z - 0.2), v(-110.6, 11.4, z + 0.2), {
				Name = "DoorFrameLight",
				Material = Enum.Material.Neon,
				Color = C.Warm,
			})
		end
		refs.funicularTop = door
		refs.funicularTopArrive = CFrame.new(v(-105, 3, 0)) * CFrame.Angles(0, -math.pi / 2, 0)

		-- Bench along the glass and a parka rack on the back wall.
		surface(refs, -108, -101, -16.6, -13.6, L + 1.8)
		refs.catSpots.window = v(-104, 1.8, -15)
		plant(folder, v(-98, 0, 14), refs)
		Build.box(folder, v(-108, 0, -16.6), v(-101, 1.8, -13.6), {
			Name = "Bench",
			Material = Enum.Material.Wood,
			Color = C.Wood,
		})
		local rack = Build.box(folder, v(-108, 7, 15.2), v(-101, 7.4, 15.6), {
			Name = "ParkaRack",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		local parkaColors = { Color3.fromRGB(190, 70, 40), Color3.fromRGB(230, 230, 225), Color3.fromRGB(40, 50, 60) }
		for i, col in parkaColors do
			Build.box(folder, v(-107.5 + i * 1.8, 2.6, 14.4), v(-106.3 + i * 1.8, 7, 15.4), {
				Name = "Parka",
				Material = Enum.Material.Fabric,
				Color = col,
			})
		end
		refs.parkaRack = rack

		-- Ladder up to a roof hatch.
		local ceil = Arch.ceilingAt(-104)
		for _, z in { 9.5, 12.5 } do
			Build.box(folder, Vector3.new(-104.2, L, z - 0.2), Vector3.new(-103.8, ceil, z + 0.2), {
				Name = "LadderRail",
				Material = Enum.Material.Metal,
				Color = C.Metal,
			})
		end
		for y = L + 1, ceil - 1, 1.6 do
			Build.box(folder, Vector3.new(-104.2, y, 9.5), Vector3.new(-103.8, y + 0.2, 12.5), {
				Name = "Rung",
				Material = Enum.Material.Metal,
				Color = C.Metal,
				CanCollide = false,
			})
		end
		local hatch = Build.box(folder, Vector3.new(-106, ceil - 0.4, 8.5), Vector3.new(-102, ceil, 13.5), {
			Name = "RoofHatch",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		refs.hatch = hatch
		local roofX = -100
		refs.roofArrive = CFrame.new(roofX, Arch.yAt(roofX) + T / 2 * math.sqrt(1 + Arch.slope(roofX) ^ 2) + 4, 4)
	elseif id == "lounge" then
		for _, x in { -80, -73 } do
			Build.box(folder, v(x - 2, 0, -15), v(x + 2, 0.8, -8), {
				Name = "ChaiseBase",
				Material = Enum.Material.Wood,
				Color = C.Wood,
			})
			seat(folder, v(x, 1.3, -11.5), -Vector3.zAxis, Vector3.new(3.8, 1, 6.8))
			Build.box(folder, v(x - 2, 0.8, -9), v(x + 2, 3.6, -8), {
				Name = "ChaiseBack",
				Material = Enum.Material.Fabric,
				Color = C.Fabric,
			})
		end
		Build.box(folder, v(-77.8, 0, -7), v(-75.2, 2.6, -4.4), {
			Name = "SideTable",
			Material = Enum.Material.Marble,
			Color = C.Marble,
		})
		Build.ellipsoid(folder, CFrame.new(v(-76.5, 3.1, -5.7)), Vector3.new(1.6, 1, 1.6), {
			Name = "Bowl",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(60, 50, 44),
		})
		-- Glass of red wine.
		Build.cylinderY(folder, v(-75.9, 3.2, -4.9), 1.2, 0.18, { Name = "WineStem", Material = Enum.Material.Glass, Transparency = 0.5, CanCollide = false })
		Build.cylinderY(folder, v(-75.9, 3.9, -4.9), 0.5, 0.6, { Name = "Wine", Color = Color3.fromRGB(90, 10, 20), CanCollide = false })
		paperLamp(folder, v(-84, 0, 14), 6, refs)
		refs.glassFloorCenter = v(-76, 0, -4)
		refs.catSpots.glassfloor = v(-68, 0, -4)
		surface(refs, -82, -71, -15, -8, L + 1.8)
		plant(folder, v(-83, 0, 4), refs)
	elseif id == "pool" then
		refs.poolRoom = room
		local wMin, wMax = Arch.poolWater()
		refs.poolMin, refs.poolMax = wMin, wMax
		local rimTop = wMax.Y + 0.3
		local rim = { Name = "PoolRim", Material = Enum.Material.Concrete, Color = C.ConcreteIn }
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, wMax.Z), Vector3.new(wMax.X + 1, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, GZ), Vector3.new(wMax.X + 1, rimTop, wMin.Z), rim)
		Build.box(folder, Vector3.new(wMin.X - 1, wMin.Y, GZ), Vector3.new(wMin.X, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMax.X, wMin.Y, GZ), Vector3.new(wMax.X + 1, rimTop, wMax.Z + 0.6), rim)
		Build.box(folder, Vector3.new(wMin.X, wMin.Y - 1, wMin.Z), Vector3.new(wMax.X, wMin.Y, wMax.Z), {
			Name = "PoolBottom",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(26, 30, 34),
		})
		-- Underwater glow.
		local glow = Build.box(folder, Vector3.new(wMin.X + 1, wMin.Y, wMax.Z + 0.6), Vector3.new(wMax.X - 1, wMin.Y + 0.3, wMax.Z + 0.8), {
			Name = "PoolLight",
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(150, 200, 255),
			Transparency = 0.3,
		})
		Build.surfaceLight(glow, Enum.NormalId.Front, Color3.fromRGB(150, 200, 255), 12, 0.8)
		-- Towels on a bench.
		Build.box(folder, v(-40, 0, 13), v(-30, 1.6, 15.6), { Name = "Bench", Material = Enum.Material.Wood, Color = C.Wood })
		Build.box(folder, v(-38, 1.6, 13.4), v(-35, 2.2, 15.2), { Name = "Towels", Material = Enum.Material.Fabric, Color = Color3.fromRGB(80, 74, 70) })
	elseif id == "gallery" then
		-- Long low sofa with its back to the glass.
		Build.box(folder, v(-10, 0, -17.2), v(22, 1.2, -10.6), { Name = "SofaPlinth", Material = Enum.Material.Wood, Color = C.Wood })
		Build.box(folder, v(-10, 1.2, -17.2), v(22, 4.4, -15.6), { Name = "SofaBack", Material = Enum.Material.Fabric, Color = C.Fabric })
		for x = -8, 20, 4 do
			seat(folder, v(x, 1.7, -13), Vector3.zAxis, Vector3.new(3.9, 1, 4.6))
		end
		-- Black marble coffee table and a stone bowl.
		Build.box(folder, v(0, 0, -9), v(10, 2.4, -3), { Name = "CoffeeTable", Material = Enum.Material.Marble, Color = C.Marble })
		Build.ellipsoid(folder, CFrame.new(v(3, 2.9, -6)), Vector3.new(2, 1.2, 2), {
			Name = "Bowl",
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(70, 58, 50),
		})
		Build.box(folder, v(-6, 0.01, -9.5), v(14, 0.1, 2), { Name = "Rug", Material = Enum.Material.Fabric, Color = Color3.fromRGB(58, 52, 48), CanCollide = false })
		-- Paper floor lamps.
		paperLamp(folder, v(-12, 0, -15), 7, refs)
		paperLamp(folder, v(24, 0, -15), 7, refs)
		paperLamp(folder, v(-12, 0, 13), 7, refs)

		-- The suspended fireplace.
		local fx, fz = 28, -3
		local bowlCenter = v(fx, 5.5, fz)
		local ceil = Arch.ceilingAt(fx)
		Build.cylinderY(folder, Vector3.new(fx, (bowlCenter.Y + 3 + ceil) / 2, fz), ceil - bowlCenter.Y - 3, 1.4, {
			Name = "Flue",
			Material = Enum.Material.Metal,
			Color = C.Metal,
		})
		local template = Build.asset("Fireplace")
		local facing = CFrame.new(bowlCenter) * CFrame.Angles(0, math.pi / 2, 0) -- opening faces -X, toward the sofa
		if template then
			-- Mesh is a bowl with a neck on top; its bounding box centre sits 3 studs above the bowl centre.
			Build.placeAsset(template, folder, facing * CFrame.new(0, 3, 0), Vector3.new(8, 12.4, 7.7))
		else
			Build.ellipsoid(folder, facing, Vector3.new(8, 6.5, 8), { Name = "FireBowl", Material = Enum.Material.Metal, Color = C.Metal })
			Build.ellipsoid(folder, facing * CFrame.new(0, -0.4, -2.6), Vector3.new(5.4, 3, 3.4), {
				Name = "FireMouth",
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 120, 40),
			})
		end
		local core = Build.part(folder, {
			Name = "FireCore",
			Size = Vector3.new(2, 1, 2),
			CFrame = facing * CFrame.new(0, -0.6, -3.2),
			Transparency = 1,
			CanCollide = false,
		})
		local fire = Instance.new("Fire")
		fire.Size = 4
		fire.Heat = 4
		fire.Color = Color3.fromRGB(255, 140, 50)
		fire.SecondaryColor = Color3.fromRGB(255, 60, 10)
		fire.Parent = core
		local fireLight = Build.pointLight(core, Color3.fromRGB(255, 150, 70), 32, 2.4)
		local embers = Instance.new("ParticleEmitter")
		embers.Rate = 6
		embers.Lifetime = NumberRange.new(1, 2)
		embers.Speed = NumberRange.new(2, 4)
		embers.SpreadAngle = Vector2.new(25, 25)
		embers.Size = NumberSequence.new(0.15, 0)
		embers.LightEmission = 1
		embers.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
		embers.Parent = core
		refs.fire = { core = core, fire = fire, light = fireLight, embers = embers }
		refs.fireplacePos = core.Position

		-- Concierge tablet for upgrades.
		local tablet = Build.box(folder, v(10, 4, BZ - 0.3), v(14, 7, BZ), { Name = "ConciergeTablet", Material = Enum.Material.Glass, Color = C.Metal })
		local screen = Build.box(folder, v(10.3, 4.3, BZ - 0.4), v(13.7, 6.7, BZ - 0.3), {
			Name = "Screen",
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(120, 170, 220),
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.Parent = screen
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "CONCIERGE\nupgrades"
		label.TextScaled = true
		label.Font = Enum.Font.GothamMedium
		label.TextColor3 = Color3.fromRGB(20, 30, 40)
		label.Parent = gui
		refs.tablet = tablet

		-- Bookshelf on the back wall.
		local shelf = Build.box(folder, v(-6, 0, 14.4), v(4, 9, BZ), { Name = "Bookshelf", Material = Enum.Material.Wood, Color = C.Wood })
		local bookRng = Random.new(11)
		for row = 0, 2 do
			local y = 0.4 + row * 3
			Build.box(folder, v(-6, y + 2.6, 14.3), v(4, y + 2.8, BZ), { Name = "Shelf", Material = Enum.Material.Wood, Color = C.Wood })
			local x = -5.6
			while x < 3.4 do
				local w = bookRng:NextNumber(0.3, 0.6)
				local h = bookRng:NextNumber(1.6, 2.4)
				local tone = bookRng:NextNumber(0.25, 0.75)
				Build.box(folder, v(x, y + 0.2, 14.0), v(x + w, y + 0.2 + h, 14.8), {
					Name = "Book",
					Color = Color3.new(tone * 0.9, tone * 0.75, tone * 0.6),
					CanCollide = false,
				})
				x += w + 0.05
			end
		end
		refs.bookshelf = shelf

		-- Record player cabinet (works for players who own the upgrade).
		Build.box(folder, v(17, 0, 13.4), v(22, 2.6, BZ), { Name = "RecordCabinet", Material = Enum.Material.Wood, Color = C.Wood })
		local platter = Build.cylinderY(folder, v(19.5, 2.75, 14.8), 0.3, 2.2, { Name = "RecordPlayer", Material = Enum.Material.Metal, Color = C.Metal })
		Build.cylinderY(folder, v(19.5, 2.95, 14.8), 0.1, 1.9, { Name = "Record", Color = Color3.fromRGB(12, 12, 12), CanCollide = false })
		refs.recordPlayer = platter

		-- Log basket and Mochi's bed by the fire.
		local basket = Build.cylinderY(folder, v(33, 0.9, -9), 1.8, 2.6, { Name = "LogBasket", Material = Enum.Material.Fabric, Color = Color3.fromRGB(70, 60, 50) })
		for i = 1, 3 do
			Build.beam(folder, v(32.2 + i * 0.4, 2, -9.8), v(32.2 + i * 0.4, 2.2, -8.2), 0.5, 0.5, { Name = "Log", Material = Enum.Material.Wood, Color = Color3.fromRGB(96, 70, 48), CanCollide = false })
		end
		refs.logBasket = basket
		Build.ellipsoid(folder, CFrame.new(v(33, 0.3, 4)), Vector3.new(4, 0.6, 3.4), { Name = "CatBed", Material = Enum.Material.Fabric, Color = Color3.fromRGB(150, 120, 96), CanCollide = false })
		refs.catSpots.firebed = v(33, 0.6, 4)
