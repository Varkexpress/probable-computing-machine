{
  "name": "deepcut",
  "version": "1.0.0",
  "private": true,
  "description": "Deep Cut: a daily reverse-popularity trivia game. Obvious answers barely scratch the surface; obscure ones dig toward the Earth's core.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/server.js",
    "dev": "node --no-warnings --watch server/server.js",
    "test": "node --no-warnings --test test/*.test.js",
    "check-content": "node scripts/check-content.js",
    "build-static": "node scripts/build-static.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
